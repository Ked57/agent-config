diff -ruN a/src/routes/errors.test.ts b/src/routes/errors.test.ts
--- /dev/null
+++ b/src/routes/errors.test.ts
@@ -0,0 +1,140 @@
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+async function expectError(
+  response: Response,
+  status: number,
+  code: string,
+): Promise<{ error: { code: string; message: string; details?: unknown } }> {
+  expect(response.status).toBe(status);
+  expect(response.headers.get("content-type")).toContain("application/json");
+  const body = (await response.json()) as {
+    error: { code: string; message: string; details?: unknown };
+  };
+  expect(body.error.code).toBe(code);
+  expect(typeof body.error.message).toBe("string");
+  return body;
+}
+
+describe("error responses", () => {
+  it("reports schema violations as validation_error with details", async () => {
+    const { request } = await createTestContext();
+    const response = await request("POST", "/api/auth/token", {
+      body: { email: "not-an-email" },
+    });
+    const body = await expectError(response, 400, "validation_error");
+    expect(body.error.details).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({ in: "body", path: "/email" }),
+      ]),
+    );
+  });
+
+  it("reports malformed or empty JSON bodies as validation_error", async () => {
+    const { app } = await createTestContext();
+    for (const body of ["{not json", ""]) {
+      const response = await app.handle(
+        new Request("http://localhost/api/auth/token", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body,
+        }),
+      );
+      await expectError(response, 400, "validation_error");
+    }
+  });
+
+  it("reports domain validation failures as validation_error", async () => {
+    const { request } = await createTestContext();
+    const response = await request("PATCH", "/api/tasks/tsk_4", {
+      token: SEED_TOKENS.acmeAdmin,
+      body: { title: "   " },
+    });
+    await expectError(response, 400, "validation_error");
+  });
+
+  it("reports missing, invalid and wrong credentials as unauthenticated", async () => {
+    const { request } = await createTestContext();
+    await expectError(await request("GET", "/api/me"), 401, "unauthenticated");
+    await expectError(
+      await request("GET", "/api/me", { token: "bogus" }),
+      401,
+      "unauthenticated",
+    );
+    await expectError(
+      await request("POST", "/api/auth/token", {
+        body: { email: "ada@acme.test", password: "nope" },
+      }),
+      401,
+      "unauthenticated",
+    );
+    await expectError(
+      await request("POST", "/api/webhooks/billing", {
+        body: { id: "evt_1", type: "x", data: { orgId: "org_acme" } },
+        headers: { "x-webhook-secret": "wrong" },
+      }),
+      401,
+      "unauthenticated",
+    );
+  });
+
+  it("reports forbidden actions as forbidden", async () => {
+    const { request } = await createTestContext();
+    await expectError(
+      await request("DELETE", "/api/tasks/tsk_4", {
+        token: SEED_TOKENS.acmeMember,
+      }),
+      403,
+      "forbidden",
+    );
+  });
+
+  it("reports missing resources and unknown routes as not_found", async () => {
+    const { request } = await createTestContext();
+    await expectError(
+      await request("GET", "/api/projects/prj_missing", {
+        token: SEED_TOKENS.acmeAdmin,
+      }),
+      404,
+      "not_found",
+    );
+    await expectError(
+      await request("GET", "/api/tasks/tsk_missing", {
+        token: SEED_TOKENS.acmeAdmin,
+      }),
+      404,
+      "not_found",
+    );
+    await expectError(await request("GET", "/api/nope"), 404, "not_found");
+  });
+
+  it("reports invalid state transitions as conflict", async () => {
+    const { request } = await createTestContext();
+    await expectError(
+      await request("PATCH", "/api/tasks/tsk_4", {
+        token: SEED_TOKENS.acmeMember,
+        body: { status: "done" },
+      }),
+      409,
+      "conflict",
+    );
+  });
+
+  it("hides unexpected error messages behind internal_error", async () => {
+    let failQueries = false;
+    const { request } = await createTestContext({
+      logger: {
+        logQuery() {
+          if (failQueries) throw new Error("SQLITE secret table detail");
+        },
+      },
+    });
+    failQueries = true;
+    const response = await request("GET", "/api/me", {
+      token: SEED_TOKENS.acmeAdmin,
+    });
+    const body = await expectError(response, 500, "internal_error");
+    expect(JSON.stringify(body)).not.toContain("secret");
+  });
+});
