+
+describe("PATCH /api/tasks/:id fields", () => {
+  it("responds 404 for a task in another organization", async () => {
+    const { request } = await createTestContext();
+    const response = await request("PATCH", "/api/tasks/tsk_6", {
+      ...admin,
+      body: { title: "Hijacked" },
+    });
+    expect(response.status).toBe(404);
+  });
+
+  it("rejects a blank title", async () => {
+    const { request } = await createTestContext();
+    const response = await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: { title: "   " },
+    });
+    expect(response.status).toBe(400);
+  });
+
+  it("updates title, description, urgency and due date", async () => {
+    const { request } = await createTestContext();
+    const response = await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: {
+        title: "  Push notifications v2  ",
+        description: "Use the new provider",
+        isUrgent: true,
+        dueDate: "2027-01-15",
+      },
+    });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({
+      title: "Push notifications v2",
+      description: "Use the new provider",
+      isUrgent: true,
+      dueDate: "2027-01-15",
+    });
+  });
+
+  it("returns the task unchanged when nothing changes", async () => {
+    const { request } = await createTestContext();
+    const response = await request("PATCH", "/api/tasks/tsk_2", {
+      ...admin,
+      body: { status: "in_progress", assigneeId: "usr_bob" },
+    });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({
+      id: "tsk_2",
+      updatedAt: "2026-10-01T09:02:00.000Z",
+    });
+  });
+
+  it("unassigns a task without sending mail", async () => {
+    const { request } = await createTestContext();
+    const response = await request("PATCH", "/api/tasks/tsk_2", {
+      ...admin,
+      body: { assigneeId: null },
+    });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({ assigneeId: null });
+  });
+});
+
+describe("PATCH /api/tasks/:id rules", () => {
+  it("rejects assignees from another organization", async () => {
+    const { request } = await createTestContext();
+    const response = await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: { assigneeId: "usr_gina" },
+    });
+    expect(response.status).toBe(400);
+  });
+
+  it("requires an assignee before a task is done", async () => {
+    const { request } = await createTestContext();
+    await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: { status: "in_progress" },
+    });
+    const response = await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: { status: "done" },
+    });
+    expect(response.status).toBe(409);
+  });
+
+  it("marks a task done when it gets an assignee in the same change", async () => {
+    const { request } = await createTestContext();
+    await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: { status: "in_progress" },
+    });
+    const response = await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: { status: "done", assigneeId: "usr_ada" },
+    });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({
+      status: "done",
+      assigneeId: "usr_ada",
+    });
