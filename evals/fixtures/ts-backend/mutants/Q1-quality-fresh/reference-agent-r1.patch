+import { describe, expect, it, vi } from "vitest";
+
+import { logger } from "./logger";
+
+function captureConsole() {
+  return {
+    out: vi.spyOn(console, "log").mockImplementation(() => undefined),
+    err: vi.spyOn(console, "error").mockImplementation(() => undefined),
+  };
+}
+
+describe("logger", () => {
+  it("writes info as JSON to stdout and warnings and errors to stderr", () => {
+    vi.stubEnv("LOG_LEVEL", "info");
+    const { out, err } = captureConsole();
+    logger.info("hello", { requestId: "r1" });
+    logger.warn("careful");
+    logger.error("broken");
+    expect(out).toHaveBeenCalledTimes(1);
+    expect(JSON.parse(String(out.mock.calls[0]?.[0]))).toMatchObject({
+      level: "info",
+      msg: "hello",
+      requestId: "r1",
+    });
+    expect(err).toHaveBeenCalledTimes(2);
+  });
+
+  it("drops messages below the configured level", () => {
+    vi.stubEnv("LOG_LEVEL", "warn");
+    const { out, err } = captureConsole();
+    logger.debug("noise");
+    logger.info("noise");
+    logger.warn("kept");
+    expect(out).not.toHaveBeenCalled();
+    expect(err).toHaveBeenCalledTimes(1);
+  });
+
+  it("writes debug messages when the level is debug", () => {
+    vi.stubEnv("LOG_LEVEL", "debug");
+    const { out } = captureConsole();
+    logger.debug("details");
+    expect(out).toHaveBeenCalledTimes(1);
+  });
+
+  it("falls back to info for an unknown level", () => {
+    vi.stubEnv("LOG_LEVEL", "verbose");
+    const { out } = captureConsole();
+    logger.debug("hidden");
+    logger.info("shown");
+    expect(out).toHaveBeenCalledTimes(1);
+  });
+
+  it("falls back to info when no level is set", () => {
+    vi.stubEnv("LOG_LEVEL", undefined);
+    const { out } = captureConsole();
+    logger.debug("hidden");
+    logger.info("shown");
+    expect(out).toHaveBeenCalledTimes(1);
+  });
+});
