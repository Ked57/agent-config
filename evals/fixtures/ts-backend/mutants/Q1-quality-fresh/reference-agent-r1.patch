+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({
+      id: "tsk_2",
+      status: "in_progress",
+      assigneeId: "usr_bob",
+    });
+  });
+
+  it("responds 404 for an unknown task", async () => {
