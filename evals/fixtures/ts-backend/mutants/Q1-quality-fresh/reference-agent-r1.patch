@@ -0,0 +1,44 @@
+import { describe, expect, it, vi } from "vitest";
+
+import { logger } from "../lib/logger";
+import { createTestContext } from "../test/helpers";
+import { sendMail, setMailTransport, type MailMessage } from "./mailer";
+import { notifyTaskAssigned } from "./notifications";
+
+const task = { id: "tsk_4", title: "Push notifications" };
+
+describe("mail notifications", () => {
+  it("logs mail with the default transport", async () => {
+    const info = vi.spyOn(logger, "info").mockImplementation(() => undefined);
+    await sendMail({ to: "ada@acme.test", subject: "Hi", text: "Hello" });
+    expect(info).toHaveBeenCalledWith("mail.sent", {
+      to: "ada@acme.test",
+      subject: "Hi",
+    });
+  });
+
+  it("emails an existing assignee", async () => {
+    const sent: MailMessage[] = [];
+    setMailTransport(async (message) => {
+      sent.push(message);
+    });
+    const { db } = await createTestContext();
+    await notifyTaskAssigned(db, task, "usr_ada");
+    expect(sent).toEqual([
+      expect.objectContaining({
+        to: "ada@acme.test",
+        subject: "You were assigned: Push notifications",
+      }),
+    ]);
+  });
+
+  it("sends nothing when the assignee no longer exists", async () => {
+    const sent: MailMessage[] = [];
+    setMailTransport(async (message) => {
+      sent.push(message);
+    });
+    const { db } = await createTestContext();
+    await notifyTaskAssigned(db, task, "usr_missing");
+    expect(sent).toEqual([]);
+  });
+});
