+    const { request } = await createTestContext();
+    const response = await request("DELETE", "/api/tasks/tsk_6", admin);
+    expect(response.status).toBe(404);
+  });
+
+  it("fails loudly when the database drops a task update", async () => {
+    vi.spyOn(logger, "error").mockImplementation(() => undefined);
+    const { db, request } = await createTestContext();
+    await db.run(
+      sql`CREATE TRIGGER drop_updates BEFORE UPDATE ON tasks BEGIN SELECT RAISE(IGNORE); END`,
+    );
+    const response = await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: { title: "Lost" },
+    });
+    expect(response.status).toBe(500);
+    expect(await response.json()).toEqual({ error: "update returned no row" });
+  });
+});
