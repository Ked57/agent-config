diff -ruN a/scripts/check-disable-directives.ts b/scripts/check-disable-directives.ts
--- /dev/null
+++ b/scripts/check-disable-directives.ts
@@ -0,0 +1,51 @@
+import { ESLint } from "eslint";
+
+const lintedFiles = new Bun.Glob("**/*.{ts,mts,cts,js,mjs,cjs}");
+const directive =
+  /(?:\/\/|\/\*|<!--)\s*eslint-disable(?:-next-line|-line)?(?<rest>.*?)(?:\*\/|-->|$)/gm;
+const protectedPrefix = "@eslint-community/eslint-comments/";
+
+function namedRules(rest: string): string[] {
+  const [ruleList = ""] = rest.split(/\s--\s/);
+  return ruleList
+    .split(",")
+    .map((rule) => rule.trim())
+    .filter((rule) => rule.length > 0);
+}
+
+function violationsIn(path: string, text: string): string[] {
+  const found: string[] = [];
+  for (const match of text.matchAll(directive)) {
+    const rules = namedRules(match.groups?.rest ?? "");
+    const line = text.slice(0, match.index).split("\n").length;
+    if (rules.length === 0) {
+      found.push(`${path}:${line} disables every rule`);
+    }
+    for (const rule of rules.filter((name) =>
+      name.startsWith(protectedPrefix),
+    )) {
+      found.push(`${path}:${line} disables the gate guard ${rule}`);
+    }
+  }
+  return found;
+}
+
+const eslint = new ESLint();
+const violations: string[] = [];
+for await (const path of lintedFiles.scan({ dot: false })) {
+  if (path.startsWith("node_modules/") || (await eslint.isPathIgnored(path))) {
+    continue;
+  }
+  violations.push(...violationsIn(path, await Bun.file(path).text()));
+}
+
+if (violations.length > 0) {
+  console.error(
+    [
+      "Remove these disable comments and fix the reported code instead:",
+      ...violations,
+    ].join("\n"),
+  );
+  process.exit(1);
+}
+console.log("No disable comment targets the lint gate guards.");
diff -ruN a/scripts/check-suppression-growth.ts b/scripts/check-suppression-growth.ts
--- /dev/null
+++ b/scripts/check-suppression-growth.ts
@@ -0,0 +1,85 @@
+import { readFileSync } from "node:fs";
+
+const suppressionsFile = "eslint-suppressions.json";
+
+type Suppressions = Record<string, Record<string, { count: number }>>;
+
+function git(args: string[]): { ok: boolean; stdout: string } {
+  const result = Bun.spawnSync(["git", ...args], { stderr: "pipe" });
+  return { ok: result.exitCode === 0, stdout: result.stdout.toString() };
+}
+
+function fail(message: string): never {
+  console.error(message);
+  process.exit(1);
+}
+
+function parseSuppressions(text: string): Suppressions {
+  const parsed: unknown = JSON.parse(text);
+  if (typeof parsed !== "object" || parsed === null) {
+    fail(`${suppressionsFile} is not a JSON object`);
+  }
+  return parsed as Suppressions;
+}
+
+function mergeBase(target: string): string {
+  const base = git(["merge-base", "HEAD", target]);
+  if (!base.ok)
+    fail(`Cannot read the merge-base with ${target}; refusing to pass.`);
+  return base.stdout.trim();
+}
+
+function renamesSince(base: string): Map<string, string> {
+  const diff = git(["diff", "--name-status", "-z", "-M", base, "HEAD"]);
+  if (!diff.ok) fail(`Cannot diff against ${base}; refusing to pass.`);
+  const fields = diff.stdout.split("\0");
+  const renames = new Map<string, string>();
+  for (let index = 0; index < fields.length; index += 1) {
+    const status = fields[index] ?? "";
+    if (status.startsWith("R")) {
+      renames.set(fields[index + 2] ?? "", fields[index + 1] ?? "");
+      index += 2;
+    } else if (status.startsWith("C")) {
+      index += 2;
+    } else {
+      index += 1;
+    }
+  }
+  return renames;
+}
+
+const target =
+  process.argv[2] ?? process.env.SUPPRESSION_BASE_REF ?? "origin/main";
+const base = mergeBase(target);
+const baseFile = git(["show", `${base}:${suppressionsFile}`]);
+if (!baseFile.ok) {
+  const exists = git(["cat-file", "-e", `${base}^{commit}`]);
+  if (!exists.ok)
+    fail(`Cannot read merge-base commit ${base}; refusing to pass.`);
+  console.log(
+    `${suppressionsFile} is new in this change; it becomes the baseline.`,
+  );
+  process.exit(0);
+}
+
+const before = parseSuppressions(baseFile.stdout);
+const after = parseSuppressions(readFileSync(suppressionsFile, "utf8"));
+const renames = renamesSince(base);
+const grown: string[] = [];
+for (const [path, rules] of Object.entries(after)) {
+  const previous = before[renames.get(path) ?? path] ?? {};
+  for (const [rule, { count }] of Object.entries(rules)) {
+    const allowed = previous[rule]?.count ?? 0;
+    if (count > allowed) grown.push(`${path} ${rule}: ${allowed} -> ${count}`);
+  }
+}
+
+if (grown.length > 0) {
+  fail(
+    [
+      "ESLint suppressions grew; fix the new violations instead of suppressing them:",
+      ...grown,
+    ].join("\n"),
+  );
+}
+console.log("No file gained ESLint suppressions.");
