diff --git a/src/routes/users.test.ts b/src/routes/users.test.ts
new file mode 100644
index 0000000..1872041
--- /dev/null
+++ b/src/routes/users.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+describe("PATCH /api/users/:id", () => {
+  it("lets admins change roles but never removes the last admin", async () => {
+    const { request } = await createTestContext();
+    const demote = await request("PATCH", "/api/users/usr_bob", {
+      token: SEED_TOKENS.acmeAdmin,
+      body: { role: "viewer" },
+    });
+    expect(await demote.json()).toEqual({ id: "usr_bob", role: "viewer" });
+    const write = await request("POST", "/api/projects", {
+      token: SEED_TOKENS.acmeMember,
+      body: { name: "Nope" },
+    });
+    expect(write.status).toBe(403);
+    const self = await request("PATCH", "/api/users/usr_ada", {
+      token: SEED_TOKENS.acmeAdmin,
+      body: { role: "member" },
+    });
+    expect(self.status).toBe(409);
+  });
+});
diff --git a/src/routes/users.ts b/src/routes/users.ts
new file mode 100644
index 0000000..055535b
--- /dev/null
+++ b/src/routes/users.ts
@@ -0,0 +1,50 @@
+import { and, eq, sql } from "drizzle-orm";
+import { Elysia, t } from "elysia";
+
+import type { Db } from "../db/client";
+import { users } from "../db/schema";
+import { authGuard } from "../plugins/auth";
+
+export const userRoutes = (db: Db) =>
+  new Elysia({ prefix: "/api/users" }).use(authGuard(db)).patch(
+    "/:id",
+    async ({ params, body, user, status }) => {
+      if (user.role !== "admin") return status(403, "Forbidden");
+      const target = await db
+        .select({ id: users.id })
+        .from(users)
+        .where(and(eq(users.id, params.id), eq(users.orgId, user.orgId)))
+        .get();
+      if (!target) return status(404, { error: "user not found" });
+      // One statement, so the "another admin remains" check and the write cannot interleave
+      // with a concurrent role change (two admins demoting each other).
+      const [updated] = await db
+        .update(users)
+        .set({ role: body.role })
+        .where(
+          and(
+            eq(users.id, target.id),
+            sql`(${body.role} = 'admin' OR ${users.role} <> 'admin' OR EXISTS (
+              SELECT 1 FROM users other
+              WHERE other.org_id = ${user.orgId} AND other.role = 'admin' AND other.id <> ${target.id}
+            ))`,
+          ),
+        )
+        .returning({ id: users.id, role: users.role });
+      if (!updated)
+        return status(409, {
+          error: "an organization must keep at least one admin",
+        });
+      return updated;
+    },
+    {
+      requireAuth: true,
+      body: t.Object({
+        role: t.Union([
+          t.Literal("admin"),
+          t.Literal("member"),
+          t.Literal("viewer"),
+        ]),
+      }),
+    },
+  );
