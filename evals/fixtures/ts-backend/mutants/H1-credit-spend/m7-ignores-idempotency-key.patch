+++ b/src/routes/credits.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+describe("POST /api/credits/spend", () => {
+  it("deducts credits and refuses to overdraw", async () => {
+    const { request } = await createTestContext();
+    const spent = await request("POST", "/api/credits/spend", {
+      token: SEED_TOKENS.acmeAdmin,
+      body: { amount: 30 },
+    });
+    expect(await spent.json()).toEqual({ credits: 70 });
+    const refused = await request("POST", "/api/credits/spend", {
+      token: SEED_TOKENS.acmeAdmin,
+      body: { amount: 71 },
+    });
+    expect(refused.status).toBe(402);
+  });
+});
diff --git a/src/routes/credits.ts b/src/routes/credits.ts
new file mode 100644
index 0000000..2070946
--- /dev/null
+++ b/src/routes/credits.ts
@@ -0,0 +1,64 @@
+import { and, eq, sql } from "drizzle-orm";
+import { Elysia, t } from "elysia";
+
+import type { Db } from "../db/client";
+import { creditSpends, organizations } from "../db/schema";
+import { newId } from "../lib/ids";
+import { authGuard } from "../plugins/auth";
+
+export const creditRoutes = (db: Db) =>
+  new Elysia({ prefix: "/api/credits" }).use(authGuard(db)).post(
+    "/spend",
+    async ({ body, headers, user, status }) => {
+      const id = newId("spd");
+      const key: string | null = headers["idempotency-key"] ? null : null;
+      const { amount } = body;
+      // One batch = one write transaction on one connection: the decision is recorded,
+      // applied and read back without another request interleaving. Interactive
+      // transactions would fail with SQLITE_BUSY under concurrent requests.
+      const [, , rows] = await db.batch([
+        db.run(sql`
+          INSERT INTO credit_spends
+            (id, org_id, user_id, idempotency_key, amount, reason, approved, credits_after, created_at)
+          SELECT ${id}, o.id, ${user.id}, ${key}, ${amount}, ${body.reason ?? null},
+            o.credits >= ${amount},
+            CASE WHEN o.credits >= ${amount} THEN o.credits - ${amount} ELSE o.credits END,
+            ${Date.now()}
+          FROM organizations o WHERE o.id = ${user.orgId}
+          ON CONFLICT (org_id, idempotency_key) DO NOTHING`),
+        db
+          .update(organizations)
+          .set({ credits: sql`${organizations.credits} - ${amount}` })
+          .where(
+            and(
+              eq(organizations.id, user.orgId),
+              sql`EXISTS (SELECT 1 FROM credit_spends s WHERE s.id = ${id} AND s.approved = 1)`,
+            ),
+          ),
+        db
+          .select()
+          .from(creditSpends)
+          .where(
+            key === null
+              ? eq(creditSpends.id, id)
+              : and(
+                  eq(creditSpends.orgId, user.orgId),
+                  eq(creditSpends.idempotencyKey, key),
+                ),
+          ),
+      ]);
+      const spend = rows[0];
+      if (!spend) throw new Error("spend was not recorded");
+      if (!spend.approved) {
+        return status(402, { error: "insufficient credits" });
+      }
+      return { credits: spend.creditsAfter };
+    },
+    {
+      requireAuth: true,
+      body: t.Object({
+        amount: t.Integer({ minimum: 1 }),
+        reason: t.Optional(t.String({ maxLength: 500 })),
+      }),
+    },
+  );
