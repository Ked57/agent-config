diff -ruN a/src/services/task-updates.ts b/src/services/task-updates.ts
--- /dev/null
+++ b/src/services/task-updates.ts
@@ -0,0 +1,116 @@
+import { and, eq } from "drizzle-orm";
+
+import type { Db } from "../db/client";
+import { tasks, users, type Task, type TaskStatus } from "../db/schema";
+import type { AuthUser } from "../plugins/auth";
+import { notifyTaskAssigned } from "./notifications";
+
+export interface TaskUpdateInput {
+  title?: string;
+  description?: string | null;
+  status?: TaskStatus;
+  isUrgent?: boolean;
+  assigneeId?: string | null;
+  dueDate?: string | null;
+}
+
+export type TaskUpdateFailure =
+  "not_found" | "invalid" | "forbidden" | "conflict";
+
+export type TaskUpdateResult =
+  | { ok: true; task: Task }
+  | { ok: false; reason: TaskUpdateFailure; message: string };
+
+const allowedTransitions: Record<TaskStatus, TaskStatus[]> = {
+  todo: ["in_progress"],
+  in_progress: ["todo", "done"],
+  done: ["todo"],
+};
+
+const fail = (
+  reason: TaskUpdateFailure,
+  message: string,
+): TaskUpdateResult => ({ ok: false, reason, message });
+
+/**
+ * Applies a partial update to a task in the user's organization. Rules are checked in a
+ * fixed order, so the first violated rule decides the failure. Emails a newly assigned
+ * user after the update is stored.
+ */
+export async function updateTask(
+  db: Db,
+  user: AuthUser,
+  taskId: string,
+  input: TaskUpdateInput,
+): Promise<TaskUpdateResult> {
+  const task = await db
+    .select()
+    .from(tasks)
+    .where(and(eq(tasks.id, taskId), eq(tasks.orgId, user.orgId)))
+    .get();
+  if (!task) return fail("not_found", "task not found");
+
+  const changes: Partial<typeof tasks.$inferInsert> = {};
+
+  if (input.title !== undefined) {
+    const title = input.title.trim();
+    if (title.length === 0) return fail("invalid", "title cannot be blank");
+    changes.title = title;
+  }
+  if (input.description !== undefined) changes.description = input.description;
+  if (input.isUrgent !== undefined) changes.isUrgent = input.isUrgent;
+
+  if (input.status !== undefined && input.status !== task.status) {
+    if (!allowedTransitions[task.status].includes(input.status)) {
+      return fail(
+        "conflict",
+        `cannot move a task from ${task.status} to ${input.status}`,
+      );
+    }
+    if (task.status === "done" && user.role !== "admin") {
+      return fail("forbidden", "only admins can reopen finished tasks");
+    }
+    if (input.status === "done" && !task.assigneeId) {
+      return fail("conflict", "assign the task before marking it done");
+    }
+    changes.status = input.status;
+  }
+
+  let newAssignee: string | null = null;
+  if (input.assigneeId !== undefined && input.assigneeId !== task.assigneeId) {
+    if (input.assigneeId !== null) {
+      const assignee = await db
+        .select()
+        .from(users)
+        .where(and(eq(users.id, input.assigneeId), eq(users.orgId, user.orgId)))
+        .get();
+      if (!assignee) {
+        return fail(
+          "invalid",
+          "assignee must be a member of your organization",
+        );
+      }
+      newAssignee = assignee.id;
+    }
+    changes.assigneeId = input.assigneeId;
+  }
+
+  if (input.dueDate !== undefined) {
+    if (input.dueDate !== null && task.status === "done") {
+      return fail("conflict", "finished tasks cannot get a new due date");
+    }
+    changes.dueDate = input.dueDate;
+  }
+
+  if (Object.keys(changes).length === 0) return { ok: true, task };
+  changes.updatedAt = new Date();
+
+  const [updated] = await db
+    .update(tasks)
+    .set(changes)
+    .where(eq(tasks.id, task.id))
+    .returning();
+  if (!updated) throw new Error("update returned no row");
+  if (newAssignee) await notifyTaskAssigned(db, updated, newAssignee);
+  return { ok: true, task: updated };
+}
