+  it("applies distinct events for the same organization", async () => {
+    const { request, db } = await createTestContext();
+    for (const id of ["evt_1", "evt_2"]) {
+      const response = await request("POST", "/api/webhooks/billing", {
+        body: { ...event, id },
+        headers: { "x-webhook-secret": "test-webhook-secret" },
+      });
+      expect(response.status).toBe(200);
+    }
+    const org = await db
+      .select()
+      .from(organizations)
+      .where(eq(organizations.id, "org_globex"))
+      .get();
+    expect(org?.credits).toBe(100);
+  });
