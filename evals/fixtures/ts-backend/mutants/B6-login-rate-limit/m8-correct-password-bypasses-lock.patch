diff -ruN a/src/lib/login-rate-limit.ts b/src/lib/login-rate-limit.ts
--- /dev/null
+++ b/src/lib/login-rate-limit.ts
@@ -0,0 +1,54 @@
+const MAX_FAILURES = 5;
+const WINDOW_MS = 15 * 60 * 1000;
+
+interface FailureWindow {
+  startedAt: number;
+  failures: number;
+}
+
+export type LoginAttempt =
+  { allowed: true } | { allowed: false; retryAfterSeconds: number };
+
+/**
+ * Per-email fixed-window limiter for failed logins, held in process memory.
+ *
+ * `begin` counts the attempt as a failure before the password is checked, so a
+ * burst of concurrent requests cannot all slip past the check while their
+ * lookups are in flight; `succeed` then clears the email's window.
+ */
+export function createLoginRateLimiter() {
+  // Windows are only ever (re)inserted when they start, so Map insertion order
+  // is startedAt order and expired entries can be pruned from the front.
+  const windows = new Map<string, FailureWindow>();
+
+  const pruneExpired = (now: number) => {
+    for (const [email, window] of windows) {
+      if (now - window.startedAt < WINDOW_MS) break;
+      windows.delete(email);
+    }
+  };
+
+  return {
+    begin(email: string): LoginAttempt {
+      const now = Date.now();
+      pruneExpired(now);
+      const window = windows.get(email);
+      if (!window) {
+        windows.set(email, { startedAt: now, failures: 1 });
+        return { allowed: true };
+      }
+      if (window.failures >= MAX_FAILURES) {
+        const remainingMs = window.startedAt + WINDOW_MS - now;
+        return {
+          allowed: false,
+          retryAfterSeconds: Math.max(1, Math.ceil(remainingMs / 1000)),
+        };
+      }
+      window.failures += 1;
+      return { allowed: true };
+    },
+    succeed(email: string) {
+      windows.delete(email);
+    },
+  };
+}
