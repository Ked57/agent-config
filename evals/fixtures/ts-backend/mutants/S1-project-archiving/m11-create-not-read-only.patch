diff --git a/src/routes/project-archive.test.ts b/src/routes/project-archive.test.ts
new file mode 100644
index 0000000..1c020f1
--- /dev/null
+++ b/src/routes/project-archive.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+const admin = { token: SEED_TOKENS.acmeAdmin };
+const member = { token: SEED_TOKENS.acmeMember };
+
+describe("project archiving", () => {
+  it("archives, hides, lists and restores a project", async () => {
+    const { request } = await createTestContext();
+    const archived = await request(
+      "POST",
+      "/api/projects/prj_app/archive",
+      admin,
+    );
+    expect(archived.status).toBe(200);
+    expect(await archived.json()).toMatchObject({ archivedBy: "usr_ada" });
+    const active = (await (
+      await request("GET", "/api/projects", admin)
+    ).json()) as {
+      items: Array<{ id: string }>;
+    };
+    expect(active.items.map((item) => item.id)).toEqual([
+      "prj_billing",
+      "prj_web",
+    ]);
+    const onlyArchived = (await (
+      await request("GET", "/api/projects?archived=true", admin)
+    ).json()) as { items: Array<{ id: string }> };
+    expect(onlyArchived.items.map((item) => item.id)).toEqual(["prj_app"]);
+    const restored = await request(
+      "POST",
+      "/api/projects/prj_app/restore",
+      admin,
+    );
+    expect(await restored.json()).toMatchObject({ archivedAt: null });
+  });
+
+  it("refuses members, repeats and projects with work in progress", async () => {
+    const { request } = await createTestContext();
+    expect(
+      (await request("POST", "/api/projects/prj_app/archive", member)).status,
+    ).toBe(403);
+    const busy = await request("POST", "/api/projects/prj_web/archive", admin);
+    expect(busy.status).toBe(409);
+    expect(await busy.json()).toMatchObject({ taskIds: ["tsk_2"] });
+    await request("POST", "/api/projects/prj_app/archive", admin);
+    const again = await request("POST", "/api/projects/prj_app/archive", admin);
+    expect(await again.json()).toMatchObject({ code: "already_archived" });
+  });
+
+  it("makes an archived project's tasks read-only", async () => {
+    const { request } = await createTestContext();
+    await request("POST", "/api/projects/prj_app/archive", admin);
+    const create = await request("POST", "/api/projects/prj_app/tasks", {
+      ...admin,
+      body: { title: "New" },
+    });
+    const patch = await request("PATCH", "/api/tasks/tsk_4", {
+      ...admin,
+      body: {},
+    });
+    const remove = await request("DELETE", "/api/tasks/tsk_4", admin);
+    for (const response of [create, patch, remove]) {
+      expect(response.status).toBe(409);
+      expect(await response.json()).toMatchObject({ code: "project_archived" });
+    }
+    expect((await request("GET", "/api/tasks/tsk_4", member)).status).toBe(200);
+  });
+});
