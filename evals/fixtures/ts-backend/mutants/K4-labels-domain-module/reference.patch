+import { Elysia, t } from "elysia";
+
+import type { Db } from "../db/client";
+import { toLabelResponse, type LabelResult } from "../labels/labels.model";
+import { createDrizzleLabelRepository } from "../labels/labels.repository";
+import { createLabelService } from "../labels/labels.service";
+import { newId } from "../lib/ids";
+import { authGuard } from "../plugins/auth";
+
+function attachmentResponse(result: LabelResult<null>): Response {
+  if (result.ok) return new Response(null, { status: 204 });
+  return Response.json(
+    { code: result.error, message: result.error.replace("_", " ") },
+    { status: 404 },
+  );
+}
+
+export const labelRoutes = (db: Db) => {
+  const service = createLabelService(createDrizzleLabelRepository(db), () =>
+    newId("lbl"),
+  );
+  return new Elysia({ prefix: "/api" })
+    .use(authGuard(db))
+    .get(
+      "/labels",
+      async ({ user }) => ({
+        items: (await service.list(user.orgId)).map(toLabelResponse),
+      }),
+      { requireAuth: true },
+    )
+    .post(
+      "/labels",
+      async ({ body, user, status }) => {
+        if (user.role !== "admin") {
+          return status(403, {
+            code: "forbidden",
+            message: "only admins can create labels",
+          });
+        }
+        const result = await service.create(user.orgId, body);
+        if (!result.ok) {
+          return status(409, {
+            code: "label_exists",
+            message: "a label with this name exists",
+          });
+        }
+        return status(201, toLabelResponse(result.value));
+      },
+      {
+        requireAuth: true,
+        body: t.Object({
+          name: t.String({ minLength: 1, maxLength: 40, pattern: "\\S" }),
+          color: t.String({ pattern: "^#[0-9a-fA-F]{6}$" }),
+        }),
+      },
+    )
+    .put(
+      "/tasks/:id/labels/:labelId",
+      async ({ params, user }) =>
+        attachmentResponse(
+          await service.setAttached(
+            user.orgId,
+            params.id,
+            params.labelId,
+            true,
+          ),
+        ),
+      { requireAuth: true },
+    )
+    .delete(
+      "/tasks/:id/labels/:labelId",
+      async ({ params, user }) =>
+        attachmentResponse(
+          await service.setAttached(
+            user.orgId,
+            params.id,
+            params.labelId,
+            false,
+          ),
+        ),
+      { requireAuth: true },
+    );
+};
