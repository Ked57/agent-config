+import type { LabelRepository } from "./labels.interface";
+import type { Label } from "./labels.model";
+
+let sequence = 0;
+
+export function buildLabel(overrides: Partial<Label> = {}): Label {
+  sequence += 1;
+  return {
+    id: `lbl_${sequence}`,
+    orgId: "org_test",
+    name: `Label ${sequence}`,
+    color: "#336699",
+    ...overrides,
+  };
+}
+
+/** In-memory LabelRepository for service tests. `tasks` maps task id to organization id. */
+export function createFakeLabelRepository(
+  seed: { labels?: Label[]; tasks?: Record<string, string> } = {},
+): LabelRepository {
+  const stored = [...(seed.labels ?? [])];
+  const taskOrgs = new Map(Object.entries(seed.tasks ?? {}));
+  const links = new Set<string>();
+  const link = (taskId: string, labelId: string) => `${taskId}:${labelId}`;
+  return {
+    listForOrg: async (orgId) =>
+      stored.filter((label) => label.orgId === orgId),
+    findById: async (orgId, labelId) =>
+      stored.find((label) => label.id === labelId && label.orgId === orgId),
+    insert: async (label) => {
+      stored.push(label);
+    },
+    taskInOrg: async (orgId, taskId) => taskOrgs.get(taskId) === orgId,
+    attach: async (taskId, labelId) => {
+      links.add(link(taskId, labelId));
+    },
+    detach: async (taskId, labelId) => {
+      links.delete(link(taskId, labelId));
+    },
+    listForTask: async (taskId) =>
+      stored.filter((label) => links.has(link(taskId, label.id))),
+  };
+}
