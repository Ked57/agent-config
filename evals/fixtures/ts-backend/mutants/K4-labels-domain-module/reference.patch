+import { describe, expect, it } from "vitest";
+
+import { buildLabel, createFakeLabelRepository } from "./labels.mock";
+import { createLabelService } from "./labels.service";
+
+describe("label service", () => {
+  it("refuses a duplicate name regardless of case", async () => {
+    const repository = createFakeLabelRepository({
+      labels: [buildLabel({ orgId: "org_a", name: "Bug" })],
+    });
+    const service = createLabelService(repository, () => "lbl_new");
+    expect(
+      await service.create("org_a", { name: " bug ", color: "#ff0000" }),
+    ).toEqual({
+      ok: false,
+      error: "label_exists",
+    });
+    expect(
+      await service.create("org_b", { name: "Bug", color: "#ff0000" }),
+    ).toMatchObject({
+      ok: true,
+    });
+  });
+
+  it("only attaches labels and tasks of the same organization", async () => {
+    const label = buildLabel({ orgId: "org_a" });
+    const repository = createFakeLabelRepository({
+      labels: [label],
+      tasks: { tsk_a: "org_a", tsk_b: "org_b" },
+    });
+    const service = createLabelService(repository, () => "unused");
+    expect(await service.setAttached("org_a", "tsk_b", label.id, true)).toEqual(
+      {
+        ok: false,
+        error: "task_not_found",
+      },
+    );
+    expect(await service.setAttached("org_a", "tsk_a", label.id, true)).toEqual(
+      { ok: true, value: null },
+    );
+    expect(await service.forTask("tsk_a")).toEqual([label]);
+  });
+});
diff -ruN a/src/labels/labels.service.ts b/src/labels/labels.service.ts
--- /dev/null
+++ b/src/labels/labels.service.ts
@@ -0,0 +1,56 @@
+import type { IdGenerator, LabelRepository } from "./labels.interface";
+import {
+  byName,
+  labelNameKey,
+  type Label,
+  type LabelResult,
+  type NewLabel,
+} from "./labels.model";
+
+export function createLabelService(
+  repository: LabelRepository,
+  newId: IdGenerator,
+) {
+  return {
+    async list(orgId: string): Promise<Label[]> {
+      return (await repository.listForOrg(orgId)).sort(byName);
+    },
+
+    async create(orgId: string, input: NewLabel): Promise<LabelResult<Label>> {
+      const key = labelNameKey(input.name);
+      const existing = await repository.listForOrg(orgId);
+      if (existing.some((label) => labelNameKey(label.name) === key)) {
+        return { ok: false, error: "label_exists" };
+      }
+      const label = {
+        id: newId(),
+        orgId,
+        name: input.name.trim(),
+        color: input.color,
+      };
+      await repository.insert(label);
+      return { ok: true, value: label };
+    },
+
+    async setAttached(
+      orgId: string,
+      taskId: string,
+      labelId: string,
+      attached: boolean,
+    ): Promise<LabelResult<null>> {
+      if (!(await repository.taskInOrg(orgId, taskId)))
+        return { ok: false, error: "task_not_found" };
+      if (!(await repository.findById(orgId, labelId)))
+        return { ok: false, error: "label_not_found" };
+      if (attached) await repository.attach(taskId, labelId);
+      else await repository.detach(taskId, labelId);
+      return { ok: true, value: null };
+    },
+
+    async forTask(taskId: string): Promise<Label[]> {
+      return (await repository.listForTask(taskId)).sort(byName);
+    },
+  };
+}
+
+export type LabelService = ReturnType<typeof createLabelService>;
