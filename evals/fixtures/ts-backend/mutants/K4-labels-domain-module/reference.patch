--- /dev/null
+++ b/src/labels/labels.repository.ts
@@ -0,0 +1,55 @@
+import { and, eq } from "drizzle-orm";
+
+import type { Db } from "../db/client";
+import { labels, taskLabels, tasks } from "../db/schema";
+import type { LabelRepository } from "./labels.interface";
+
+const columns = {
+  id: labels.id,
+  orgId: labels.orgId,
+  name: labels.name,
+  color: labels.color,
+};
+
+export function createDrizzleLabelRepository(db: Db): LabelRepository {
+  return {
+    listForOrg: (orgId) =>
+      db.select(columns).from(labels).where(eq(labels.orgId, orgId)),
+    findById: (orgId, labelId) =>
+      db
+        .select(columns)
+        .from(labels)
+        .where(and(eq(labels.id, labelId), eq(labels.orgId, orgId)))
+        .get(),
+    async insert(label) {
+      await db.insert(labels).values(label);
+    },
+    async taskInOrg(orgId, taskId) {
+      const row = await db
+        .select({ id: tasks.id })
+        .from(tasks)
+        .where(and(eq(tasks.id, taskId), eq(tasks.orgId, orgId)))
+        .get();
+      return row !== undefined;
+    },
+    async attach(taskId, labelId) {
+      await db
+        .insert(taskLabels)
+        .values({ taskId, labelId })
+        .onConflictDoNothing();
+    },
+    async detach(taskId, labelId) {
+      await db
+        .delete(taskLabels)
+        .where(
+          and(eq(taskLabels.taskId, taskId), eq(taskLabels.labelId, labelId)),
+        );
+    },
+    listForTask: (taskId) =>
+      db
+        .select(columns)
+        .from(taskLabels)
+        .innerJoin(labels, eq(labels.id, taskLabels.labelId))
+        .where(eq(taskLabels.taskId, taskId)),
+  };
+}
