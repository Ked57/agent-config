+import type { Label } from "./labels.model";
+
+/** Storage the labels service needs; the Drizzle implementation lives in labels.repository.ts. */
+export interface LabelRepository {
+  listForOrg(orgId: string): Promise<Label[]>;
+  findById(orgId: string, labelId: string): Promise<Label | undefined>;
+  insert(label: Label): Promise<void>;
+  taskInOrg(orgId: string, taskId: string): Promise<boolean>;
+  attach(taskId: string, labelId: string): Promise<void>;
+  detach(taskId: string, labelId: string): Promise<void>;
+  listForTask(taskId: string): Promise<Label[]>;
+}
+
+export type IdGenerator = () => string;
