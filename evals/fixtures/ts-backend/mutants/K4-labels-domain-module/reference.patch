--- /dev/null
+++ b/src/labels/labels.model.ts
@@ -0,0 +1,33 @@
+export interface Label {
+  id: string;
+  orgId: string;
+  name: string;
+  color: string;
+}
+
+export interface NewLabel {
+  name: string;
+  color: string;
+}
+
+export type LabelResult<T> =
+  | { ok: true; value: T }
+  | { ok: false; error: "label_exists" | "task_not_found" | "label_not_found" };
+
+export interface LabelResponse {
+  id: string;
+  name: string;
+  color: string;
+}
+
+/** Label names compare case-insensitively within an organization. */
+export const labelNameKey = (name: string): string => name.trim().toLowerCase();
+
+export const toLabelResponse = ({ id, name, color }: Label): LabelResponse => ({
+  id,
+  name,
+  color,
+});
+
+export const byName = (left: Label, right: Label): number =>
+  labelNameKey(left.name).localeCompare(labelNameKey(right.name));
