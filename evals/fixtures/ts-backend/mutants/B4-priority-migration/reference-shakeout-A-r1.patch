diff -ruN a/src/db/migrate.test.ts b/src/db/migrate.test.ts
--- /dev/null
+++ b/src/db/migrate.test.ts
@@ -0,0 +1,59 @@
+import { cp, mkdtemp, readFile, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { sql } from "drizzle-orm";
+import { migrate } from "drizzle-orm/libsql/migrator";
+import { describe, expect, it } from "vitest";
+
+import { createDb } from "./client";
+import { migrationsFolder, runMigrations } from "./migrate";
+
+/** A copy of the migrations folder whose journal stops at `tag`. */
+async function migrationsUpTo(tag: string): Promise<string> {
+  const folder = await mkdtemp(join(tmpdir(), "tasks-api-migrations-"));
+  await cp(migrationsFolder, folder, { recursive: true });
+  const journalPath = join(folder, "meta", "_journal.json");
+  const journal = JSON.parse(await readFile(journalPath, "utf8")) as {
+    entries: { tag: string }[];
+  };
+  const end = journal.entries.findIndex((entry) => entry.tag === tag);
+  if (end === -1) throw new Error(`unknown migration ${tag}`);
+  journal.entries = journal.entries.slice(0, end + 1);
+  await writeFile(journalPath, JSON.stringify(journal));
+  return folder;
+}
+
+describe("0001_task_priority", () => {
+  it("backfills priority from is_urgent and drops is_urgent", async () => {
+    const dir = await mkdtemp(join(tmpdir(), "tasks-api-migrate-"));
+    const db = createDb(`file:${join(dir, "test.db")}`);
+    await migrate(db, { migrationsFolder: await migrationsUpTo("0000_init") });
+
+    await db.run(
+      sql`INSERT INTO organizations (id, name, created_at) VALUES ('org', 'Org', 0)`,
+    );
+    await db.run(
+      sql`INSERT INTO projects (id, org_id, name, created_at) VALUES ('prj', 'org', 'Project', 0)`,
+    );
+    await db.run(sql`
+      INSERT INTO tasks (id, org_id, project_id, title, is_urgent, created_at, updated_at)
+      VALUES ('urgent', 'org', 'prj', 'Urgent', 1, 0, 0),
+             ('calm', 'org', 'prj', 'Calm', 0, 0, 0)
+    `);
+
+    await runMigrations(db);
+
+    const rows = await db.all<{ id: string; priority: string }>(
+      sql`SELECT id, priority FROM tasks ORDER BY id`,
+    );
+    expect(rows).toEqual([
+      { id: "calm", priority: "normal" },
+      { id: "urgent", priority: "urgent" },
+    ]);
+    const columns = await db.all<{ name: string }>(
+      sql`SELECT name FROM pragma_table_info('tasks')`,
+    );
+    expect(columns.map((column) => column.name)).not.toContain("is_urgent");
+  });
+});
