diff -ruN a/src/lib/duration.test.ts b/src/lib/duration.test.ts
--- /dev/null
+++ b/src/lib/duration.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+
+import { parseDuration } from "./duration";
+
+describe("parseDuration", () => {
+  it.each([
+    ["90s", 90_000],
+    ["15m", 900_000],
+    ["1h30m", 5_400_000],
+    ["2d", 172_800_000],
+    ["1d2h3m4s", 93_784_000],
+    ["0s", 0],
+  ])("parses %s", (input, expected) => {
+    expect(parseDuration(input)).toBe(expected);
+  });
+
+  it.each([
+    "",
+    "15",
+    "15x",
+    "1w",
+    "-5m",
+    "1.5h",
+    " 15m",
+    "15 m",
+    "15M",
+    "30m1h",
+    "1m1m",
+    "h",
+    "9999999999999999d",
+  ])("rejects %j", (input) => {
+    expect(() => parseDuration(input)).toThrow(RangeError);
+  });
+});
diff -ruN a/src/lib/duration.ts b/src/lib/duration.ts
--- /dev/null
+++ b/src/lib/duration.ts
@@ -0,0 +1,25 @@
+const MS_PER_SECOND = 1000;
+const MS_PER_MINUTE = 60 * MS_PER_SECOND;
+const MS_PER_HOUR = 60 * MS_PER_MINUTE;
+const MS_PER_DAY = 24 * MS_PER_HOUR;
+
+// Units must appear largest-first and at most once, so "1h30m" is valid but "30m1h" and "1m1m" are not.
+const DURATION_PATTERN = /^(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/;
+
+/** Converts a duration such as "90s", "15m", "1h30m" or "2d" into milliseconds. */
+export function parseDuration(input: string): number {
+  const match = DURATION_PATTERN.exec(input);
+  if (!input || !match) {
+    throw new RangeError(`Invalid duration: "${input}"`);
+  }
+  const [, days = "0", hours = "0", minutes = "0", seconds = "0"] = match;
+  const ms =
+    Number(days) * MS_PER_DAY +
+    Number(hours) * MS_PER_HOUR +
+    Number(minutes) * MS_PER_MINUTE +
+    Number(seconds) * MS_PER_SECOND;
+  if (!Number.isSafeInteger(ms)) {
+    throw new RangeError(`Duration out of range: "${input}"`);
+  }
+  return ms;
+}
