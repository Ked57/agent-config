+import { describe, expect, it } from "vitest";
+
+import { parseDuration } from "./duration";
+
+describe("parseDuration", () => {
+  it.each([
+    ["90s", 90_000],
+    ["15m", 900_000],
+    ["1h30m", 5_400_000],
+    ["2d", 172_800_000],
+    ["1d2h3m4s", 93_784_000],
+    ["0s", 0],
+  ])("parses %s", (input, expected) => {
+    expect(parseDuration(input)).toBe(expected);
+  });
+
+  it.each([
+    "",
+    "15",
+    "15x",
+    "1w",
+    "-5m",
+    "1.5h",
+    " 15m",
+    "15 m",
+    "15M",
+    "30m1h",
+    "1m1m",
+    "h",
+    "9999999999999999d",
+  ])("rejects %j", (input) => {
+    expect(() => parseDuration(input)).toThrow(RangeError);
+  });
+});
diff -ruN a/src/lib/duration.ts b/src/lib/duration.ts
--- /dev/null
+++ b/src/lib/duration.ts
@@ -0,0 +1,20 @@
+const UNIT_MS: Record<string, number> = {
+  s: 1000,
+  m: 60_000,
+  h: 3_600_000,
+  d: 86_400_000,
+};
+
+/** Converts a duration such as "90s", "15m", "1h30m" or "2d" into milliseconds. */
+export function parseDuration(input: string): number {
+  const parts = input.match(/[^smhd]+[smhd]/g);
+  if (!parts) throw new RangeError(`Invalid duration: "${input}"`);
+  let total = 0;
+  for (const part of parts) {
+    const value = Number(part.slice(0, -1));
+    if (Number.isNaN(value) || value < 0)
+      throw new RangeError(`Invalid duration: "${input}"`);
+    total += value * UNIT_MS[part.slice(-1)]!;
+  }
+  return total;
+}
