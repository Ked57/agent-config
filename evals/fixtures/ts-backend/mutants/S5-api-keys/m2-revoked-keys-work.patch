@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+const admin = { token: SEED_TOKENS.acmeAdmin };
+
+async function createKey(
+  request: Awaited<ReturnType<typeof createTestContext>>["request"],
+  scopes: string[],
+) {
+  const response = await request("POST", "/api/api-keys", {
+    ...admin,
+    body: { name: "Script", scopes },
+  });
+  expect(response.status).toBe(201);
+  return (await response.json()) as { id: string; key: string };
+}
+
+describe("API keys", () => {
+  it("limits a key to its scopes", async () => {
+    const { request } = await createTestContext();
+    const { key } = await createKey(request, ["tasks:read"]);
+    const token = { token: key };
+    expect((await request("GET", "/api/tasks/tsk_4", token)).status).toBe(200);
+    const write = await request("PATCH", "/api/tasks/tsk_4", {
+      ...token,
+      body: { title: "x" },
+    });
+    expect(write.status).toBe(403);
+    expect(await write.json()).toMatchObject({ required: "tasks:write" });
+  });
+
+  it("revokes keys and hides them from key management", async () => {
+    const { request } = await createTestContext();
+    const { id, key } = await createKey(request, ["tasks:write"]);
+    const manage = await request("GET", "/api/api-keys", { token: key });
+    expect(await manage.json()).toMatchObject({ code: "api_key_not_allowed" });
+    expect((await request("DELETE", `/api/api-keys/${id}`, admin)).status).toBe(
+      204,
+    );
+    expect(
+      (await request("GET", "/api/tasks/tsk_4", { token: key })).status,
+    ).toBe(401);
+  });
+});
diff --git a/src/routes/api-keys.ts b/src/routes/api-keys.ts
new file mode 100644
index 0000000..66d05f6
--- /dev/null
+++ b/src/routes/api-keys.ts
@@ -0,0 +1,118 @@
+import { and, asc, eq } from "drizzle-orm";
+import { Elysia, t } from "elysia";
+
+import type { Db } from "../db/client";
+import { apiKeys, apiKeyScopes, type ApiKey } from "../db/schema";
+import { newId } from "../lib/ids";
+import { generateToken, hashToken } from "../lib/tokens";
+import { API_KEY_PREFIX, authGuard, type AuthUser } from "../plugins/auth";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function toApiKeyResponse(key: ApiKey) {
+  return {
+    id: key.id,
+    name: key.name,
+    scopes: key.scopes,
+    prefix: key.prefix,
+    createdBy: key.createdBy,
+    createdAt: key.createdAt.toISOString(),
+    expiresAt: key.expiresAt?.toISOString() ?? null,
+    lastUsedAt: key.lastUsedAt?.toISOString() ?? null,
+    revokedAt: key.revokedAt?.toISOString() ?? null,
+  };
+}
+
+/** Why `user` may not manage API keys, or null. */
+function refusal(user: AuthUser) {
+  if (user.apiKey)
+    return {
+      code: "api_key_not_allowed",
+      message: "API keys cannot manage API keys",
+    };
+  if (user.role !== "admin")
+    return { code: "forbidden", message: "only admins can manage API keys" };
+  return null;
+}
+
+export const apiKeyRoutes = (db: Db) =>
+  new Elysia({ prefix: "/api/api-keys" })
+    .use(authGuard(db))
+    .post(
+      "/",
+      async ({ body, user, status }) => {
+        const refused = refusal(user);
+        if (refused) return status(403, refused);
+        const key = `${API_KEY_PREFIX}${generateToken()}`;
+        const [created] = await db
+          .insert(apiKeys)
+          .values({
+            id: newId("key"),
+            orgId: user.orgId,
+            createdBy: user.id,
+            name: body.name,
+            prefix: key.slice(0, 11),
+            keyHash: hashToken(key),
+            scopes: body.scopes,
+            expiresAt: body.expiresInDays
+              ? new Date(Date.now() + body.expiresInDays * DAY_MS)
+              : null,
+          })
+          .returning();
+        if (!created) throw new Error("insert returned no row");
+        return status(201, { ...toApiKeyResponse(created), key });
+      },
+      {
+        requireAuth: true,
+        body: t.Object({
+          name: t.String({ minLength: 1, maxLength: 100 }),
+          scopes: t.Array(
+            t.Union(apiKeyScopes.map((scope) => t.Literal(scope))),
+            { minItems: 1, uniqueItems: true },
+          ),
+          expiresInDays: t.Optional(t.Integer({ minimum: 1, maximum: 365 })),
+        }),
+      },
+    )
+    .get(
+      "/",
+      async ({ user, status }) => {
+        const refused = refusal(user);
+        if (refused) return status(403, refused);
+        const rows = await db
+          .select()
+          .from(apiKeys)
+          .where(eq(apiKeys.orgId, user.orgId))
+          .orderBy(asc(apiKeys.name), asc(apiKeys.createdAt));
+        return { items: rows.map(toApiKeyResponse) };
+      },
+      { requireAuth: true },
+    )
+    .delete(
+      "/:id",
+      async ({ params, user, status }) => {
+        const refused = refusal(user);
+        if (refused) return status(403, refused);
+        const key = await db
+          .select()
+          .from(apiKeys)
+          .where(and(eq(apiKeys.id, params.id), eq(apiKeys.orgId, user.orgId)))
+          .get();
+        if (!key)
+          return status(404, {
+            code: "api_key_not_found",
+            message: "API key not found",
+          });
+        if (key.revokedAt)
+          return status(409, {
+            code: "already_revoked",
+            message: "the key is already revoked",
+          });
+        await db
+          .update(apiKeys)
+          .set({ revokedAt: new Date() })
+          .where(eq(apiKeys.id, key.id));
+        return new Response(null, { status: 204 });
+      },
+      { requireAuth: true },
+    );
