diff --git a/src/routes/audit.test.ts b/src/routes/audit.test.ts
new file mode 100644
index 0000000..86dd778
--- /dev/null
+++ b/src/routes/audit.test.ts
@@ -0,0 +1,62 @@
+import { sql } from "drizzle-orm";
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+const admin = { token: SEED_TOKENS.acmeAdmin };
+const member = { token: SEED_TOKENS.acmeMember };
+
+type Items = { items: Array<{ action: string; changes: unknown }> };
+
+describe("audit log", () => {
+  it("records task changes with only the changed fields", async () => {
+    const { request } = await createTestContext();
+    await request("PATCH", "/api/tasks/tsk_3", {
+      ...member,
+      body: { status: "in_progress", isUrgent: true },
+    });
+    await request("PATCH", "/api/tasks/tsk_3", { ...member, body: {} });
+    const { items } = (await (
+      await request("GET", "/api/audit-events", admin)
+    ).json()) as Items;
+    expect(items).toEqual([
+      expect.objectContaining({
+        action: "task.updated",
+        changes: { status: { from: "todo", to: "in_progress" } },
+      }),
+    ]);
+  });
+
+  it("is admin-only and filterable", async () => {
+    const { request } = await createTestContext();
+    expect((await request("GET", "/api/audit-events", member)).status).toBe(
+      403,
+    );
+    await request("POST", "/api/projects", {
+      ...admin,
+      body: { name: "Docs" },
+    });
+    await request("DELETE", "/api/tasks/tsk_4", admin);
+    const { items } = (await (
+      await request("GET", "/api/audit-events?entityType=task", admin)
+    ).json()) as Items;
+    expect(items.map((item) => item.action)).toEqual(["task.deleted"]);
+    expect(
+      (await request("GET", "/api/audit-events?limit=0", admin)).status,
+    ).toBe(422);
+  });
+
+  it("rolls the change back when the event cannot be written", async () => {
+    const { request, db } = await createTestContext();
+    await db.run(sql`DROP TABLE audit_events`);
+    const response = await request("PATCH", "/api/tasks/tsk_3", {
+      ...member,
+      body: { title: "Lost" },
+    });
+    expect(response.status).toBe(500);
+    const rows = await db.all<{ title: string }>(
+      sql`SELECT title FROM tasks WHERE id = 'tsk_3'`,
+    );
+    expect(rows[0]?.title).toBe("Fix broken signup link");
+  });
+});
diff --git a/src/routes/audit.ts b/src/routes/audit.ts
new file mode 100644
index 0000000..b62078e
--- /dev/null
+++ b/src/routes/audit.ts
@@ -0,0 +1,58 @@
+import { and, desc, eq, gte, lt, type SQL } from "drizzle-orm";
+import { Elysia, t } from "elysia";
+
+import type { Db } from "../db/client";
+import { auditEvents } from "../db/schema";
+import { authGuard } from "../plugins/auth";
+
+export const auditRoutes = (db: Db) =>
+  new Elysia({ prefix: "/api/audit-events" }).use(authGuard(db)).get(
+    "/",
+    async ({ query, user, status }) => {
+      if (user.role !== "admin")
+        return status(403, {
+          code: "forbidden",
+          message: "only admins can read the audit log",
+        });
+      const filters: SQL[] = [eq(auditEvents.orgId, user.orgId)];
+      if (query.action) filters.push(eq(auditEvents.action, query.action));
+      if (query.entityType)
+        filters.push(eq(auditEvents.entityType, query.entityType));
+      if (query.entityId)
+        filters.push(eq(auditEvents.entityId, query.entityId));
+      if (query.actorId) filters.push(eq(auditEvents.actorId, query.actorId));
+      if (query.since)
+        filters.push(gte(auditEvents.createdAt, new Date(query.since)));
+      if (query.until)
+        filters.push(lt(auditEvents.createdAt, new Date(query.until)));
+      const rows = await db
+        .select()
+        .from(auditEvents)
+        .where(and(...filters))
+        .orderBy(desc(auditEvents.id))
+        .limit(query.limit ?? 50);
+      return {
+        items: rows.map((row) => ({
+          id: row.id,
+          action: row.action,
+          entityType: row.entityType,
+          entityId: row.entityId,
+          actorId: row.actorId,
+          changes: row.changes,
+          createdAt: row.createdAt.toISOString(),
+        })),
+      };
+    },
+    {
+      requireAuth: true,
+      query: t.Object({
+        action: t.Optional(t.String()),
+        entityType: t.Optional(t.String()),
+        entityId: t.Optional(t.String()),
+        actorId: t.Optional(t.String()),
+        since: t.Optional(t.String({ format: "date-time" })),
+        until: t.Optional(t.String({ format: "date-time" })),
+        limit: t.Optional(t.Integer({ minimum: 1, maximum: 200 })),
+      }),
+    },
+  );
