diff --git a/src/services/audit.ts b/src/services/audit.ts
new file mode 100644
index 0000000..70678a7
--- /dev/null
+++ b/src/services/audit.ts
@@ -0,0 +1,63 @@
+import type { Db } from "../db/client";
+import { auditEvents } from "../db/schema";
+
+/** A database handle or an open transaction on it. */
+export type Executor = Db | Parameters<Parameters<Db["transaction"]>[0]>[0];
+
+export type Changes = Record<string, { from: unknown; to: unknown }>;
+
+export const taskFields = [
+  "title",
+  "description",
+  "status",
+  "isUrgent",
+  "assigneeId",
+  "dueDate",
+  "projectId",
+] as const;
+
+export const projectFields = ["name", "description"] as const;
+
+type Fields = readonly string[];
+type Row = Record<string, unknown>;
+
+export function createdChanges(row: Row, fields: Fields): Changes {
+  const changes: Changes = {};
+  for (const field of fields) {
+    if (row[field] !== null && row[field] !== undefined)
+      changes[field] = { from: null, to: row[field] };
+  }
+  return changes;
+}
+
+export function updatedChanges(before: Row, after: Row, fields: Fields) {
+  const changes: Changes = {};
+  for (const field of fields) {
+    if (before[field] !== after[field])
+      changes[field] = { from: before[field], to: after[field] };
+  }
+  return changes;
+}
+
+export function deletedChanges(row: Row, fields: Fields): Changes {
+  const changes: Changes = {};
+  for (const field of fields) {
+    if (row[field] !== null && row[field] !== undefined)
+      changes[field] = { from: row[field], to: null };
+  }
+  return changes;
+}
+
+export async function recordEvent(
+  executor: Executor,
+  event: {
+    orgId: string;
+    actorId: string | null;
+    action: string;
+    entityType: string;
+    entityId: string;
+    changes: Changes;
+  },
+): Promise<void> {
+  await executor.insert(auditEvents).values(event);
+}
