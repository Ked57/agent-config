+  it("lists projects with a fixed number of queries", async () => {
+    const queries: string[] = [];
+    const { db, request } = await createTestContext({
+      logger: { logQuery: (query) => queries.push(query) },
+    });
+    const listQueryCount = async () => {
+      queries.length = 0;
+      const response = await request("GET", "/api/projects", {
+        token: SEED_TOKENS.acmeAdmin,
+      });
+      expect(response.status).toBe(200);
+      return {
+        count: queries.length,
+        body: (await response.json()) as {
+          items: Array<{ id: string; taskCounts: Record<string, number> }>;
+        },
+      };
+    };
+
+    const before = await listQueryCount();
+    await db.insert(projects).values([
+      { id: "prj_extra_1", orgId: "org_acme", name: "Extra 1" },
+      { id: "prj_extra_2", orgId: "org_acme", name: "Extra 2" },
+    ]);
+    await db.insert(tasks).values({
+      id: "tsk_extra",
+      orgId: "org_acme",
+      projectId: "prj_extra_1",
+      title: "Extra",
+      status: "done",
+    });
+    const after = await listQueryCount();
+
+    expect(after.body.items).toHaveLength(before.body.items.length + 2);
+    expect(after.count).toBe(before.count);
+    const countsFor = (id: string) =>
+      after.body.items.find((item) => item.id === id)?.taskCounts;
