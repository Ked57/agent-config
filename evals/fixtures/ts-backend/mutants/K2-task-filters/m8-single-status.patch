diff -ruN a/src/routes/task-filters.test.ts b/src/routes/task-filters.test.ts
--- /dev/null
+++ b/src/routes/task-filters.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+describe("task filters", () => {
+  it("filters by status and rejects unknown values", async () => {
+    const { request } = await createTestContext();
+    const token = SEED_TOKENS.acmeAdmin;
+    const ok = await request(
+      "GET",
+      "/api/projects/prj_web/tasks?status=todo&status=done",
+      { token },
+    );
+    const body = (await ok.json()) as { items: Array<{ id: string }> };
+    expect(body.items.map((task) => task.id)).toEqual(["tsk_1", "tsk_3"]);
+    for (const query of ["status=DONE", "urgent=yes", "sort=name"]) {
+      const bad = await request("GET", `/api/projects/prj_web/tasks?${query}`, {
+        token,
+      });
+      expect(bad.status).toBe(400);
+    }
+  });
+});
