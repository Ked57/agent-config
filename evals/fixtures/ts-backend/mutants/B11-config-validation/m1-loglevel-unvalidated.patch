@@ -0,0 +1,88 @@
+import { describe, expect, it } from "vitest";
+
+import { ConfigError, parseConfig } from "./config";
+
+const required = { DATABASE_URL: "file:data/dev.db", WEBHOOK_SECRET: "s3cret" };
+
+function issuesFor(env: Record<string, string | undefined>) {
+  try {
+    parseConfig(env);
+  } catch (error) {
+    if (error instanceof ConfigError) return error.issues;
+    throw error;
+  }
+  throw new Error("expected parseConfig to throw");
+}
+
+describe("parseConfig", () => {
+  it("applies defaults when only required variables are set", () => {
+    expect(parseConfig(required)).toEqual({
+      port: 4000,
+      databaseUrl: "file:data/dev.db",
+      webhookSecret: "s3cret",
+      tokenTtlHours: 24,
+      logLevel: "info",
+    });
+  });
+
+  it("reads every variable when set", () => {
+    expect(
+      parseConfig({
+        ...required,
+        PORT: "8080",
+        TOKEN_TTL_HOURS: "1",
+        LOG_LEVEL: "silent",
+      }),
+    ).toMatchObject({ port: 8080, tokenTtlHours: 1, logLevel: "silent" });
+  });
+
+  it("treats empty values as unset", () => {
+    expect(
+      parseConfig({
+        ...required,
+        PORT: "",
+        TOKEN_TTL_HOURS: " ",
+        LOG_LEVEL: "",
+      }),
+    ).toMatchObject({ port: 4000, tokenTtlHours: 24, logLevel: "info" });
+    expect(issuesFor({ DATABASE_URL: "", WEBHOOK_SECRET: "  " })).toEqual([
+      "DATABASE_URL is required",
+      "WEBHOOK_SECRET is required",
+    ]);
+  });
+
+  it("names every missing or invalid variable at once", () => {
+    const issues = issuesFor({
+      PORT: "abc",
+      TOKEN_TTL_HOURS: "0",
+      LOG_LEVEL: "verbose",
+    });
+    expect(issues).toEqual([
+      'PORT must be an integer from 1 to 65535 (got "abc")',
+      "DATABASE_URL is required",
+      "WEBHOOK_SECRET is required",
+      'TOKEN_TTL_HOURS must be a positive integer (got "0")',
+      'LOG_LEVEL must be one of debug, info, warn, error, silent (got "verbose")',
+    ]);
+  });
+
+  it.each(["-1", "1.5", "2e3", "12h"])(
+    "rejects non-integer TOKEN_TTL_HOURS %s",
+    (value) => {
+      expect(issuesFor({ ...required, TOKEN_TTL_HOURS: value })).toEqual([
+        `TOKEN_TTL_HOURS must be a positive integer (got "${value}")`,
+      ]);
+    },
+  );
+
+  it("rejects ports outside 1-65535", () => {
+    expect(issuesFor({ ...required, PORT: "0" })).toHaveLength(1);
+    expect(issuesFor({ ...required, PORT: "65536" })).toHaveLength(1);
+  });
+
+  it("lists the issues in the error message", () => {
+    expect(() => parseConfig({ WEBHOOK_SECRET: "x" })).toThrow(
+      "Invalid configuration:\n  - DATABASE_URL is required",
+    );
+  });
+});
diff -ruN a/src/config.ts b/src/config.ts
--- /dev/null
+++ b/src/config.ts
@@ -0,0 +1,71 @@
+import { isLogLevel, type LogLevel } from "./lib/logger";
+
+export interface Config {
+  readonly port: number;
+  readonly databaseUrl: string;
+  readonly webhookSecret: string;
+  readonly tokenTtlHours: number;
+  readonly logLevel: LogLevel;
+}
+
+/** Lists every missing or invalid variable, so one restart surfaces all problems. */
+export class ConfigError extends Error {
+  constructor(readonly issues: readonly string[]) {
+    super(
+      `Invalid configuration:\n${issues.map((issue) => `  - ${issue}`).join("\n")}`,
+    );
+    this.name = "ConfigError";
+  }
+}
+
+type Env = Record<string, string | undefined>;
+
+/**
+ * Parses and validates configuration from the given environment.
+ * Empty values are treated as unset, so `PORT=` in a .env file falls back to the default.
+ */
+export function parseConfig(env: Env): Config {
+  const issues: string[] = [];
+  const read = (name: string) => {
+    const value = env[name]?.trim();
+    return value ? value : undefined;
+  };
+  const required = (name: string) => {
+    const value = read(name);
+    if (value === undefined) issues.push(`${name} is required`);
+    return value ?? "";
+  };
+  const positiveInteger = (name: string, fallback: number, max?: number) => {
+    const raw = read(name);
+    if (raw === undefined) return fallback;
+    const value = /^\d+$/.test(raw) ? Number(raw) : NaN;
+    if (!(value >= 1) || (max !== undefined && value > max)) {
+      const range =
+        max === undefined
+          ? "a positive integer"
+          : `an integer from 1 to ${max}`;
+      issues.push(`${name} must be ${range} (got "${raw}")`);
+    }
+    return value;
+  };
+
+  const port = positiveInteger("PORT", 4000, 65535);
+  const databaseUrl = required("DATABASE_URL");
+  const webhookSecret = required("WEBHOOK_SECRET");
+  const tokenTtlHours = positiveInteger("TOKEN_TTL_HOURS", 24);
+  let logLevel: LogLevel = "info";
+  const rawLogLevel = read("LOG_LEVEL");
+  if (rawLogLevel !== undefined) {
+    if (isLogLevel(rawLogLevel)) logLevel = rawLogLevel;
+
+  }
+
+  if (issues.length > 0) throw new ConfigError(issues);
+  return {
+    port,
+    databaseUrl,
+    webhookSecret,
+    tokenTtlHours,
+    logLevel,
+  };
+}
