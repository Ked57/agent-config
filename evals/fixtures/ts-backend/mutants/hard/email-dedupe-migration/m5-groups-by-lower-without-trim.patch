index 0000000..4888740
--- /dev/null
+++ b/drizzle/0001_normalise_user_emails.sql
@@ -0,0 +1,22 @@
+-- Hand the tasks of duplicate accounts to the account that survives: the earliest created
+-- one among users whose trimmed, lower-cased emails match.
+UPDATE `tasks` SET `assignee_id` = (
+	SELECT k.`id` FROM `users` d
+	JOIN `users` k ON lower(k.`email`) = lower(d.`email`)
+	WHERE d.`id` = `tasks`.`assignee_id`
+	ORDER BY k.`created_at`, k.`id` LIMIT 1
+) WHERE `assignee_id` IS NOT NULL;
+--> statement-breakpoint
+DELETE FROM `users` WHERE `id` NOT IN (
+	SELECT `id` FROM (
+		SELECT `id`, row_number() OVER (
+			PARTITION BY lower(`email`) ORDER BY `created_at`, `id`
+		) AS position FROM `users`
+	) WHERE position = 1
+);
+--> statement-breakpoint
+UPDATE `users` SET `email` = lower(trim(`email`));
+--> statement-breakpoint
+DROP INDEX `users_email_unique`;
+--> statement-breakpoint
+CREATE UNIQUE INDEX `users_email_unique` ON `users` (lower(`email`));
