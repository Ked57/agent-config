diff --git a/src/services/dependencies.ts b/src/services/dependencies.ts
new file mode 100644
index 0000000..ac312e4
--- /dev/null
+++ b/src/services/dependencies.ts
@@ -0,0 +1,78 @@
+import { and, asc, eq, inArray, ne } from "drizzle-orm";
+import { alias } from "drizzle-orm/sqlite-core";
+
+import type { Db } from "../db/client";
+import { taskDependencies, tasks } from "../db/schema";
+
+export const MAX_BLOCKERS = 5;
+
+const blocker = alias(tasks, "blocker");
+
+/** Blockers that are not done yet, by dependent task id, in the blockers' creation order. */
+export async function openBlockers(
+  db: Db,
+  taskIds: string[],
+): Promise<Map<string, string[]>> {
+  const open = new Map<string, string[]>();
+  if (taskIds.length === 0) return open;
+  const rows = await db
+    .select({ taskId: taskDependencies.taskId, blockerId: blocker.id })
+    .from(taskDependencies)
+    .innerJoin(blocker, eq(blocker.id, taskDependencies.dependsOnId))
+    .where(
+      and(
+        inArray(taskDependencies.taskId, taskIds),
+        ne(blocker.status, "done"),
+      ),
+    )
+    .orderBy(asc(blocker.createdAt), asc(blocker.id));
+  for (const row of rows) {
+    open.set(row.taskId, [...(open.get(row.taskId) ?? []), row.blockerId]);
+  }
+  return open;
+}
+
+export async function isBlocked(db: Db, taskId: string): Promise<boolean> {
+  return (await openBlockers(db, [taskId])).has(taskId);
+}
+
+/**
+ * The path `from` → … → `to` along existing "depends on" links, or null. Adding `to` depends on
+ * `from` would close a cycle exactly when such a path exists.
+ */
+export async function findPath(
+  db: Db,
+  from: string,
+  to: string,
+): Promise<string[] | null> {
+  const previous = new Map<string, string>();
+  let frontier = [from];
+  const seen = new Set(frontier);
+  while (frontier.length > 0) {
+    const edges = await db
+      .select({
+        taskId: taskDependencies.taskId,
+        dependsOnId: taskDependencies.dependsOnId,
+      })
+      .from(taskDependencies)
+      .where(inArray(taskDependencies.taskId, frontier));
+    const next: string[] = [];
+    for (const edge of edges) {
+      if (seen.has(edge.dependsOnId)) continue;
+      seen.add(edge.dependsOnId);
+      previous.set(edge.dependsOnId, edge.taskId);
+      if (edge.dependsOnId === to) {
+        const path = [to];
+        let node = to;
+        while (node !== from) {
+          node = previous.get(node) as string;
+          path.unshift(node);
+        }
+        return path;
+      }
+      next.push(edge.dependsOnId);
+    }
+    frontier = next;
+  }
+  return null;
+}
