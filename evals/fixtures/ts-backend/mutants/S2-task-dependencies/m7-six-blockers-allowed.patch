diff --git a/src/routes/dependencies.test.ts b/src/routes/dependencies.test.ts
new file mode 100644
index 0000000..6a25690
--- /dev/null
+++ b/src/routes/dependencies.test.ts
@@ -0,0 +1,71 @@
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+const member = { token: SEED_TOKENS.acmeMember };
+
+describe("task dependencies", () => {
+  it("blocks a task until its blocker is done", async () => {
+    const { request } = await createTestContext();
+    const linked = await request("POST", "/api/tasks/tsk_3/dependencies", {
+      ...member,
+      body: { dependsOnId: "tsk_2" },
+    });
+    expect(linked.status).toBe(201);
+    expect(
+      await (await request("GET", "/api/tasks/tsk_3", member)).json(),
+    ).toMatchObject({ blocked: true });
+    const start = await request("PATCH", "/api/tasks/tsk_3", {
+      ...member,
+      body: { status: "in_progress" },
+    });
+    expect(start.status).toBe(409);
+    expect(await start.json()).toMatchObject({
+      code: "task_blocked",
+      blockedBy: ["tsk_2"],
+    });
+    await request("PATCH", "/api/tasks/tsk_2", {
+      ...member,
+      body: { status: "done" },
+    });
+    const retry = await request("PATCH", "/api/tasks/tsk_3", {
+      ...member,
+      body: { status: "in_progress" },
+    });
+    expect(retry.status).toBe(200);
+  });
+
+  it("refuses cycles and reports them", async () => {
+    const { request } = await createTestContext();
+    await request("POST", "/api/tasks/tsk_3/dependencies", {
+      ...member,
+      body: { dependsOnId: "tsk_2" },
+    });
+    const cycle = await request("POST", "/api/tasks/tsk_2/dependencies", {
+      ...member,
+      body: { dependsOnId: "tsk_3" },
+    });
+    expect(cycle.status).toBe(409);
+    expect(await cycle.json()).toMatchObject({
+      code: "dependency_cycle",
+      cycle: ["tsk_2", "tsk_3", "tsk_2"],
+    });
+  });
+
+  it("refuses self, cross-project and duplicate links", async () => {
+    const { request } = await createTestContext();
+    const post = (dependsOnId: string) =>
+      request("POST", "/api/tasks/tsk_3/dependencies", {
+        ...member,
+        body: { dependsOnId },
+      });
+    expect(await (await post("tsk_3")).json()).toMatchObject({
+      code: "self_dependency",
+    });
+    expect(await (await post("tsk_4")).json()).toMatchObject({
+      code: "cross_project_dependency",
+    });
+    expect((await post("tsk_1")).status).toBe(201);
+    expect((await post("tsk_1")).status).toBe(409);
+  });
+});
diff --git a/src/routes/dependencies.ts b/src/routes/dependencies.ts
new file mode 100644
index 0000000..ef124c2
--- /dev/null
+++ b/src/routes/dependencies.ts
@@ -0,0 +1,141 @@
+import { and, asc, count, eq, inArray } from "drizzle-orm";
+import { Elysia, t } from "elysia";
+
+import type { Db } from "../db/client";
+import { taskDependencies, tasks } from "../db/schema";
+import { authGuard } from "../plugins/auth";
+import { findPath, MAX_BLOCKERS } from "../services/dependencies";
+
+const taskNotFound = { code: "task_not_found", message: "task not found" };
+const dependencyNotFound = {
+  code: "dependency_not_found",
+  message: "dependency not found",
+};
+
+export const dependencyRoutes = (db: Db) => {
+  const findTask = (id: string, orgId: string) =>
+    db
+      .select()
+      .from(tasks)
+      .where(and(eq(tasks.id, id), eq(tasks.orgId, orgId)))
+      .get();
+
+  const summaries = async (ids: string[]) =>
+    ids.length === 0
+      ? []
+      : db
+          .select({ id: tasks.id, title: tasks.title, status: tasks.status })
+          .from(tasks)
+          .where(inArray(tasks.id, ids))
+          .orderBy(asc(tasks.createdAt), asc(tasks.id));
+
+  return new Elysia({ prefix: "/api/tasks" })
+    .use(authGuard(db))
+    .post(
+      "/:id/dependencies",
+      async ({ params, body, user, status }) => {
+        const task = await findTask(params.id, user.orgId);
+        if (!task) return status(404, taskNotFound);
+        const blocker = await findTask(body.dependsOnId, user.orgId);
+        if (!blocker) return status(404, dependencyNotFound);
+        if (blocker.id === task.id)
+          return status(422, {
+            code: "self_dependency",
+            message: "a task cannot depend on itself",
+          });
+        if (blocker.projectId !== task.projectId)
+          return status(422, {
+            code: "cross_project_dependency",
+            message: "both tasks must be in the same project",
+          });
+        const existing = await db
+          .select()
+          .from(taskDependencies)
+          .where(
+            and(
+              eq(taskDependencies.taskId, task.id),
+              eq(taskDependencies.dependsOnId, blocker.id),
+            ),
+          )
+          .get();
+        if (existing)
+          return status(409, {
+            code: "dependency_exists",
+            message: "the dependency already exists",
+          });
+        const path = await findPath(db, blocker.id, task.id);
+        if (path)
+          return status(409, {
+            code: "dependency_cycle",
+            message: `${blocker.id} already depends on ${task.id}`,
+            cycle: [task.id, ...path],
+          });
+        const [blockers] = await db
+          .select({ total: count() })
+          .from(taskDependencies)
+          .where(eq(taskDependencies.taskId, task.id));
+        if ((blockers?.total ?? 0) > MAX_BLOCKERS)
+          return status(409, {
+            code: "too_many_dependencies",
+            message: `a task can depend on at most ${MAX_BLOCKERS} tasks`,
+          });
+        const [link] = await db
+          .insert(taskDependencies)
+          .values({
+            taskId: task.id,
+            dependsOnId: blocker.id,
+            createdBy: user.id,
+          })
+          .returning();
+        if (!link) throw new Error("insert returned no row");
+        return status(201, {
+          taskId: link.taskId,
+          dependsOnId: link.dependsOnId,
+          createdAt: link.createdAt.toISOString(),
+        });
+      },
+      {
+        requireAuth: true,
+        body: t.Object({ dependsOnId: t.String() }),
+      },
+    )
+    .delete(
+      "/:id/dependencies/:dependsOnId",
+      async ({ params, user, status }) => {
+        const task = await findTask(params.id, user.orgId);
+        if (!task) return status(404, taskNotFound);
+        const deleted = await db
+          .delete(taskDependencies)
+          .where(
+            and(
+              eq(taskDependencies.taskId, task.id),
+              eq(taskDependencies.dependsOnId, params.dependsOnId),
+            ),
+          )
+          .returning();
+        if (deleted.length === 0) return status(404, dependencyNotFound);
+        return new Response(null, { status: 204 });
+      },
+      { requireAuth: true },
+    )
+    .get(
+      "/:id/dependencies",
+      async ({ params, user, status }) => {
+        const task = await findTask(params.id, user.orgId);
+        if (!task) return status(404, taskNotFound);
+        const links = await db
+          .select()
+          .from(taskDependencies)
+          .where(and(eq(taskDependencies.taskId, task.id)));
+        const dependents = await db
+          .select()
+          .from(taskDependencies)
+          .where(eq(taskDependencies.dependsOnId, task.id));
+        return {
+          blockedBy: await summaries(links.map((link) => link.dependsOnId)),
+          blocking: await summaries(dependents.map((link) => link.taskId)),
+        };
+      },
+      { requireAuth: true },
+    );
+};
