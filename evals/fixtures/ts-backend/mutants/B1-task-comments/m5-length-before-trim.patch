diff -ruN a/src/routes/task-comments.test.ts b/src/routes/task-comments.test.ts
--- /dev/null
+++ b/src/routes/task-comments.test.ts
@@ -0,0 +1,143 @@
+import { describe, expect, it } from "vitest";
+
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+describe("task comments", () => {
+  it("creates a trimmed comment by the current user", async () => {
+    const { request } = await createTestContext();
+    const response = await request("POST", "/api/tasks/tsk_1/comments", {
+      token: SEED_TOKENS.acmeMember,
+      body: { body: "  Looks good to me  " },
+    });
+    expect(response.status).toBe(201);
+    const comment = (await response.json()) as Record<string, unknown>;
+    expect(comment).toEqual({
+      id: expect.stringMatching(/^cmt_/),
+      taskId: "tsk_1",
+      authorId: "usr_bob",
+      body: "Looks good to me",
+      createdAt: expect.any(String),
+    });
+    expect(new Date(comment.createdAt as string).toISOString()).toBe(
+      comment.createdAt,
+    );
+  });
+
+  it("lists comments oldest first", async () => {
+    const { request } = await createTestContext();
+    for (const [token, body] of [
+      [SEED_TOKENS.acmeAdmin, "first"],
+      [SEED_TOKENS.acmeMember, "second"],
+      [SEED_TOKENS.acmeAdmin, "third"],
+    ] as const) {
+      const created = await request("POST", "/api/tasks/tsk_2/comments", {
+        token,
+        body: { body },
+      });
+      expect(created.status).toBe(201);
+    }
+    const response = await request("GET", "/api/tasks/tsk_2/comments", {
+      token: SEED_TOKENS.acmeMember,
+    });
+    expect(response.status).toBe(200);
+    const { items } = (await response.json()) as {
+      items: Array<{ body: string; authorId: string; taskId: string }>;
+    };
+    expect(items.map((item) => [item.body, item.authorId])).toEqual([
+      ["first", "usr_ada"],
+      ["second", "usr_bob"],
+      ["third", "usr_ada"],
+    ]);
+  });
+
+  it("returns an empty list for a task without comments", async () => {
+    const { request } = await createTestContext();
+    const response = await request("GET", "/api/tasks/tsk_3/comments", {
+      token: SEED_TOKENS.acmeMember,
+    });
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ items: [] });
+  });
+
+  it.each([
+    ["empty", ""],
+    ["whitespace only", "   \n\t "],
+    ["over 2000 characters", "x".repeat(2001)],
+  ])("rejects a %s body", async (_label, body) => {
+    const { request } = await createTestContext();
+    const response = await request("POST", "/api/tasks/tsk_1/comments", {
+      token: SEED_TOKENS.acmeMember,
+      body: { body },
+    });
+    expect(response.status).toBe(400);
+  });
+
+  it("accepts 2000 characters once surrounding whitespace is trimmed", async () => {
+    const { request } = await createTestContext();
+    const body = "x".repeat(2000);
+    const response = await request("POST", "/api/tasks/tsk_1/comments", {
+      token: SEED_TOKENS.acmeMember,
+      body: { body: `  ${body}  ` },
+    });
+    expect(response.status).toBe(201);
+    expect(await response.json()).toMatchObject({ body });
+  });
+
+  it.each([
+    ["missing body", {}],
+    ["non-string body", { body: 42 }],
+  ])("rejects a %s", async (_label, payload) => {
+    const { request } = await createTestContext();
+    const response = await request("POST", "/api/tasks/tsk_1/comments", {
+      token: SEED_TOKENS.acmeMember,
+      body: payload,
+    });
+    expect(response.status).toBeGreaterThanOrEqual(400);
+    expect(response.status).toBeLessThan(500);
+  });
+
+  it("hides comments from other organizations", async () => {
+    const { request } = await createTestContext();
+    await request("POST", "/api/tasks/tsk_1/comments", {
+      token: SEED_TOKENS.acmeMember,
+      body: { body: "internal" },
+    });
+    const list = await request("GET", "/api/tasks/tsk_1/comments", {
+      token: SEED_TOKENS.globexAdmin,
+    });
+    expect(list.status).toBe(404);
+    const create = await request("POST", "/api/tasks/tsk_1/comments", {
+      token: SEED_TOKENS.globexAdmin,
+      body: { body: "sneaky" },
+    });
+    expect(create.status).toBe(404);
+    const after = await request("GET", "/api/tasks/tsk_1/comments", {
+      token: SEED_TOKENS.acmeMember,
+    });
+    expect(await after.json()).toMatchObject({
+      items: [expect.objectContaining({ body: "internal" })],
+    });
+  });
+
+  it("returns 404 for an unknown task", async () => {
+    const { request } = await createTestContext();
+    const response = await request("GET", "/api/tasks/tsk_nope/comments", {
+      token: SEED_TOKENS.acmeMember,
+    });
+    expect(response.status).toBe(404);
+  });
+
+  it("requires authentication", async () => {
+    const { request } = await createTestContext();
+    expect((await request("GET", "/api/tasks/tsk_1/comments")).status).toBe(
+      401,
+    );
+    expect(
+      (
+        await request("POST", "/api/tasks/tsk_1/comments", {
+          body: { body: "hi" },
+        })
+      ).status,
+    ).toBe(401);
+  });
+});
