     ).toBe(200);
   });
+
+  it("revokes the token on logout and keeps other sessions", async () => {
+    const { request } = await createTestContext();
+    const login = async () => {
+      const response = await request("POST", "/api/auth/token", {
+        body: { email: "ada@acme.test", password: SEED_PASSWORD },
+      });
+      return ((await response.json()) as { token: string }).token;
+    };
+    const first = await login();
+    const second = await login();
+    expect(
+      (await request("POST", "/api/auth/logout", { token: first })).status,
+    ).toBe(204);
+    expect((await request("GET", "/api/me", { token: first })).status).toBe(
+      401,
+    );
+    expect((await request("GET", "/api/me", { token: second })).status).toBe(
+      200,
+    );
+  });
 });
