+  it("hides other organizations' tasks", async () => {
+    const { request } = await createTestContext();
+    const token = SEED_TOKENS.globexAdmin;
+    const read = await request("GET", "/api/tasks/tsk_1", { token });
+    expect(read.status).toBe(404);
+    expect(await read.json()).toEqual({ error: "task not found" });
+    expect(
+      (
+        await request("PATCH", "/api/tasks/tsk_1", {
+          token,
+          body: { title: "Hijacked" },
+        })
+      ).status,
+    ).toBe(404);
+    expect(
+      (await request("DELETE", "/api/tasks/tsk_1", { token })).status,
+    ).toBe(404);
+
+    const own = await request("GET", "/api/tasks/tsk_1", {
+      token: SEED_TOKENS.acmeMember,
+    });
+    expect(own.status).toBe(200);
+    const body = (await own.json()) as { id: string; title: string };
+    expect(body.id).toBe("tsk_1");
+    expect(body.title).not.toBe("Hijacked");
+  });
