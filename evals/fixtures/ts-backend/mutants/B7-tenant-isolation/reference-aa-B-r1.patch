+    const remove = await request("DELETE", "/api/tasks/tsk_1", { token });
+    expect(remove.status).toBe(404);
+    expect(await remove.json()).toEqual(missingBody);
+
+    const own = await request("GET", "/api/tasks/tsk_1", {
+      token: SEED_TOKENS.acmeMember,
+    });
+    expect(own.status).toBe(200);
+    expect(await own.json()).not.toMatchObject({ title: "Hijacked" });
+  });
