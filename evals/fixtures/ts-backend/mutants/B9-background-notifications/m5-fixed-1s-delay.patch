+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { runInBackground, waitForBackgroundJobs } from "./background";
+
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => vi.useRealTimers());
+
+describe("runInBackground", () => {
+  it("retries with exponential backoff until the job succeeds", async () => {
+    const job = vi
+      .fn<() => Promise<void>>()
+      .mockRejectedValueOnce(new Error("down"))
+      .mockRejectedValueOnce(new Error("down"))
+      .mockResolvedValue(undefined);
+
+    runInBackground("test", job);
+    expect(job).toHaveBeenCalledTimes(1);
+
+    await vi.advanceTimersByTimeAsync(999);
+    expect(job).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(job).toHaveBeenCalledTimes(2);
+
+    await vi.advanceTimersByTimeAsync(1999);
+    expect(job).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(job).toHaveBeenCalledTimes(3);
+
+    await waitForBackgroundJobs();
+    expect(job).toHaveBeenCalledTimes(3);
+  });
+
+  it("gives up after 5 attempts", async () => {
+    const job = vi.fn(async () => {
+      throw new Error("down");
+    });
+
+    runInBackground("test", job);
+    await vi.advanceTimersByTimeAsync(1000 + 2000 + 4000 + 8000);
+    expect(job).toHaveBeenCalledTimes(5);
+
+    await waitForBackgroundJobs();
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(job).toHaveBeenCalledTimes(5);
+  });
+});
diff -ruN a/src/lib/background.ts b/src/lib/background.ts
--- /dev/null
+++ b/src/lib/background.ts
@@ -0,0 +1,51 @@
+import { logger } from "./logger";
+
+const MAX_ATTEMPTS = 5;
+const BASE_DELAY_MS = 1000;
+
+const pending = new Set<Promise<void>>();
+
+/**
+ * Runs `job` after the caller returns, retrying failures with exponential backoff
+ * (1s, 2s, 4s, 8s between the 5 attempts). Jobs live in process memory only, so any
+ * still pending when the process exits are lost.
+ */
+export function runInBackground(name: string, job: () => Promise<void>): void {
+  const run = runWithRetries(name, job);
+  pending.add(run);
+  void run.finally(() => pending.delete(run));
+}
+
+async function runWithRetries(
+  name: string,
+  job: () => Promise<void>,
+): Promise<void> {
+  for (let attempt = 1; ; attempt++) {
+    try {
+      await job();
+      return;
+    } catch (error) {
+      if (attempt >= MAX_ATTEMPTS) {
+        logger.error("job.failed", {
+          job: name,
+          attempt,
+          error: String(error),
+        });
+        return;
+      }
+      const delayMs = BASE_DELAY_MS;
+      logger.warn("job.retrying", {
+        job: name,
+        attempt,
+        delayMs,
+        error: String(error),
+      });
+      await new Promise((resolve) => setTimeout(resolve, delayMs));
+    }
+  }
+}
+
+/** Resolves once every queued job has succeeded or given up. */
+export async function waitForBackgroundJobs(): Promise<void> {
+  while (pending.size > 0) await Promise.all(pending);
+}
