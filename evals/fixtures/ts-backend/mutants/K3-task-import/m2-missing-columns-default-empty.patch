--- /dev/null
+++ b/src/lib/task-csv.ts
@@ -0,0 +1,57 @@
+export interface CsvTaskRow {
+  line: number;
+  title: string;
+  assigneeEmail: string | null;
+  dueDate: string | null;
+}
+
+export interface CsvRowError {
+  line: number;
+  message: string;
+}
+
+export const csvHeader = "title,assignee_email,due_date";
+const datePattern = /^\d{4}-\d{2}-\d{2}$/;
+
+/** Splits the import CSV into rows and per-line errors. Returns null when the header is wrong. */
+export function parseTaskCsv(
+  csv: string,
+): { rows: CsvTaskRow[]; errors: CsvRowError[] } | null {
+  const lines = csv.split("\n").map((line) => line.replace(/\r$/, ""));
+  const [header, ...body] = lines;
+  if (header === undefined || header.trim() !== csvHeader) return null;
+  const rows: CsvTaskRow[] = [];
+  const errors: CsvRowError[] = [];
+  body.forEach((text, index) => {
+    const line = index + 2;
+    if (text.trim() === "") return;
+    const cells = text.split(",");
+    const [title = "", email = "", due = ""] = cells;
+    if (cells.length > 3) {
+      errors.push({ line, message: `expected 3 columns, got ${cells.length}` });
+      return;
+    }
+    if (title.trim() === "") {
+      errors.push({ line, message: "title is empty" });
+      return;
+    }
+    const dueDate = due.trim();
+    if (dueDate !== "" && !isCalendarDate(dueDate)) {
+      errors.push({ line, message: `invalid due date: ${dueDate}` });
+      return;
+    }
+    rows.push({
+      line,
+      title: title.trim(),
+      assigneeEmail: email.trim() === "" ? null : email.trim().toLowerCase(),
+      dueDate: dueDate === "" ? null : dueDate,
+    });
+  });
+  return { rows, errors };
+}
+
+function isCalendarDate(value: string): boolean {
+  if (!datePattern.test(value)) return false;
+  const date = new Date(`${value}T00:00:00Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().startsWith(value);
+}
