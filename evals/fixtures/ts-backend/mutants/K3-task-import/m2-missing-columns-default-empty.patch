+import { describe, expect, it } from "vitest";
+
+import { parseTaskCsv } from "./task-csv";
+
+describe("parseTaskCsv", () => {
+  it("parses rows and reports bad lines", () => {
+    const result = parseTaskCsv(
+      "title,assignee_email,due_date\nA,,2026-01-02\nB,x@y.test\n\n,,\nC,,2026-02-30\n",
+    );
+    expect(result?.rows).toEqual([
+      { line: 2, title: "A", assigneeEmail: null, dueDate: "2026-01-02" },
+    ]);
+    expect(result?.errors.map((error) => error.line)).toEqual([3, 5, 6]);
+  });
+
+  it("rejects a wrong header", () => {
+    expect(parseTaskCsv("name,email\nA,b")).toBeNull();
+  });
+});
