--- /dev/null
+++ b/src/lib/cursor.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from "vitest";
+
+import { decodeCursor, encodeCursor } from "./cursor";
+
+describe("cursor", () => {
+  it("round-trips a position", () => {
+    const position = {
+      createdAt: new Date("2026-10-01T09:01:00Z"),
+      id: "tsk_1",
+    };
+    expect(decodeCursor(encodeCursor(position))).toEqual(position);
+  });
+
+  it("rejects malformed cursors", () => {
+    const encode = (value: unknown) =>
+      Buffer.from(JSON.stringify(value)).toString("base64url");
+    expect(decodeCursor("not a cursor")).toBeNull();
+    expect(decodeCursor("")).toBeNull();
+    expect(decodeCursor(encode({ createdAt: 1, id: "tsk_1" }))).toBeNull();
+    expect(decodeCursor(encode([1.5, "tsk_1"]))).toBeNull();
+    expect(decodeCursor(encode([1, ""]))).toBeNull();
+    expect(decodeCursor(encode([1, 2]))).toBeNull();
+    expect(decodeCursor(encode([1, "tsk_1", "extra"]))).toBeNull();
+  });
+});
diff -ruN a/src/lib/cursor.ts b/src/lib/cursor.ts
--- /dev/null
+++ b/src/lib/cursor.ts
@@ -0,0 +1,29 @@
+/**
+ * Opaque keyset cursor for lists ordered by (createdAt, id). The id breaks ties between
+ * rows created in the same millisecond so no row is skipped or repeated across pages.
+ */
+export interface Cursor {
+  createdAt: Date;
+  id: string;
+}
+
+export function encodeCursor({ createdAt, id }: Cursor): string {
+  return Buffer.from(JSON.stringify([createdAt.getTime(), id])).toString(
+    "base64url",
+  );
+}
+
+/** Returns null for anything that was not produced by `encodeCursor`. */
+export function decodeCursor(value: string): Cursor | null {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(Buffer.from(value, "base64url").toString("utf8"));
+  } catch {
+    return null;
+  }
+  if (!Array.isArray(parsed) || parsed.length !== 2) return null;
+  const [time, id] = parsed as unknown[];
+  if (!Number.isSafeInteger(time) || typeof id !== "string" || id === "")
+    return null;
+  return { createdAt: new Date(time as number), id };
+}
