+interface TaskCursor {
+  createdAt: number;
+  id: string;
+}
+
+// Opaque to clients; (createdAt, id) keeps the order stable when timestamps tie.
+function encodeTaskCursor(cursor: TaskCursor): string {
+  return Buffer.from(JSON.stringify(cursor)).toString("base64url");
+}
+
+function decodeTaskCursor(raw: string): TaskCursor | null {
+  try {
+    const parsed: unknown = JSON.parse(
+      Buffer.from(raw, "base64url").toString("utf8"),
+    );
+    if (
+      typeof parsed === "object" &&
+      parsed !== null &&
+      "createdAt" in parsed &&
+      "id" in parsed &&
+      typeof parsed.createdAt === "number" &&
+      Number.isSafeInteger(parsed.createdAt) &&
+      typeof parsed.id === "string"
+    ) {
+      return { createdAt: parsed.createdAt, id: parsed.id };
+    }
+  } catch {
+    // Fall through: malformed base64 or JSON is an invalid cursor.
+  }
+  return null;
+}
