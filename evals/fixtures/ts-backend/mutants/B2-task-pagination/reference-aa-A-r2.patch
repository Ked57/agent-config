diff -ruN a/src/lib/cursor.test.ts b/src/lib/cursor.test.ts
--- /dev/null
+++ b/src/lib/cursor.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from "vitest";
+
+import { decodeCursor, encodeCursor } from "./cursor";
+
+describe("cursor", () => {
+  it("round-trips a position", () => {
+    const position = {
+      createdAt: new Date("2026-10-01T09:00:00.123Z"),
+      id: "tsk_a:b",
+    };
+    expect(decodeCursor(encodeCursor(position))).toEqual(position);
+  });
+
+  it("rejects malformed cursors", () => {
+    const encode = (raw: string) => Buffer.from(raw).toString("base64url");
+    expect(decodeCursor("")).toBeNull();
+    expect(decodeCursor("not a cursor")).toBeNull();
+    expect(decodeCursor(encode("123"))).toBeNull();
+    expect(decodeCursor(encode("123:"))).toBeNull();
+    expect(decodeCursor(encode("abc:tsk_1"))).toBeNull();
+    expect(decodeCursor(encode("-1:tsk_1"))).toBeNull();
+    expect(decodeCursor(encode("9".repeat(20) + ":tsk_1"))).toBeNull();
+  });
+});
diff -ruN a/src/lib/cursor.ts b/src/lib/cursor.ts
--- /dev/null
+++ b/src/lib/cursor.ts
@@ -0,0 +1,25 @@
+/**
+ * Keyset position for lists ordered by (createdAt, id). The id breaks ties
+ * between rows created in the same millisecond, so pages never skip or repeat.
+ */
+export interface CreatedAtCursor {
+  createdAt: Date;
+  id: string;
+}
+
+export function encodeCursor({ createdAt, id }: CreatedAtCursor): string {
+  return Buffer.from(`${createdAt.getTime()}:${id}`).toString("base64url");
+}
+
+/** Returns null for anything that is not a cursor produced by `encodeCursor`. */
+export function decodeCursor(cursor: string): CreatedAtCursor | null {
+  const decoded = Buffer.from(cursor, "base64url").toString("utf8");
+  const separator = decoded.indexOf(":");
+  if (separator === -1) return null;
+  const millis = decoded.slice(0, separator);
+  const id = decoded.slice(separator + 1);
+  if (!/^\d+$/.test(millis) || id.length === 0) return null;
+  const createdAt = new Date(Number(millis));
+  if (Number.isNaN(createdAt.getTime())) return null;
+  return { createdAt, id };
+}
