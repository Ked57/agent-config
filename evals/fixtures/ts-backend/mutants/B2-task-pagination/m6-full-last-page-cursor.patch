+/** Opaque page cursor: the position (createdAt, id) of the last task on the previous page. */
+function encodeTaskCursor(task: Pick<Task, "createdAt" | "id">): string {
+  return Buffer.from(`${task.createdAt.getTime()}:${task.id}`).toString(
+    "base64url",
+  );
+}
+
+function decodeTaskCursor(
+  cursor: string,
+): { createdAt: Date; id: string } | null {
+  const match = /^(\d+):(.+)$/.exec(
+    Buffer.from(cursor, "base64url").toString("utf8"),
+  );
+  if (!match?.[1] || !match[2]) return null;
+  return { createdAt: new Date(Number(match[1])), id: match[2] };
+}
