diff --git a/src/views/CustomerView.vue b/src/views/CustomerView.vue
new file mode 100644
index 0000000..bd5f7f6
--- /dev/null
+++ b/src/views/CustomerView.vue
@@ -0,0 +1,154 @@
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import Button from 'primevue/button'
+import Tab from 'primevue/tab'
+import TabList from 'primevue/tablist'
+import TabPanel from 'primevue/tabpanel'
+import TabPanels from 'primevue/tabpanels'
+import Tabs from 'primevue/tabs'
+import Tag from 'primevue/tag'
+import ActivityTimeline from '@/components/customer/ActivityTimeline.vue'
+import ContactsList from '@/components/customer/ContactsList.vue'
+import EditAccountDrawer from '@/components/customer/EditAccountDrawer.vue'
+import { fetchAccount, updateAccount, type CustomerAccount } from '@/services/accounts'
+import { initials } from '@/utils/format'
+
+const account = ref<CustomerAccount | null>(null)
+const editing = ref(false)
+
+void fetchAccount().then((result) => {
+  account.value = result
+})
+
+const date = (iso: string, month: 'short' | 'long' = 'short') => new Intl.DateTimeFormat('en-US', { month, day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso))
+const since = (iso: string) => new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso))
+const money = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(value)
+
+const stats = computed(() => (account.value
+  ? [
+      { label: 'Monthly revenue', value: money(account.value.monthlyRevenue), note: 'Enterprise, 85 seats' },
+      { label: 'Open invoices', value: String(account.value.openInvoices), note: '$16,700.00 outstanding' },
+      { label: 'Health score', value: `${account.value.healthScore}/100`, note: 'Down 14 since September', down: true },
+      { label: 'Renews', value: date(account.value.renewsAt), note: 'in 76 days' },
+    ]
+  : []))
+
+const details = computed(() => (account.value
+  ? [
+      ['Industry', account.value.details.industry],
+      ['Employees', account.value.details.employees],
+      ['Headquarters', account.value.details.headquarters],
+      ['Time zone', account.value.details.timeZone],
+      ['Account owner', account.value.owner],
+      ['Customer since', date(account.value.customerSince, 'long')],
+    ]
+  : []))
+
+const billing = computed(() => (account.value
+  ? [
+      ['Plan', account.value.plan],
+      ['Payment method', account.value.billing.paymentMethod],
+      ['Billing email', account.value.billing.billingEmail],
+      ['Tax ID', account.value.billing.taxId],
+      ['Next invoice', date(account.value.billing.nextInvoice, 'long')],
+    ]
+  : []))
+
+async function save(changes: Pick<CustomerAccount, 'name' | 'owner' | 'plan' | 'notes'>) {
+  if (!account.value) return
+  account.value = await updateAccount(account.value, changes)
+  editing.value = false
+}
+</script>
+
+<template>
+  <div v-if="account" class="flex flex-col gap-6">
+    <nav aria-label="Breadcrumb">
+      <ol class="flex items-center gap-2 text-sm text-surface-500">
+        <li><RouterLink to="/users" class="hover:text-surface-900">Customers</RouterLink></li>
+        <li aria-hidden="true"><i class="pi pi-angle-right text-xs"></i></li>
+        <li><span class="font-medium text-surface-900" aria-current="page">{{ account.name }}</span></li>
+      </ol>
+    </nav>
+
+    <header class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
+      <div class="flex min-w-0 items-center gap-4">
+        <span class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-primary-700 text-lg font-semibold text-white" aria-hidden="true">{{ initials(account.name) }}</span>
+        <div class="min-w-0">
+          <div class="flex flex-wrap items-center gap-2">
+            <h1 class="truncate text-2xl font-normal tracking-tight text-surface-900">{{ account.name }}</h1>
+            <Tag :value="account.health" severity="warn" icon="pi pi-exclamation-triangle" class="!text-xs" />
+          </div>
+          <p class="mt-1 truncate text-sm text-surface-500">{{ account.domain }} · {{ account.plan }} · Customer since {{ since(account.customerSince) }}</p>
+        </div>
+      </div>
+      <div class="flex gap-3">
+        <Button label="Log activity" icon="pi pi-plus" severity="secondary" outlined class="max-lg:flex-1" />
+        <Button label="Edit account" icon="pi pi-pencil" class="max-lg:flex-1 !border-primary-700 !bg-primary-700" @click="editing = true" />
+      </div>
+    </header>
+
+    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-surface-200 bg-surface-200 shadow-sm lg:grid-cols-4">
+      <div v-for="stat in stats" :key="stat.label" class="bg-surface-0 px-5 py-4">
+        <dt class="text-sm text-surface-500">{{ stat.label }}</dt>
+        <dd class="mt-1 text-2xl font-normal tracking-tight text-surface-900 tabular-nums">{{ stat.value }}</dd>
+        <dd class="mt-0.5 text-xs" :class="stat.down ? 'font-medium text-red-700' : 'text-surface-500'">{{ stat.note }}</dd>
+      </div>
+    </dl>
+
+    <Tabs value="overview" class="[&_.p-tab-active]:!text-primary-700 max-sm:[&_.p-tab]:!px-3">
+      <TabList :pt="{ tabList: { class: '!bg-transparent' } }">
+        <Tab value="overview">Overview</Tab>
+        <Tab value="contacts">Contacts <span class="ml-1 rounded-full bg-surface-100 px-1.5 text-xs text-surface-600 tabular-nums">{{ account.contacts.length }}</span></Tab>
+        <Tab value="invoices">Invoices <span class="ml-1 rounded-full bg-surface-100 px-1.5 text-xs text-surface-600 tabular-nums">{{ account.invoiceCount }}</span></Tab>
+      </TabList>
+      <TabPanels class="!bg-transparent !px-0 !pb-0 !pt-6">
+        <TabPanel value="overview">
+          <div class="grid gap-6 lg:grid-cols-3">
+            <div class="flex min-w-0 flex-col gap-6 lg:col-span-2">
+              <section class="rounded-xl border border-surface-200 bg-surface-0 px-6 shadow-sm" aria-labelledby="details-title">
+                <h2 id="details-title" class="pt-5 text-base font-normal text-surface-900">Account details</h2>
+                <dl class="grid gap-x-8 pb-2 pt-3 sm:grid-cols-2">
+                  <div v-for="[label, value] in details" :key="label" class="flex flex-col gap-0.5 border-b border-surface-100 py-3">
+                    <dt class="text-sm text-surface-500">{{ label }}</dt>
+                    <dd class="truncate text-sm text-surface-900">{{ value }}</dd>
+                  </div>
+                </dl>
+              </section>
+              <section class="rounded-xl border border-surface-200 bg-surface-0 px-6 shadow-sm" aria-labelledby="billing-title">
+                <h2 id="billing-title" class="pt-5 text-base font-normal text-surface-900">Billing</h2>
+                <dl class="pb-3 pt-2">
+                  <div v-for="[label, value] in billing" :key="label" class="flex items-baseline justify-between gap-6 border-b border-surface-100 py-3 last:border-b-0">
+                    <dt class="shrink-0 text-sm text-surface-500">{{ label }}</dt>
+                    <dd class="min-w-0 truncate text-right text-sm text-surface-900">{{ value }}</dd>
+                  </div>
+                </dl>
+              </section>
+              <section class="rounded-xl border border-amber-200 bg-amber-50 px-6 py-4" aria-labelledby="notes-title">
+                <h2 id="notes-title" class="flex items-center gap-2 text-sm font-semibold text-amber-900"><i class="pi pi-bookmark" aria-hidden="true"></i>Internal notes</h2>
+                <p class="mt-1 text-sm text-amber-900">{{ account.notes }}</p>
+              </section>
+            </div>
+            <section class="rounded-xl border border-surface-200 bg-surface-0 px-6 pt-5 shadow-sm" aria-labelledby="activity-title">
+              <div class="mb-4 flex items-center justify-between">
+                <h2 id="activity-title" class="text-base font-normal text-surface-900">Activity</h2>
+                <span class="text-sm text-surface-500">Last 30 days</span>
+              </div>
+              <ActivityTimeline :events="account.activity" />
+            </section>
+          </div>
+        </TabPanel>
+        <TabPanel value="contacts">
+          <ContactsList :contacts="account.contacts" />
+        </TabPanel>
+        <TabPanel value="invoices">
+          <p class="rounded-xl border border-dashed border-surface-300 bg-surface-0 px-6 py-10 text-center text-sm text-surface-500">
+            {{ account.invoiceCount }} invoices. Open them from the Invoices page.
+          </p>
+        </TabPanel>
+      </TabPanels>
+    </Tabs>
+
+    <EditAccountDrawer v-model:visible="editing" :account="account" @save="save" />
+  </div>
+</template>
