@@ -0,0 +1,59 @@
+<script setup lang="ts">
+import { ref, watch } from 'vue'
+import Button from 'primevue/button'
+import Drawer from 'primevue/drawer'
+import InputText from 'primevue/inputtext'
+import Select from 'primevue/select'
+import Textarea from 'primevue/textarea'
+import { accountOwners, accountPlans, type CustomerAccount } from '@/services/accounts'
+
+const props = defineProps<{ account: CustomerAccount }>()
+const visible = defineModel<boolean>('visible', { required: true })
+const emit = defineEmits<{ save: [changes: Pick<CustomerAccount, 'name' | 'owner' | 'plan' | 'notes'>] }>()
+
+const form = ref({ name: '', owner: '', plan: 'Enterprise' as CustomerAccount['plan'], notes: '' })
+const nameError = ref('')
+
+watch(visible, (open) => {
+  if (!open) return
+  form.value = { name: props.account.name, owner: props.account.owner, plan: props.account.plan, notes: props.account.notes }
+  nameError.value = ''
+}, { immediate: true })
+
+function save() {
+  nameError.value = form.value.name.trim() ? '' : 'Account name is required.'
+  if (nameError.value) return
+  emit('save', { ...form.value, name: form.value.name.trim() })
+}
+</script>
+
+<template>
+  <Drawer v-model:visible="visible" position="right" header="Edit account" class="!w-full sm:!w-[28rem]" :pt="{ title: { class: '!text-lg !font-semibold' } }">
+    <form class="flex flex-col gap-5" novalidate @submit.prevent="save">
+      <div class="flex flex-col gap-1.5">
+        <label for="account-name" class="text-sm font-medium text-surface-700">Account name</label>
+        <InputText id="account-name" v-model="form.name" :invalid="!!nameError" />
+        <small v-if="nameError" class="text-sm text-red-600">{{ nameError }}</small>
+      </div>
+      <div class="flex flex-col gap-1.5">
+        <span id="account-owner-label" class="text-sm font-medium text-surface-700">Account owner</span>
+        <Select v-model="form.owner" :options="accountOwners" aria-labelledby="account-owner-label" />
+      </div>
+      <div class="flex flex-col gap-1.5">
+        <span id="account-plan-label" class="text-sm font-medium text-surface-700">Plan</span>
+        <Select v-model="form.plan" :options="accountPlans" aria-labelledby="account-plan-label" />
+        <small class="text-sm text-surface-500">Plan changes apply from the next invoice.</small>
+      </div>
+      <div class="flex flex-col gap-1.5">
+        <label for="account-notes" class="text-sm font-medium text-surface-700">Internal notes</label>
+        <Textarea id="account-notes" v-model="form.notes" rows="4" auto-resize />
+      </div>
+    </form>
+    <template #footer>
+      <div class="flex justify-end gap-2 border-t border-surface-200 pt-4">
+        <Button label="Cancel" severity="secondary" text @click="visible = false" />
+        <Button label="Save changes" class="!border-primary-700 !bg-primary-700" @click="save" />
+      </div>
+    </template>
+  </Drawer>
+</template>
