+<script setup lang="ts">
+import Timeline from 'primevue/timeline'
+import type { AccountEvent } from '@/services/accounts'
+
+defineProps<{ events: AccountEvent[] }>()
+
+const icons: Record<AccountEvent['kind'], { icon: string; tone: string }> = {
+  call: { icon: 'pi pi-phone', tone: 'bg-primary-100 text-primary-700' },
+  email: { icon: 'pi pi-envelope', tone: 'bg-sky-100 text-sky-700' },
+  invoice: { icon: 'pi pi-file', tone: 'bg-surface-100 text-surface-700' },
+  plan: { icon: 'pi pi-users', tone: 'bg-amber-100 text-amber-800' },
+  note: { icon: 'pi pi-chart-line', tone: 'bg-red-100 text-red-700' },
+}
+const when = (iso: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'UTC' }).format(new Date(iso))
+</script>
+
+<template>
+  <Timeline :value="events" class="[&_.p-timeline-event-opposite]:hidden [&_.p-timeline-event-connector]:!bg-surface-200">
+    <template #marker="{ item }">
+      <span class="flex size-8 items-center justify-center rounded-full text-sm" :class="icons[(item as AccountEvent).kind].tone" aria-hidden="true">
+        <i :class="icons[(item as AccountEvent).kind].icon"></i>
+      </span>
+    </template>
+    <template #content="{ item }">
+      <div class="pb-6 pl-1">
+        <p class="text-sm text-surface-900">{{ item.title }}</p>
+        <p class="mt-0.5 text-sm text-surface-600">{{ item.detail }}</p>
+        <p class="mt-1 text-xs text-surface-500">{{ item.actor }} · <time :datetime="item.at" class="tabular-nums">{{ when(item.at) }}</time></p>
+      </div>
+    </template>
+  </Timeline>
+</template>
