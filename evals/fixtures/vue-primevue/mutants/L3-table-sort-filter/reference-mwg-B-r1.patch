diff -ruN a/src/stores/orders.test.ts b/src/stores/orders.test.ts
--- /dev/null
+++ b/src/stores/orders.test.ts
@@ -0,0 +1,43 @@
+import { beforeEach, describe, expect, it } from 'vitest'
+import { createPinia, setActivePinia } from 'pinia'
+import { useOrdersStore } from './orders'
+import type { Order } from '@/types'
+
+const order = (id: string, status: Order['status']): Order => ({
+  id,
+  customer: id,
+  email: `${id}@acme.test`,
+  total: 10,
+  status,
+  createdAt: '2026-11-01T00:00:00Z',
+})
+
+describe('orders store status filter', () => {
+  beforeEach(() => {
+    setActivePinia(createPinia())
+  })
+
+  it('returns all orders when no status is selected', () => {
+    const store = useOrdersStore()
+    store.orders = [order('a', 'paid'), order('b', 'pending')]
+
+    expect(store.filteredOrders.map((o) => o.id)).toEqual(['a', 'b'])
+  })
+
+  it('returns only orders with the selected status', () => {
+    const store = useOrdersStore()
+    store.orders = [order('a', 'paid'), order('b', 'pending'), order('c', 'paid')]
+    store.statusFilter = 'paid'
+
+    expect(store.filteredOrders.map((o) => o.id)).toEqual(['a', 'c'])
+  })
+
+  it('keeps stats based on all orders while filtered', () => {
+    const store = useOrdersStore()
+    store.orders = [order('a', 'paid'), order('b', 'pending')]
+    store.statusFilter = 'paid'
+
+    expect(store.pendingCount).toBe(1)
+    expect(store.revenue).toBe(20)
+  })
+})
