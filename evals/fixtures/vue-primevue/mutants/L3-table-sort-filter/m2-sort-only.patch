diff -ruN a/src/stores/orders.test.ts b/src/stores/orders.test.ts
--- /dev/null
+++ b/src/stores/orders.test.ts
@@ -0,0 +1,49 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { createPinia, setActivePinia } from 'pinia'
+import { useOrdersStore } from './orders'
+import type { Order } from '@/types'
+
+const fixtures: Order[] = [
+  { id: 'A', customer: 'A', email: 'a@test', total: 10, status: 'paid', createdAt: '2026-11-01T00:00:00Z' },
+  { id: 'B', customer: 'B', email: 'b@test', total: 20, status: 'pending', createdAt: '2026-11-02T00:00:00Z' },
+  { id: 'C', customer: 'C', email: 'c@test', total: 30, status: 'paid', createdAt: '2026-11-03T00:00:00Z' },
+]
+
+vi.mock('@/services/api', () => ({
+  fetchOrders: () => Promise.resolve(structuredClone(fixtures)),
+  deleteOrder: () => Promise.resolve(),
+}))
+
+describe('orders store status filter', () => {
+  beforeEach(() => {
+    setActivePinia(createPinia())
+  })
+
+  it('returns every order when no status is selected', async () => {
+    const store = useOrdersStore()
+    await store.load()
+    expect(store.filteredOrders.map((order) => order.id)).toEqual(['A', 'B', 'C'])
+  })
+
+  it('keeps only orders with the selected status', async () => {
+    const store = useOrdersStore()
+    await store.load()
+    store.statusFilter = 'paid'
+    expect(store.filteredOrders.map((order) => order.id)).toEqual(['A', 'C'])
+  })
+
+  it('returns no orders when none match the selected status', async () => {
+    const store = useOrdersStore()
+    await store.load()
+    store.statusFilter = 'refunded'
+    expect(store.filteredOrders).toEqual([])
+  })
+
+  it('does not change dashboard totals', async () => {
+    const store = useOrdersStore()
+    await store.load()
+    store.statusFilter = 'pending'
+    expect(store.revenue).toBe(60)
+    expect(store.pendingCount).toBe(1)
+  })
+})
