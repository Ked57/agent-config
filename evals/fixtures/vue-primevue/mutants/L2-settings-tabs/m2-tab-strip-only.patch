+// All tab panels stay mounted (hidden), so native validation still runs on fields in
+// inactive tabs. Reveal the tab holding the invalid field so the browser can show its message.
+async function onInvalid(event: Event) {
+  const field = event.target
+  if (!(field instanceof HTMLInputElement)) return
+  const tab = field.closest('[data-tab]')?.getAttribute('data-tab')
+  if (!tab || tab === activeTab.value) return
+  activeTab.value = tab
+  await nextTick()
+  field.reportValidity()
+}
