--- /dev/null
+++ b/src/services/api.test.ts
@@ -0,0 +1,28 @@
+import { describe, expect, it } from 'vitest'
+import { fetchPhotos } from './api'
+
+const pngDataUrls = import.meta.glob<string>('/public/images/photo-*.png', {
+  query: '?inline',
+  import: 'default',
+  eager: true,
+})
+
+// PNG stores width and height as big-endian uint32s at bytes 16-23 of the IHDR chunk.
+function pngSize(publicPath: string) {
+  const dataUrl = pngDataUrls[`/public${publicPath}`]
+  if (!dataUrl) throw new Error(`No image at ${publicPath}`)
+  const bytes = Uint8Array.from(atob(dataUrl.split(',')[1] ?? ''), (char) => char.charCodeAt(0))
+  const view = new DataView(bytes.buffer)
+  return { width: view.getUint32(16), height: view.getUint32(20) }
+}
+
+describe('fetchPhotos', () => {
+  it('declares each photo with its real intrinsic size so the gallery reserves space', async () => {
+    const photos = await fetchPhotos()
+
+    expect(photos.length).toBeGreaterThan(0)
+    for (const photo of photos) {
+      expect({ width: photo.width, height: photo.height }).toEqual(pngSize(photo.src))
+    }
+  })
+})
