diff -ruN a/src/utils/header.test.ts b/src/utils/header.test.ts
--- /dev/null
+++ b/src/utils/header.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from 'vitest'
+import { isHeaderCompact } from './header'
+
+describe('isHeaderCompact', () => {
+  it('stays full size at the top of the page', () => {
+    expect(isHeaderCompact(false, 0)).toBe(false)
+  })
+
+  it('compacts once scrolled past the threshold', () => {
+    expect(isHeaderCompact(false, 65)).toBe(true)
+  })
+
+  it('stays full size for small scrolls', () => {
+    expect(isHeaderCompact(false, 40)).toBe(false)
+  })
+
+  it('stays compact while scrolling back up until near the top', () => {
+    expect(isHeaderCompact(true, 40)).toBe(true)
+  })
+
+  it('returns to full size near the top', () => {
+    expect(isHeaderCompact(true, 0)).toBe(false)
+  })
+})
diff -ruN a/src/utils/header.ts b/src/utils/header.ts
--- /dev/null
+++ b/src/utils/header.ts
@@ -0,0 +1,8 @@
+// The sticky header stays in the document flow, so shrinking it shifts content and
+// changes scrollY. Separate thresholds keep it from flickering around a single cut-off.
+const COMPACT_AFTER_PX = 64
+const EXPAND_BELOW_PX = 8
+
+export function isHeaderCompact(wasCompact: boolean, scrollY: number): boolean {
+  return wasCompact ? scrollY >= EXPAND_BELOW_PX : scrollY > COMPACT_AFTER_PX
+}
