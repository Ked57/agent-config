+import { describe, expect, it } from 'vitest'
+import { validateDisplayName, validateEmail, validateSettings } from './settingsValidation'
+
+describe('validateDisplayName', () => {
+  it('requires a value', () => {
+    expect(validateDisplayName('')).toBe('Enter a display name.')
+    expect(validateDisplayName('   ')).toBe('Enter a display name.')
+  })
+
+  it('rejects fewer than 2 characters, ignoring surrounding whitespace', () => {
+    expect(validateDisplayName('A')).toBe('Display name must be at least 2 characters.')
+    expect(validateDisplayName(' A ')).toBe('Display name must be at least 2 characters.')
+  })
+
+  it('accepts 2 to 50 characters', () => {
+    expect(validateDisplayName('Al')).toBeUndefined()
+    expect(validateDisplayName('a'.repeat(50))).toBeUndefined()
+  })
+
+  it('rejects more than 50 characters', () => {
+    expect(validateDisplayName('a'.repeat(51))).toBe('Display name must be 50 characters or fewer.')
+  })
+
+  it('counts an emoji as one character', () => {
+    expect(validateDisplayName('😀'.repeat(50))).toBeUndefined()
+    expect(validateDisplayName('😀')).toBe('Display name must be at least 2 characters.')
+  })
+})
+
+describe('validateEmail', () => {
+  it('requires a value', () => {
+    expect(validateEmail('')).toBe('Enter an email address.')
+  })
+
+  it.each(['ada', 'ada@', '@acme.test', 'ada@acme', 'ada lovelace@acme.test', 'ada@@acme.test'])(
+    'rejects %s',
+    (value) => {
+      expect(validateEmail(value)).toBe('Enter an email address in the format you@example.com.')
+    },
+  )
+
+  it.each(['ada@acme.test', 'ada.lovelace+news@mail.acme.co.uk'])('accepts %s', (value) => {
+    expect(validateEmail(value)).toBeUndefined()
+  })
+})
+
+describe('validateSettings', () => {
+  it('returns no errors for valid settings', () => {
+    expect(validateSettings({ displayName: 'Ada Lovelace', email: 'ada@acme.test' })).toEqual({})
+  })
+
+  it('reports each invalid field', () => {
+    expect(validateSettings({ displayName: '', email: 'nope' })).toEqual({
+      displayName: 'Enter a display name.',
+      email: 'Enter an email address in the format you@example.com.',
+    })
+  })
+})
