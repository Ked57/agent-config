+import type { Settings } from '@/types'
+
+export type SettingsField = 'displayName' | 'email'
+export type SettingsErrors = Partial<Record<SettingsField, string>>
+
+export const DISPLAY_NAME_MIN = 2
+export const DISPLAY_NAME_MAX = 50
+
+// Deliberately permissive: one "@", no whitespace, and a dot in the domain.
+// The server remains the authority on deliverability.
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
+
+export function validateDisplayName(value: string): string | undefined {
+  // Count code points so an emoji is one character, and ignore surrounding whitespace.
+  const length = Array.from(value.trim()).length
+  if (length === 0) return 'Enter a display name.'
+  if (length < DISPLAY_NAME_MIN) return `Display name must be at least ${DISPLAY_NAME_MIN} characters.`
+  if (length > DISPLAY_NAME_MAX) return `Display name must be ${DISPLAY_NAME_MAX} characters or fewer.`
+  return undefined
+}
+
+export function validateEmail(value: string): string | undefined {
+  const email = value.trim()
+  if (email === '') return 'Enter an email address.'
+  if (!EMAIL_PATTERN.test(email)) return 'Enter an email address in the format you@example.com.'
+  return undefined
+}
+
+export function validateSettings(settings: Pick<Settings, SettingsField>): SettingsErrors {
+  const errors: SettingsErrors = {}
+  const displayName = validateDisplayName(settings.displayName)
+  const email = validateEmail(settings.email)
+  if (displayName) errors.displayName = displayName
+  if (email) errors.email = email
+  return errors
+}
