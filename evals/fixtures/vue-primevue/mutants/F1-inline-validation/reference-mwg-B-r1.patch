+const errorVisible = reactive<Record<SettingsField, boolean>>({ displayName: false, email: false })
+const announcement = ref('')
+let announceTimer: ReturnType<typeof setTimeout> | undefined
+let announcedField: SettingsField | undefined
+
+function shownError(field: SettingsField): string | undefined {
+  return errorVisible[field] ? errors.value[field] : undefined
+}
+
+function fieldA11y(field: SettingsField) {
+  const error = shownError(field)
+  return {
+    // Reference the error only while it is shown; hidden describedby text is still read.
+    'aria-invalid': error ? 'true' : 'false',
+    'aria-describedby': error ? `${field}-error` : undefined,
+  } as const
+}
+
+function clearAnnouncement() {
+  clearTimeout(announceTimer)
+  announcement.value = ''
+  announcedField = undefined
+}
+
+// One polite live region announces an error that appears on blur; each message names its
+// field. The delay lets the screen reader finish announcing the next focused field first.
+function announce(field: SettingsField, message: string) {
+  clearAnnouncement()
+  announcedField = field
+  announceTimer = setTimeout(() => {
+    announcement.value = message
+  }, 500)
+}
+
+function onFieldBlur(field: SettingsField) {
+  if (!edited[field]) return
+  const error = errors.value[field]
+  if (error && !errorVisible[field]) announce(field, error)
+  errorVisible[field] = Boolean(error)
