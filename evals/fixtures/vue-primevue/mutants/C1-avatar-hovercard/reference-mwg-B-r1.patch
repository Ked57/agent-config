+
+const RELATIVE_TIME_UNITS: ReadonlyArray<readonly [Intl.RelativeTimeFormatUnit, number]> = [
+  ['year', 365 * 24 * 60 * 60],
+  ['month', 30 * 24 * 60 * 60],
+  ['week', 7 * 24 * 60 * 60],
+  ['day', 24 * 60 * 60],
+  ['hour', 60 * 60],
+  ['minute', 60],
+]
+
+export function formatRelativeTime(iso: string, now = new Date(), locale = 'en-US'): string {
+  const seconds = (new Date(iso).getTime() - now.getTime()) / 1000
+  const formatter = new Intl.RelativeTimeFormat(locale, { numeric: 'auto' })
+  for (const [unit, unitSeconds] of RELATIVE_TIME_UNITS) {
+    if (Math.abs(seconds) >= unitSeconds) {
+      return formatter.format(Math.trunc(seconds / unitSeconds), unit)
+    }
+  }
+  return formatter.format(Math.trunc(seconds), 'second')
+}
diff -ruN a/src/utils/hovercard.test.ts b/src/utils/hovercard.test.ts
--- /dev/null
+++ b/src/utils/hovercard.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from 'vitest'
+import { placeHovercard } from './hovercard'
+
+const viewport = { width: 1000, height: 800 }
+const card = { width: 288, height: 160 }
+
+describe('placeHovercard', () => {
+  it('places the card below the trigger, aligned to its left edge', () => {
+    expect(placeHovercard({ top: 100, bottom: 148, left: 40 }, card, viewport)).toEqual({ top: 156, left: 40, side: 'below' })
+  })
+
+  it('flips above the trigger when there is no room below', () => {
+    expect(placeHovercard({ top: 700, bottom: 748, left: 40 }, card, viewport)).toEqual({ top: 532, left: 40, side: 'above' })
+  })
+
+  it('stays below when there is no room above either', () => {
+    const shortViewport = { width: 1000, height: 300 }
+    expect(placeHovercard({ top: 100, bottom: 148, left: 40 }, card, shortViewport).side).toBe('below')
+  })
+
+  it('keeps the card inside the viewport horizontally', () => {
+    expect(placeHovercard({ top: 100, bottom: 148, left: 900 }, card, viewport).left).toBe(704)
+    expect(placeHovercard({ top: 100, bottom: 148, left: -20 }, card, viewport).left).toBe(8)
+  })
+})
diff -ruN a/src/utils/hovercard.ts b/src/utils/hovercard.ts
--- /dev/null
+++ b/src/utils/hovercard.ts
@@ -0,0 +1,27 @@
+export interface HovercardPlacement {
+  top: number
+  left: number
+  side: 'below' | 'above'
+}
+
+const GAP = 8
+const VIEWPORT_MARGIN = 8
+
+/**
+ * Places a card below its trigger, aligned to the trigger's left edge. Flips above when it
+ * would overflow the bottom of the viewport and there is room above, and keeps it inside
+ * the viewport horizontally.
+ */
+export function placeHovercard(
+  trigger: { top: number; bottom: number; left: number },
+  card: { width: number; height: number },
+  viewport: { width: number; height: number },
+): HovercardPlacement {
+  const belowTop = trigger.bottom + GAP
+  const aboveTop = trigger.top - GAP - card.height
+  const overflowsBelow = belowTop + card.height > viewport.height - VIEWPORT_MARGIN
+  const side = overflowsBelow && aboveTop >= VIEWPORT_MARGIN ? 'above' : 'below'
+  const maxLeft = viewport.width - card.width - VIEWPORT_MARGIN
+  const left = Math.max(VIEWPORT_MARGIN, Math.min(trigger.left, maxLeft))
+  return { top: side === 'above' ? aboveTop : belowTop, left, side }
+}
