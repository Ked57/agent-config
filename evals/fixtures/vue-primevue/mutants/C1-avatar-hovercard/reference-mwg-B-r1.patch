+<script setup lang="ts">
+import { onBeforeUnmount, useId, useTemplateRef } from 'vue'
+import UserAvatar from '@/components/UserAvatar.vue'
+import { formatRelativeTime } from '@/utils/format'
+import { placeHovercard } from '@/utils/hovercard'
+import type { User } from '@/types'
+
+defineProps<{ user: User; size?: 'normal' | 'large' | 'xlarge' }>()
+
+// The open delay stops cards flashing while the pointer or Tab passes over the list; the
+// close delay lets the pointer cross the gap from the avatar onto the card.
+const OPEN_DELAY_MS = 300
+const CLOSE_DELAY_MS = 150
+
+const cardId = useId()
+const root = useTemplateRef<HTMLElement>('root')
+const card = useTemplateRef<HTMLElement>('card')
+
+let hovered = false
+let focused = false
+let timer: ReturnType<typeof setTimeout> | undefined
+
+function setHovered(value: boolean) {
+  hovered = value
+  scheduleToggle()
+}
+
+function setFocused(value: boolean) {
+  focused = value
+  scheduleToggle()
+}
+
+function scheduleToggle() {
+  clearTimeout(timer)
+  const wanted = hovered || focused
+  timer = setTimeout(wanted ? open : close, wanted ? OPEN_DELAY_MS : CLOSE_DELAY_MS)
+}
+
+function isOpen(): boolean {
+  return card.value?.matches(':popover-open') ?? false
+}
+
+function open() {
+  if (!root.value || !card.value || isOpen()) return
+  card.value.showPopover()
+  const placement = placeHovercard(root.value.getBoundingClientRect(), card.value.getBoundingClientRect(), {
+    width: document.documentElement.clientWidth,
+    height: document.documentElement.clientHeight,
+  })
+  card.value.style.top = `${placement.top}px`
+  card.value.style.left = `${placement.left}px`
+  card.value.style.transformOrigin = placement.side === 'above' ? 'bottom left' : 'top left'
+  document.addEventListener('keydown', onKeydown)
+  // The card is fixed to where the avatar was, so close it rather than let it drift on scroll.
+  window.addEventListener('scroll', close, { capture: true, passive: true })
+}
+
+function close() {
+  clearTimeout(timer)
+  document.removeEventListener('keydown', onKeydown)
+  window.removeEventListener('scroll', close, { capture: true })
+  if (isOpen()) card.value?.hidePopover()
+}
+
+// Escape dismisses the card whether it was opened by focus or by hover (WCAG 1.4.13).
+function onKeydown(event: KeyboardEvent) {
+  if (event.key === 'Escape') close()
+}
+
+onBeforeUnmount(close)
+</script>
+
+<template>
+  <div
+    ref="root"
+    class="inline-flex"
+    @mouseenter="setHovered(true)"
+    @mouseleave="setHovered(false)"
+    @focusin="setFocused(true)"
+    @focusout="setFocused(false)"
+  >
+    <RouterLink
+      :to="{ name: 'user', params: { id: user.id } }"
+      :aria-label="user.name"
+      :aria-describedby="cardId"
+      class="inline-flex rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
+    >
+      <UserAvatar :user="user" :size="size" />
+    </RouterLink>
+    <div
+      :id="cardId"
+      ref="card"
+      popover="manual"
+      role="tooltip"
+      class="inset-auto m-0 w-72 rounded-xl border border-surface-200 bg-surface-0 p-4 text-surface-900 shadow-lg ease-out starting:open:scale-95 starting:open:opacity-0 motion-safe:transition-[opacity,scale] motion-safe:duration-150"
+    >
+      <div class="flex items-center gap-3">
+        <UserAvatar :user="user" size="large" aria-hidden="true" />
+        <div class="min-w-0">
+          <p class="truncate font-semibold">{{ user.name }}</p>
+          <p class="truncate text-sm text-surface-500">{{ user.title }}</p>
+        </div>
+      </div>
+      <dl class="mt-3 grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-sm">
+        <dt class="text-surface-500">Location</dt>
+        <dd>{{ user.location }}</dd>
+        <dt class="text-surface-500">Email</dt>
+        <dd class="break-all">{{ user.email }}</dd>
+        <dt class="text-surface-500">Last active</dt>
+        <dd><time :datetime="user.lastActiveAt">{{ formatRelativeTime(user.lastActiveAt) }}</time></dd>
+      </dl>
+    </div>
+  </div>
+</template>
