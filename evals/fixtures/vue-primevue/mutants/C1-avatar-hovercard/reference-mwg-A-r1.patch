diff -ruN a/src/components/UserHovercard.vue b/src/components/UserHovercard.vue
--- /dev/null
+++ b/src/components/UserHovercard.vue
@@ -0,0 +1,83 @@
+<script setup lang="ts">
+import { onBeforeUnmount, ref, useId } from 'vue'
+import UserAvatar from '@/components/UserAvatar.vue'
+import { formatDate, formatRelativeTime } from '@/utils/format'
+import type { User } from '@/types'
+
+defineProps<{ user: User; size?: 'normal' | 'large' | 'xlarge' }>()
+
+// Short delays stop the card flashing as the pointer crosses the list, and give
+// the pointer time to move from the avatar onto the card without it closing.
+const OPEN_DELAY_MS = 200
+const CLOSE_DELAY_MS = 150
+
+const cardId = useId()
+const open = ref(false)
+let timer: ReturnType<typeof setTimeout> | undefined
+
+function schedule(next: boolean, delay: number) {
+  clearTimeout(timer)
+  timer = setTimeout(() => (open.value = next), delay)
+}
+
+function show() {
+  clearTimeout(timer)
+  open.value = true
+}
+
+function hide() {
+  clearTimeout(timer)
+  open.value = false
+}
+
+function onFocusOut(event: FocusEvent) {
+  const wrapper = event.currentTarget as HTMLElement
+  if (!wrapper.contains(event.relatedTarget as Node | null)) hide()
+}
+
+onBeforeUnmount(() => clearTimeout(timer))
+</script>
+
+<template>
+  <div
+    class="relative inline-flex"
+    @mouseenter="schedule(true, OPEN_DELAY_MS)"
+    @mouseleave="schedule(false, CLOSE_DELAY_MS)"
+    @focusin="show"
+    @focusout="onFocusOut"
+    @keydown.esc="hide"
+  >
+    <!-- A button rather than a tabindex span so the trigger has a real accessible
+         name; tapping it focuses it, which also opens the card on touch devices. -->
+    <button
+      type="button"
+      :aria-label="`Profile card for ${user.name}`"
+      :aria-describedby="cardId"
+      class="inline-flex cursor-default rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
+    >
+      <UserAvatar :user="user" :size="size" />
+    </button>
+    <!-- v-show keeps the card in the DOM so aria-describedby always resolves. -->
+    <div v-show="open" :id="cardId" role="tooltip" class="absolute top-full left-0 z-20 pt-2">
+      <div class="flex w-72 flex-col gap-3 rounded-xl border border-surface-200 bg-surface-0 p-4 shadow-lg">
+        <div class="flex items-center gap-3">
+          <UserAvatar :user="user" size="large" aria-hidden="true" />
+          <div class="min-w-0">
+            <p class="truncate font-semibold">{{ user.name }}</p>
+            <p class="truncate text-sm text-surface-500">{{ user.title }}</p>
+          </div>
+        </div>
+        <dl class="grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 text-sm">
+          <dt class="text-surface-500">Location</dt>
+          <dd class="truncate">{{ user.location }}</dd>
+          <dt class="text-surface-500">Email</dt>
+          <dd class="break-all">{{ user.email }}</dd>
+          <dt class="text-surface-500">Last active</dt>
+          <dd>
+            <time :datetime="user.lastActiveAt" :title="formatDate(user.lastActiveAt)">{{ formatRelativeTime(user.lastActiveAt) }}</time>
+          </dd>
+        </dl>
+      </div>
+    </div>
+  </div>
+</template>
