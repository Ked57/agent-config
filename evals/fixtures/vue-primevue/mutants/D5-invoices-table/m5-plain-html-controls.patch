+<script setup lang="ts">
+import type { Invoice } from '@/services/invoices'
+import { dueNote, money, shortDate } from './format'
+
+defineProps<{ invoices: Invoice[] }>()
+const selected = defineModel<string[]>('selected', { required: true })
+const sortField = defineModel<string>('sortField', { required: true })
+const sortOrder = defineModel<1 | -1>('sortOrder', { required: true })
+
+function sortBy(field: string) {
+  sortOrder.value = sortField.value === field ? (sortOrder.value === 1 ? -1 : 1) : 1
+  sortField.value = field
+}
+</script>
+
+<template>
+  <div class="overflow-x-auto">
+    <table class="w-full min-w-[56rem] text-left text-sm">
+      <thead>
+        <tr>
+          <th></th>
+          <th @click="sortBy('number')">Invoice</th>
+          <th>Customer</th>
+          <th @click="sortBy('issuedAt')">Issued</th>
+          <th @click="sortBy('dueAt')">Due</th>
+          <th>Status</th>
+          <th class="text-right" @click="sortBy('amount')">Amount</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr v-for="invoice in invoices" :key="invoice.id" class="border-t border-surface-200">
+          <td><input v-model="selected" type="checkbox" :value="invoice.id" :aria-label="`Select ${invoice.number}`" /></td>
+          <td>{{ invoice.number }}</td>
+          <td>{{ invoice.customer.name }}<br />{{ invoice.customer.email }}</td>
+          <td>{{ shortDate(invoice.issuedAt) }}</td>
+          <td>{{ shortDate(invoice.dueAt) }}<br />{{ dueNote(invoice) }}</td>
+          <td>{{ invoice.status }}</td>
+          <td class="text-right">{{ money(invoice.amount) }}</td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</template>
diff --git a/src/components/invoices/format.ts b/src/components/invoices/format.ts
