+++ b/src/components/invoices/format.ts
@@ -0,0 +1,23 @@
+import type { Invoice, InvoiceStatus } from '@/services/invoices'
+
+const DAY = 24 * 60 * 60 * 1000
+
+export const money = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value)
+export const shortDate = (iso: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso))
+
+/** "Due in 3 days", "4 days overdue", "Due today"; null for paid and draft invoices. */
+export function dueNote(invoice: Invoice): string | null {
+  if (invoice.status === 'Paid' || invoice.status === 'Draft') return null
+  const today = new Date()
+  const days = Math.round((Date.parse(invoice.dueAt) - Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate())) / DAY)
+  if (days === 0) return 'Due today'
+  const plural = (count: number) => `${count} ${count === 1 ? 'day' : 'days'}`
+  return days > 0 ? `Due in ${plural(days)}` : `${plural(-days)} overdue`
+}
+
+export const statusSeverity: Record<InvoiceStatus, 'success' | 'info' | 'danger' | 'secondary'> = {
+  Paid: 'success',
+  Open: 'info',
+  Overdue: 'danger',
+  Draft: 'secondary',
+}
