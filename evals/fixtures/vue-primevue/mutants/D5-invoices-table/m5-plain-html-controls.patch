diff --git a/src/views/InvoicesView.vue b/src/views/InvoicesView.vue
new file mode 100644
index 0000000..bdfdde3
--- /dev/null
+++ b/src/views/InvoicesView.vue
@@ -0,0 +1,130 @@
+<script setup lang="ts">
+import { computed, ref, watch } from 'vue'
+import InvoiceCards from '@/components/invoices/InvoiceCards.vue'
+import InvoiceTable from '@/components/invoices/InvoiceTable.vue'
+import { money } from '@/components/invoices/format'
+import { fetchInvoices, invoiceStatuses, type Invoice, type InvoiceStatus } from '@/services/invoices'
+
+const PAGE_SIZE = 8
+
+const invoices = ref<Invoice[] | null>(null)
+const search = ref('')
+const statuses = ref<InvoiceStatus[]>([])
+const selected = ref<string[]>([])
+const sortField = ref('issuedAt')
+const sortOrder = ref<1 | -1>(-1)
+const first = ref(0)
+
+void fetchInvoices().then((result) => {
+  invoices.value = result
+})
+
+const outstanding = computed(() => (invoices.value ?? []).filter((invoice) => invoice.status === 'Open' || invoice.status === 'Overdue'))
+const counts = computed(() => Object.fromEntries(invoiceStatuses.map((status) => [status, (invoices.value ?? []).filter((invoice) => invoice.status === status).length])))
+
+const filtered = computed(() => {
+  const query = search.value.trim().toLowerCase()
+  return (invoices.value ?? []).filter((invoice) => (!statuses.value.length || statuses.value.includes(invoice.status))
+    && (!query || invoice.number.toLowerCase().includes(query) || invoice.customer.name.toLowerCase().includes(query)))
+})
+
+const sorted = computed(() => {
+  const field = sortField.value as keyof Invoice
+  const value = (invoice: Invoice) => (field === 'amount' ? invoice.amount : String(invoice[field] ?? ''))
+  return [...filtered.value].sort((a, b) => {
+    const [x, y] = [value(a), value(b)]
+    return (x < y ? -1 : x > y ? 1 : 0) * sortOrder.value
+  })
+})
+
+const page = computed(() => sorted.value.slice(first.value, first.value + PAGE_SIZE))
+const range = computed(() => (sorted.value.length ? `Showing ${first.value + 1}–${Math.min(first.value + PAGE_SIZE, sorted.value.length)} of ${sorted.value.length}` : ''))
+const selectedTotal = computed(() => (invoices.value ?? []).filter((invoice) => selected.value.includes(invoice.id)).reduce((sum, invoice) => sum + invoice.amount, 0))
+
+watch([search, statuses, sortField, sortOrder], () => {
+  first.value = 0
+})
+
+function toggleStatus(status: InvoiceStatus) {
+  statuses.value = statuses.value.includes(status) ? statuses.value.filter((entry) => entry !== status) : [...statuses.value, status]
+}
+
+function clearFilters() {
+  search.value = ''
+  statuses.value = []
+}
+</script>
+
+<template>
+  <div v-if="invoices" class="flex flex-col gap-6">
+    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
+      <div>
+        <h1 class="text-2xl font-semibold tracking-tight text-surface-900">Invoices</h1>
+        <p class="mt-1 text-sm text-surface-500">
+          <template v-if="outstanding.length">{{ money(outstanding.reduce((sum, invoice) => sum + invoice.amount, 0)) }} outstanding across {{ outstanding.length }} invoices</template>
+          <template v-else>Bill customers and track what they owe you.</template>
+        </p>
+      </div>
+      <div class="flex gap-3">
+        <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm">Export</button>
+        <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm">New invoice</button>
+      </div>
+    </header>
+
+    <section class="overflow-hidden rounded-xl border border-surface-200 bg-surface-0 shadow-sm" aria-label="Invoices">
+      <div v-if="!invoices.length" class="flex flex-col items-center gap-3 px-6 py-20 text-center">
+        <span class="flex size-12 items-center justify-center rounded-full bg-primary-50 text-primary-700" aria-hidden="true">
+          <i class="pi pi-file text-lg"></i>
+        </span>
+        <h2 class="text-base font-semibold text-surface-900">No invoices yet</h2>
+        <p class="max-w-sm text-sm text-surface-500">Create your first invoice to start getting paid. Drafts stay private until you send them.</p>
+        <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm">New invoice</button>
+      </div>
+
+      <template v-else>
+        <div class="flex flex-col gap-3 border-b border-surface-200 p-4 lg:flex-row lg:items-center">
+          <input v-model="search" placeholder="Search by number or customer" aria-label="Search invoices" class="rounded border border-surface-300 bg-surface-0 px-2 py-1.5 text-sm" />
+          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by status">
+            <button
+              v-for="status in invoiceStatuses"
+              :key="status"
+              type="button"
+              class="inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm font-medium transition-colors"
+              :class="statuses.includes(status) ? 'border-primary-300 bg-primary-50 text-primary-800' : 'border-surface-200 bg-surface-0 text-surface-700 hover:bg-surface-50'"
+              :aria-pressed="statuses.includes(status)"
+              @click="toggleStatus(status)"
+            >
+              <i v-if="statuses.includes(status)" class="pi pi-check text-xs" aria-hidden="true"></i>
+              {{ status }}
+              <span class="rounded-full px-1.5 text-xs tabular-nums" :class="statuses.includes(status) ? 'bg-primary-100' : 'bg-surface-100 text-surface-600'">{{ counts[status] }}</span>
+            </button>
+          </div>
+        </div>
+
+        <div v-if="selected.length" class="flex flex-wrap items-center gap-2 border-b border-primary-200 bg-primary-50 px-4 py-2.5" role="region" aria-label="Bulk actions">
+          <span class="mr-2 text-sm font-semibold text-primary-800">{{ selected.length }} selected</span>
+          <span class="mr-auto text-sm text-primary-800 tabular-nums">{{ money(selectedTotal) }} total</span>
+          <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm">Send reminder</button>
+          <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm">Mark as paid</button>
+          <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm" @click="selected = []">Clear selection</button>
+        </div>
+
+        <div v-if="!sorted.length" class="flex flex-col items-center gap-2 px-6 py-16 text-center">
+          <h2 class="text-base font-semibold text-surface-900">No invoices match your filters</h2>
+          <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm" @click="clearFilters">Clear filters</button>
+        </div>
+        <template v-else>
+          <InvoiceTable v-model:selected="selected" v-model:sort-field="sortField" v-model:sort-order="sortOrder" :invoices="page" class="hidden md:block" />
+          <InvoiceCards v-model:selected="selected" :invoices="page" class="md:hidden" />
+          <div class="flex flex-col items-center gap-2 border-t border-surface-200 px-4 py-3 sm:flex-row sm:justify-between">
+            <p class="text-sm text-surface-500 tabular-nums">{{ range }}</p>
+            <div class="flex gap-2">
+              <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm" :disabled="first === 0" @click="first -= PAGE_SIZE">Previous page</button>
+              <button type="button" class="rounded border border-surface-300 bg-surface-0 px-3 py-1.5 text-sm" :disabled="first + PAGE_SIZE >= sorted.length" @click="first += PAGE_SIZE">Next page</button>
+            </div>
+          </div>
+        </template>
+      </template>
+    </section>
+  </div>
+</template>
