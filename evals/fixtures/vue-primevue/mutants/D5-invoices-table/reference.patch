@@ -0,0 +1,84 @@
+<script setup lang="ts">
+import Checkbox from 'primevue/checkbox'
+import Column from 'primevue/column'
+import DataTable, { type DataTableSortEvent } from 'primevue/datatable'
+import Tag from 'primevue/tag'
+import type { Invoice } from '@/services/invoices'
+import { initials } from '@/utils/format'
+import { dueNote, money, shortDate, statusSeverity } from './format'
+
+const props = defineProps<{ invoices: Invoice[] }>()
+const selected = defineModel<string[]>('selected', { required: true })
+const sortField = defineModel<string>('sortField', { required: true })
+const sortOrder = defineModel<1 | -1>('sortOrder', { required: true })
+
+const allSelected = () => props.invoices.length > 0 && props.invoices.every((invoice) => selected.value.includes(invoice.id))
+function toggleAll() {
+  const ids = props.invoices.map((invoice) => invoice.id)
+  selected.value = allSelected() ? selected.value.filter((id) => !ids.includes(id)) : [...new Set([...selected.value, ...ids])]
+}
+function onSort(event: DataTableSortEvent) {
+  sortField.value = String(event.sortField)
+  sortOrder.value = event.sortOrder === -1 ? -1 : 1
+}
+</script>
+
+<template>
+  <DataTable
+    :value="invoices"
+    data-key="id"
+    lazy
+    removable-sort
+    :sort-field="sortField"
+    :sort-order="sortOrder"
+    :row-class="(invoice: Invoice) => (selected.includes(invoice.id) ? '!bg-primary-50' : '')"
+    table-class="min-w-[56rem]"
+    @sort="onSort"
+  >
+    <Column header-class="w-12">
+      <template #header>
+        <Checkbox :model-value="allSelected()" binary aria-label="Select all invoices on this page" @update:model-value="toggleAll" />
+      </template>
+      <template #body="{ data }">
+        <Checkbox v-model="selected" :value="data.id" :aria-label="`Select ${data.number}`" />
+      </template>
+    </Column>
+    <Column field="number" header="Invoice" sortable>
+      <template #body="{ data }">
+        <span class="font-medium text-surface-900 tabular-nums">{{ data.number }}</span>
+      </template>
+    </Column>
+    <Column field="customer" header="Customer">
+      <template #body="{ data }">
+        <div class="flex items-center gap-3">
+          <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-surface-100 text-xs font-semibold text-surface-700" aria-hidden="true">{{ initials(data.customer.name) }}</span>
+          <div class="min-w-0 max-w-56">
+            <p class="truncate font-medium text-surface-900">{{ data.customer.name }}</p>
+            <p class="truncate text-sm text-surface-500">{{ data.customer.email }}</p>
+          </div>
+        </div>
+      </template>
+    </Column>
+    <Column field="issuedAt" header="Issued" sortable>
+      <template #body="{ data }">
+        <span class="whitespace-nowrap text-surface-700">{{ shortDate(data.issuedAt) }}</span>
+      </template>
+    </Column>
+    <Column field="dueAt" header="Due" sortable>
+      <template #body="{ data }">
+        <p class="whitespace-nowrap text-surface-700">{{ shortDate(data.dueAt) }}</p>
+        <p v-if="dueNote(data)" class="whitespace-nowrap text-sm" :class="data.status === 'Overdue' ? 'font-medium text-red-700' : 'text-surface-500'">{{ dueNote(data) }}</p>
+      </template>
+    </Column>
+    <Column field="status" header="Status">
+      <template #body="{ data }">
+        <Tag :value="data.status" :severity="statusSeverity[data.status as Invoice['status']]" />
+      </template>
+    </Column>
+    <Column field="amount" header="Amount" sortable header-class="[&_.p-datatable-column-header-content]:justify-end" body-class="text-right">
+      <template #body="{ data }">
+        <span class="font-medium text-surface-900 tabular-nums">{{ money(data.amount) }}</span>
+      </template>
+    </Column>
+  </DataTable>
+</template>
diff --git a/src/components/invoices/format.ts b/src/components/invoices/format.ts
new file mode 100644
index 0000000..099e739
--- /dev/null
+++ b/src/components/invoices/format.ts
@@ -0,0 +1,23 @@
+import type { Invoice, InvoiceStatus } from '@/services/invoices'
+
+const DAY = 24 * 60 * 60 * 1000
+
+export const money = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value)
+export const shortDate = (iso: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso))
+
+/** "Due in 3 days", "4 days overdue", "Due today"; null for paid and draft invoices. */
+export function dueNote(invoice: Invoice): string | null {
+  if (invoice.status === 'Paid' || invoice.status === 'Draft') return null
+  const today = new Date()
+  const days = Math.round((Date.parse(invoice.dueAt) - Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate())) / DAY)
+  if (days === 0) return 'Due today'
+  const plural = (count: number) => `${count} ${count === 1 ? 'day' : 'days'}`
+  return days > 0 ? `Due in ${plural(days)}` : `${plural(-days)} overdue`
+}
+
+export const statusSeverity: Record<InvoiceStatus, 'success' | 'info' | 'danger' | 'secondary'> = {
+  Paid: 'success',
+  Open: 'info',
+  Overdue: 'danger',
+  Draft: 'secondary',
+}
