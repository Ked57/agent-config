+import { createPinia, setActivePinia } from 'pinia'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { fetchUsers } from '@/services/api'
+import type { User, UserRole } from '@/types'
+import { useUsersStore } from './users'
+
+vi.mock('@/services/api', () => ({ fetchUsers: vi.fn() }))
+
+function makeUser(id: string, name: string, email: string, role: UserRole): User {
+  return { id, name, email, role, title: '', location: '', avatarUrl: '', bio: '', lastActiveAt: '' }
+}
+
+const fixtures: User[] = [
+  makeUser('u1', 'Ada Lovelace', 'ada@acme.test', 'admin'),
+  makeUser('u2', 'Grace Hopper', 'grace@acme.test', 'editor'),
+  makeUser('u3', 'Alan Turing', 'alan@acme.test', 'editor'),
+]
+
+describe('users store', () => {
+  beforeEach(() => {
+    setActivePinia(createPinia())
+    vi.mocked(fetchUsers).mockReset()
+    vi.mocked(fetchUsers).mockResolvedValue(structuredClone(fixtures))
+  })
+
+  it('counts users by role, including roles with no users', async () => {
+    const store = useUsersStore()
+    expect(store.countsByRole).toEqual({ admin: 0, editor: 0, viewer: 0 })
+
+    await store.load()
+
+    expect(store.countsByRole).toEqual({ admin: 1, editor: 2, viewer: 0 })
+  })
+
+  it('filters by case-insensitive name or email search and by role', async () => {
+    const store = useUsersStore()
+    await store.load()
+
+    store.setSearch('ACME')
+    expect(store.filteredUsers).toHaveLength(3)
+    store.setSearch('grace')
+    expect(store.filteredUsers.map((user) => user.id)).toEqual(['u2'])
+
+    store.setSearch('')
+    store.setRoleFilter('editor')
+    expect(store.filteredUsers.map((user) => user.id)).toEqual(['u2', 'u3'])
+  })
+
+  it('looks users up by id', async () => {
+    const store = useUsersStore()
+    await store.load()
+
+    expect(store.byId('u3')?.name).toBe('Alan Turing')
+    expect(store.byId('missing')).toBeUndefined()
+  })
+
+  it('loads once unless forced', async () => {
+    const store = useUsersStore()
+    await store.load()
+    await store.load()
+    expect(fetchUsers).toHaveBeenCalledTimes(1)
+
+    await store.load(true)
+    expect(fetchUsers).toHaveBeenCalledTimes(2)
+    expect(store.loading).toBe(false)
+  })
+
+  it('records the error message when loading fails', async () => {
+    vi.mocked(fetchUsers).mockRejectedValue(new Error('Network down'))
+    const store = useUsersStore()
+
+    await store.load()
+
+    expect(store.error).toBe('Network down')
+    expect(store.loaded).toBe(false)
+    expect(store.loading).toBe(false)
+  })
+})
