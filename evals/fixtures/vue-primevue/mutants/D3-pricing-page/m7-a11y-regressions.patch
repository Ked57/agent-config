diff --git a/src/views/PricingView.vue b/src/views/PricingView.vue
new file mode 100644
index 0000000..0b3ff0f
--- /dev/null
+++ b/src/views/PricingView.vue
@@ -0,0 +1,73 @@
+<script setup lang="ts">
+import { ref } from 'vue'
+import Accordion from 'primevue/accordion'
+import AccordionContent from 'primevue/accordioncontent'
+import AccordionHeader from 'primevue/accordionheader'
+import AccordionPanel from 'primevue/accordionpanel'
+import SelectButton from 'primevue/selectbutton'
+import Tag from 'primevue/tag'
+import ComparisonTable from '@/components/pricing/ComparisonTable.vue'
+import PlanCard from '@/components/pricing/PlanCard.vue'
+import { fetchPricing, type BillingPeriod, type Pricing } from '@/services/pricing'
+
+const pricing = ref<Pricing | null>(null)
+const period = ref<BillingPeriod>('monthly')
+const periods: { value: BillingPeriod; label: string }[] = [
+  { value: 'monthly', label: 'Monthly' },
+  { value: 'yearly', label: 'Yearly' },
+]
+
+void fetchPricing().then((result) => {
+  pricing.value = result
+})
+</script>
+
+<template>
+  <div v-if="pricing" class="flex flex-col gap-16 pb-8">
+    <header class="mx-auto flex max-w-2xl flex-col items-center pt-4 text-center">
+      <p class="text-sm font-semibold text-primary-700">Pricing</p>
+      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-surface-900 text-balance">Plans that grow with your team</h1>
+      <p class="mt-4 text-lg text-surface-600">Start free for 14 days. Every plan includes unlimited report viewers and two-factor authentication.</p>
+      <div class="mt-8 flex items-center gap-3">
+        <SelectButton v-model="period" :options="periods" option-label="label" option-value="value" :allow-empty="false" aria-label="Billing period" />
+        <Tag :value="`Save ${pricing.yearlyDiscountPercent}%`" severity="success" class="!text-xs" />
+      </div>
+    </header>
+
+    <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" aria-label="Plans">
+      <PlanCard
+        v-for="plan in pricing.plans"
+        :key="plan.id"
+        :plan="plan"
+        :period="period"
+        :class="{ 'order-first sm:order-none': plan.highlighted }"
+      />
+    </section>
+
+    <section class="flex flex-col gap-6" aria-labelledby="compare-title">
+      <div>
+        <h2 id="compare-title" class="text-2xl font-semibold tracking-tight text-surface-900">Compare plans</h2>
+        <p class="mt-1 text-sm text-surface-500">Prices are per member. Every limit applies to one workspace.</p>
+      </div>
+      <ComparisonTable :plans="pricing.plans" :groups="pricing.comparison" />
+    </section>
+
+    <section class="grid gap-8 border-t border-surface-200 pt-12 lg:grid-cols-[1fr_2fr] lg:gap-16" aria-labelledby="faq-title">
+      <div>
+        <h2 id="faq-title" class="text-2xl font-semibold tracking-tight text-surface-900">Frequently asked questions</h2>
+        <p class="mt-3 text-sm text-surface-500">
+          Can’t find what you need?
+          <a href="mailto:sales@acme.test" class="font-medium text-primary-400 underline underline-offset-2">Talk to sales</a>
+        </p>
+      </div>
+      <Accordion :value="null" class="rounded-2xl border border-surface-200 bg-surface-0 px-2 shadow-sm">
+        <AccordionPanel v-for="(faq, index) in pricing.faqs" :key="faq.id" :value="faq.id" :class="{ '!border-b-0': index === pricing.faqs.length - 1 }">
+          <AccordionHeader class="!bg-transparent !text-surface-900">{{ faq.question }}</AccordionHeader>
+          <AccordionContent :pt="{ content: { class: '!bg-transparent' } }">
+            <p class="text-sm leading-6 text-surface-600">{{ faq.answer }}</p>
+          </AccordionContent>
+        </AccordionPanel>
+      </Accordion>
+    </section>
+  </div>
+</template>
