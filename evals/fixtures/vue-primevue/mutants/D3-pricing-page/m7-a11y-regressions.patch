+            v-for="plan in plans"
+            :key="plan.id"
+            scope="col"
+            class="px-4 py-4 text-center font-semibold text-surface-900"
+            :class="{ 'bg-primary-50': plan.highlighted }"
+          >
+            {{ plan.name }}
+          </th>
+        </tr>
+      </thead>
+      <tbody v-for="group in groups" :key="group.label">
+        <tr>
+          <th scope="colgroup" :colspan="plans.length + 1" class="bg-surface-50 px-6 py-2 text-left text-xs font-semibold uppercase tracking-wide text-surface-500">
+            {{ group.label }}
+          </th>
+        </tr>
+        <tr v-for="row in group.rows" :key="row.feature" class="border-t border-surface-100">
+          <th scope="row" class="px-6 py-3 text-left font-normal text-surface-700">{{ row.feature }}</th>
+          <td
+            v-for="plan in plans"
+            :key="plan.id"
+            class="px-4 py-3 text-center tabular-nums text-surface-900"
+            :class="{ 'bg-primary-50': plan.highlighted }"
+          >
+            <template v-if="row.values[plan.id] === true">
+              <i class="pi pi-check text-primary-600" aria-hidden="true"></i>
+              <span class="sr-only">Included</span>
+            </template>
+            <template v-else-if="row.values[plan.id] === false">
+              <i class="pi pi-minus text-surface-300" aria-hidden="true"></i>
+              <span class="sr-only">Not included</span>
+            </template>
+            <template v-else>{{ row.values[plan.id] }}</template>
+          </td>
+        </tr>
+      </tbody>
+    </table>
