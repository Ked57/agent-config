diff --git a/src/components/pricing/PlanCard.vue b/src/components/pricing/PlanCard.vue
new file mode 100644
index 0000000..191c21d
--- /dev/null
+++ b/src/components/pricing/PlanCard.vue
@@ -0,0 +1,50 @@
+<script setup lang="ts">
+import { computed } from 'vue'
+import Button from 'primevue/button'
+import type { BillingPeriod, Plan } from '@/services/pricing'
+
+const props = defineProps<{ plan: Plan; period: BillingPeriod }>()
+
+const price = computed(() => (props.plan.price ? props.plan.price[props.period] : null))
+const billed = computed(() => {
+  if (!props.plan.price) return props.plan.priceNote ?? ''
+  return props.period === 'yearly' ? `Billed $${props.plan.price.yearly * 12} yearly` : 'Billed monthly'
+})
+</script>
+
+<template>
+  <article
+    class="relative flex flex-col rounded-2xl bg-surface-0 p-6"
+    :class="plan.highlighted ? 'border-2 border-primary-600 shadow-lg ring-4 ring-primary-100' : 'border border-surface-200 shadow-sm'"
+    :aria-labelledby="`plan-${plan.id}`"
+  >
+    <span
+      v-if="plan.highlighted"
+      class="absolute -top-3.5 left-1/2 inline-flex -translate-x-1/2 items-center gap-1 whitespace-nowrap rounded-full bg-primary-700 px-3 py-1 text-xs font-semibold text-white shadow-sm"
+    >
+      <i class="pi pi-star-fill text-[0.625rem]" aria-hidden="true"></i>
+      Most popular
+    </span>
+    <h2 :id="`plan-${plan.id}`" class="text-lg font-semibold text-surface-900">{{ plan.name }}</h2>
+    <p class="mt-1 min-h-10 text-sm text-surface-300">{{ plan.description }}</p>
+    <div class="mt-6 flex items-baseline gap-1">
+      <span v-if="price !== null" class="text-4xl font-semibold tracking-tight text-surface-900 tabular-nums">${{ price }}</span>
+      <span v-else class="text-4xl font-semibold tracking-tight text-surface-900">Custom</span>
+      <span v-if="price !== null" class="text-sm text-surface-500">/ member / month</span>
+    </div>
+    <p class="mt-1 text-sm text-surface-300">{{ billed }}</p>
+    <ul class="mt-6 mb-8 flex flex-col gap-3 border-t border-surface-100 pt-6">
+      <li v-for="feature in plan.features" :key="feature" class="flex gap-3 text-sm text-surface-700">
+        <i class="pi pi-check mt-0.5 text-sm text-primary-600" aria-hidden="true"></i>
+        {{ feature }}
+      </li>
+    </ul>
+    <Button
+      :label="plan.cta"
+      :severity="plan.highlighted ? undefined : 'secondary'"
+      :outlined="!plan.highlighted"
+      class="mt-auto w-full"
+      :class="{ '!border-primary-700 !bg-primary-700': plan.highlighted }"
+    />
+  </article>
+</template>
