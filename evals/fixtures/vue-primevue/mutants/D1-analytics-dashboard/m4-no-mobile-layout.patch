+<script setup lang="ts">
+import { computed } from 'vue'
+
+const props = defineProps<{ values: number[]; positive: boolean }>()
+
+const WIDTH = 72
+const HEIGHT = 32
+
+const path = computed(() => {
+  const min = Math.min(...props.values)
+  const max = Math.max(...props.values)
+  const span = max - min || 1
+  const step = WIDTH / Math.max(props.values.length - 1, 1)
+  return props.values
+    .map((value, index) => `${index === 0 ? 'M' : 'L'}${(index * step).toFixed(1)},${(HEIGHT - 2 - ((value - min) / span) * (HEIGHT - 4)).toFixed(1)}`)
+    .join(' ')
+})
+</script>
+
+<template>
+  <svg :viewBox="`0 0 ${WIDTH} ${HEIGHT}`" :width="WIDTH" :height="HEIGHT" aria-hidden="true" class="shrink-0">
+    <path :d="path" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" :class="positive ? 'stroke-emerald-500' : 'stroke-red-500'" />
+  </svg>
+</template>
