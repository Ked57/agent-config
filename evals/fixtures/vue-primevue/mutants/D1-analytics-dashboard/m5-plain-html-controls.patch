+  <section class="flex flex-col gap-4 rounded-xl border border-surface-200 bg-surface-0 p-5">
+    <h2 class="text-base font-semibold text-surface-900">Recent activity</h2>
+    <ol v-if="items.length" class="flex flex-col gap-4">
+      <li v-for="item in items" :key="item.id" class="flex items-start gap-3">
+        <span class="flex size-8 shrink-0 items-center justify-center rounded-full" :class="icons[item.kind].tone">
+          <i :class="icons[item.kind].icon" class="text-sm" aria-hidden="true"></i>
+        </span>
+        <div class="min-w-0 text-sm">
+          <p class="text-surface-900"><span class="font-medium">{{ item.actor }}</span> {{ item.text }}</p>
+          <p class="text-surface-500"><time :datetime="item.at">{{ when(item.at) }}</time></p>
+        </div>
+      </li>
+    </ol>
+    <p v-else class="py-6 text-center text-sm text-surface-500">No activity yet</p>
+  </section>
+</template>
