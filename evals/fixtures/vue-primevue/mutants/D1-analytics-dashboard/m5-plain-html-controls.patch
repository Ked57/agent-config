diff --git a/src/views/AnalyticsView.vue b/src/views/AnalyticsView.vue
new file mode 100644
index 0000000..f86ded3
--- /dev/null
+++ b/src/views/AnalyticsView.vue
@@ -0,0 +1,46 @@
+<script setup lang="ts">
+import { computed, ref, watch } from 'vue'
+import ActivityList from '@/components/analytics/ActivityList.vue'
+import KpiCard from '@/components/analytics/KpiCard.vue'
+import RevenueChart from '@/components/analytics/RevenueChart.vue'
+import TopCustomersTable from '@/components/analytics/TopCustomersTable.vue'
+import { dateRanges, defaultDateRange, fetchAnalytics, type Analytics, type DateRange } from '@/services/analytics'
+
+const range = ref<DateRange>(defaultDateRange)
+const data = ref<Analytics | null>(null)
+
+const rangeLabel = computed(() => dateRanges.find((option) => option.value === range.value)?.label ?? '')
+
+watch(range, async (value) => {
+  const result = await fetchAnalytics(value)
+  if (value === range.value) data.value = result
+}, { immediate: true })
+</script>
+
+<template>
+  <section class="flex flex-col gap-6">
+    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
+      <div>
+        <h1 class="text-2xl font-semibold tracking-tight text-surface-900">Analytics</h1>
+        <p class="mt-1 text-sm text-surface-500">Revenue and customer health across your workspace.</p>
+      </div>
+      <div class="flex gap-3">
+        <select v-model="range" aria-label="Date range"><option v-for="option in dateRanges" :key="option.value" :value="option.value">{{ option.label }}</option></select>
+        <button type="button">Export report</button>
+      </div>
+    </header>
+
+    <template v-if="data">
+      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
+        <KpiCard v-for="kpi in data.kpis" :key="kpi.id" :kpi="kpi" />
+      </div>
+
+      <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
+        <RevenueChart class="lg:col-span-2" :points="data.revenue" :range-label="rangeLabel" />
+        <ActivityList :items="data.activity" />
+      </div>
+
+      <TopCustomersTable :customers="data.customers" />
+    </template>
+  </section>
+</template>
