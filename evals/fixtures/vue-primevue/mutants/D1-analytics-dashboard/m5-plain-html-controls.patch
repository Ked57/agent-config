+<script setup lang="ts">
+import type { Activity } from '@/services/analytics'
+
+defineProps<{ items: Activity[] }>()
+
+const icons: Record<Activity['kind'], { icon: string; tone: string }> = {
+  upgrade: { icon: 'pi pi-arrow-up', tone: 'bg-emerald-50 text-emerald-700' },
+  payment: { icon: 'pi pi-credit-card', tone: 'bg-sky-50 text-sky-700' },
+  signup: { icon: 'pi pi-user-plus', tone: 'bg-violet-50 text-violet-700' },
+  refund: { icon: 'pi pi-replay', tone: 'bg-amber-50 text-amber-700' },
+  cancellation: { icon: 'pi pi-times', tone: 'bg-red-50 text-red-700' },
+}
