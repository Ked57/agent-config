+<script setup lang="ts">
+import { computed } from 'vue'
+import TrendLine from '@/components/analytics/TrendLine.vue'
+import type { Kpi } from '@/services/analytics'
+
+const props = defineProps<{ kpi: Kpi }>()
+
+const value = computed(() => {
+  const { value: raw, format } = props.kpi
+  if (format === 'currency') return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(raw)
+  if (format === 'percent') return `${raw.toFixed(1)}%`
+  return new Intl.NumberFormat('en-US').format(raw)
+})
+
+const up = computed(() => props.kpi.delta >= 0)
+</script>
+
+<template>
+  <article class="flex flex-col gap-3 rounded-xl border border-surface-200 bg-surface-0 p-5">
+    <h2 class="text-sm font-medium text-surface-500">{{ kpi.label }}</h2>
+    <div class="flex items-end justify-between gap-3">
+      <p class="text-3xl font-semibold tracking-tight text-surface-900 tabular-nums">{{ value }}</p>
+      <TrendLine :values="kpi.trend" :positive="up" />
+    </div>
+    <p class="flex items-center gap-2 text-sm">
+      <span
+        class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 font-medium tabular-nums"
+        :class="up ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700'"
+      >
+        <i :class="up ? 'pi pi-arrow-up-right' : 'pi pi-arrow-down-right'" class="text-xs" aria-hidden="true"></i>
+        {{ up ? '+' : '−' }}{{ Math.abs(kpi.delta).toFixed(1) }}%
+      </span>
+      <span class="text-surface-500">vs previous period</span>
+    </p>
+  </article>
+</template>
diff --git a/src/components/analytics/RevenueChart.vue b/src/components/analytics/RevenueChart.vue
