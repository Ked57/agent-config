index 0000000..1038895
--- /dev/null
+++ b/src/components/analytics/RevenueChart.vue
@@ -0,0 +1,85 @@
+<script setup lang="ts">
+import { computed } from 'vue'
+import type { RevenuePoint } from '@/services/analytics'
+
+const props = defineProps<{ points: RevenuePoint[]; rangeLabel: string }>()
+
+const WIDTH = 720
+const HEIGHT = 260
+const PAD = { top: 12, right: 8, bottom: 28, left: 52 }
+const plotWidth = WIDTH - PAD.left - PAD.right
+const plotHeight = HEIGHT - PAD.top - PAD.bottom
+
+const money = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(value)
+const compact = (value: number) => `$${value >= 1000 ? `${Math.round(value / 100) / 10}k` : value}`
+
+const scale = computed(() => {
+  const max = Math.max(...props.points.map((point) => point.revenue))
+  // A round step (1, 2 or 5 × 10^n) giving at most five gridlines above zero.
+  const magnitude = Math.pow(10, Math.floor(Math.log10(max / 5)))
+  const step = [1, 2, 5, 10].map((factor) => factor * magnitude).find((candidate) => candidate * 5 >= max) ?? magnitude * 10
+  const top = Math.ceil(max / step) * step
+  return { top, ticks: Array.from({ length: Math.round(top / step) + 1 }, (_, index) => index * step) }
+})
+
+const coords = computed(() => {
+  const step = plotWidth / Math.max(props.points.length - 1, 1)
+  return props.points.map((point, index) => ({
+    x: PAD.left + index * step,
+    y: PAD.top + plotHeight - (point.revenue / scale.value.top) * plotHeight,
+    label: point.label,
+  }))
+})
+
+const line = computed(() => coords.value.map((point, index) => `${index === 0 ? 'M' : 'L'}${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(' '))
+const area = computed(() => {
+  const first = coords.value[0]
+  const last = coords.value[coords.value.length - 1]
+  if (!first || !last) return ''
+  const base = PAD.top + plotHeight
+  return `${line.value} L${last.x.toFixed(1)},${base} L${first.x.toFixed(1)},${base} Z`
+})
+
+const xLabels = computed(() => {
+  const every = Math.ceil(coords.value.length / 7)
+  return coords.value.filter((_, index) => index % every === 0)
+})
+
+const total = computed(() => props.points.reduce((sum, point) => sum + point.revenue, 0))
+const yFor = (value: number) => PAD.top + plotHeight - (value / scale.value.top) * plotHeight
+</script>
+
+<template>
+  <section class="flex flex-col gap-4 rounded-xl border border-surface-200 bg-surface-0 p-5">
+    <header class="flex flex-wrap items-start justify-between gap-2">
+      <div>
+        <h2 class="text-base font-semibold text-surface-900">Revenue over time</h2>
+        <p class="text-sm text-surface-500">{{ rangeLabel }} · {{ money(total) }} total</p>
+      </div>
+      <span class="flex items-center gap-2 text-sm text-surface-600">
+        <span class="inline-block size-2.5 rounded-full bg-primary"></span>
+        Revenue
+      </span>
+    </header>
+    <svg
+      :viewBox="`0 0 ${WIDTH} ${HEIGHT}`"
+      class="h-auto w-full"
+      role="img"
+      :aria-label="`Revenue chart, ${rangeLabel.toLowerCase()}, ${money(total)} total`"
+    >
+      <defs>
+        <linearGradient id="revenue-fill" x1="0" x2="0" y1="0" y2="1">
+          <stop offset="0%" stop-color="var(--p-primary-500)" stop-opacity="0.22" />
+          <stop offset="100%" stop-color="var(--p-primary-500)" stop-opacity="0" />
+        </linearGradient>
+      </defs>
+      <g v-for="tick in scale.ticks" :key="tick">
+        <line :x1="PAD.left" :x2="WIDTH - PAD.right" :y1="yFor(tick)" :y2="yFor(tick)" class="stroke-surface-200" stroke-width="1" />
+        <text :x="PAD.left - 10" :y="yFor(tick) + 4" text-anchor="end" class="fill-surface-500 text-[11px]">{{ compact(tick) }}</text>
+      </g>
+      <path :d="area" fill="url(#revenue-fill)" />
+      <path :d="line" fill="none" stroke="var(--p-primary-500)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
+      <text v-for="point in xLabels" :key="point.label" :x="point.x" :y="HEIGHT - 8" text-anchor="middle" class="fill-surface-500 text-[11px]">{{ point.label }}</text>
+    </svg>
+  </section>
+</template>
