diff -ruN a/src/utils/colorScheme.test.ts b/src/utils/colorScheme.test.ts
--- /dev/null
+++ b/src/utils/colorScheme.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest'
+import { parseStoredColorScheme, resolveColorScheme, toggledOverride } from './colorScheme'
+
+describe('parseStoredColorScheme', () => {
+  it('accepts light and dark', () => {
+    expect(parseStoredColorScheme('light')).toBe('light')
+    expect(parseStoredColorScheme('dark')).toBe('dark')
+  })
+
+  it('treats missing or unsupported values as no override', () => {
+    expect(parseStoredColorScheme(null)).toBeNull()
+    expect(parseStoredColorScheme('')).toBeNull()
+    expect(parseStoredColorScheme('light dark')).toBeNull()
+    expect(parseStoredColorScheme('DARK')).toBeNull()
+  })
+})
+
+describe('resolveColorScheme', () => {
+  it('follows the system when there is no override', () => {
+    expect(resolveColorScheme(null, 'dark')).toBe('dark')
+    expect(resolveColorScheme(null, 'light')).toBe('light')
+  })
+
+  it('keeps an override even when the system later matches or differs', () => {
+    expect(resolveColorScheme('dark', 'dark')).toBe('dark')
+    expect(resolveColorScheme('dark', 'light')).toBe('dark')
+  })
+})
+
+describe('toggledOverride', () => {
+  it('stores the opposite of the system scheme', () => {
+    expect(toggledOverride(null, 'light')).toBe('dark')
+    expect(toggledOverride(null, 'dark')).toBe('light')
+  })
+
+  it('clears the override when toggling back to the system scheme', () => {
+    expect(toggledOverride('dark', 'light')).toBeNull()
+    expect(toggledOverride('light', 'dark')).toBeNull()
+  })
+
+  it('flips what is rendered when the system has since changed to match the override', () => {
+    // Stored dark, OS switched to dark: rendered dark, so the user wants light.
+    expect(toggledOverride('dark', 'dark')).toBe('light')
+  })
+})
diff -ruN a/src/utils/colorScheme.ts b/src/utils/colorScheme.ts
--- /dev/null
+++ b/src/utils/colorScheme.ts
@@ -0,0 +1,24 @@
+export type ColorScheme = 'light' | 'dark'
+
+/** Key shared with the pre-paint inline script in index.html. */
+export const COLOR_SCHEME_STORAGE_KEY = 'color-scheme'
+
+/** `<meta name="color-scheme">` content when no override is stored: follow the system. */
+export const SYSTEM_META_CONTENT = 'light dark'
+
+export function parseStoredColorScheme(value: string | null): ColorScheme | null {
+  return value === 'light' || value === 'dark' ? value : null
+}
+
+export function resolveColorScheme(override: ColorScheme | null, system: ColorScheme): ColorScheme {
+  return override ?? system
+}
+
+/**
+ * Flip the rendered scheme. Landing back on the system scheme clears the override
+ * instead of storing it, so the user isn't silently pinned against future OS changes.
+ */
+export function toggledOverride(override: ColorScheme | null, system: ColorScheme): ColorScheme | null {
+  const target: ColorScheme = resolveColorScheme(override, system) === 'dark' ? 'light' : 'dark'
+  return target === system ? null : target
+}
