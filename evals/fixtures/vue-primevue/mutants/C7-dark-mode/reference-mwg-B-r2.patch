diff -ruN a/src/composables/useColorScheme.ts b/src/composables/useColorScheme.ts
--- /dev/null
+++ b/src/composables/useColorScheme.ts
@@ -0,0 +1,68 @@
+import { computed, onScopeDispose, ref } from 'vue'
+import {
+  COLOR_SCHEME_STORAGE_KEY,
+  SYSTEM_META_CONTENT,
+  parseStoredColorScheme,
+  resolveColorScheme,
+  toggledOverride,
+  type ColorScheme,
+} from '@/utils/colorScheme'
+
+const SYSTEM_DARK_QUERY = '(prefers-color-scheme: dark)'
+
+// localStorage can throw when site data is blocked; the scheme still applies to this page.
+function readOverride(): ColorScheme | null {
+  try {
+    return parseStoredColorScheme(localStorage.getItem(COLOR_SCHEME_STORAGE_KEY))
+  } catch {
+    return null
+  }
+}
+
+function writeOverride(override: ColorScheme | null) {
+  try {
+    if (override) localStorage.setItem(COLOR_SCHEME_STORAGE_KEY, override)
+    else localStorage.removeItem(COLOR_SCHEME_STORAGE_KEY)
+  } catch {
+    // Not persisted; see readOverride.
+  }
+}
+
+// The <meta name="color-scheme"> drives both the PrimeVue dark tokens and Tailwind's `dark:` variant.
+function applyOverride(override: ColorScheme | null) {
+  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')
+  if (meta) meta.content = override ?? SYSTEM_META_CONTENT
+}
+
+export function useColorScheme() {
+  const media = window.matchMedia(SYSTEM_DARK_QUERY)
+  const system = ref<ColorScheme>(media.matches ? 'dark' : 'light')
+  const override = ref(readOverride())
+  const scheme = computed(() => resolveColorScheme(override.value, system.value))
+
+  function onSystemChange(event: MediaQueryListEvent) {
+    system.value = event.matches ? 'dark' : 'light'
+  }
+
+  // Keep in sync with a choice made in another tab (key is null when storage is cleared).
+  function onStorage(event: StorageEvent) {
+    if (event.key !== null && event.key !== COLOR_SCHEME_STORAGE_KEY) return
+    override.value = readOverride()
+    applyOverride(override.value)
+  }
+
+  media.addEventListener('change', onSystemChange)
+  window.addEventListener('storage', onStorage)
+  onScopeDispose(() => {
+    media.removeEventListener('change', onSystemChange)
+    window.removeEventListener('storage', onStorage)
+  })
+
+  function toggle() {
+    override.value = toggledOverride(override.value, system.value)
+    writeOverride(override.value)
+    applyOverride(override.value)
+  }
+
+  return { scheme, toggle }
+}
