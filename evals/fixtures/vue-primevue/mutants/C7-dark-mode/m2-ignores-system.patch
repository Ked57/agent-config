diff -ruN a/src/stores/theme.ts b/src/stores/theme.ts
--- /dev/null
+++ b/src/stores/theme.ts
@@ -0,0 +1,35 @@
+import { defineStore } from 'pinia'
+import { computed, ref, watchEffect } from 'vue'
+import {
+  COLOR_SCHEME_STORAGE_KEY,
+  DARK_MODE_CLASS,
+  parseColorScheme,
+  resolveColorScheme,
+  type ColorScheme,
+} from '@/utils/theme'
+
+export const useThemeStore = defineStore('theme', () => {
+  const systemQuery = window.matchMedia('(prefers-color-scheme: dark)')
+  const systemPrefersDark = ref(systemQuery.matches)
+  // null means no explicit choice yet, so the system setting keeps applying live.
+  const stored = ref<ColorScheme | null>(parseColorScheme(localStorage.getItem(COLOR_SCHEME_STORAGE_KEY)))
+
+  // The store lives for the whole app, so this listener is never removed.
+  systemQuery.addEventListener('change', (event) => {
+    systemPrefersDark.value = event.matches
+  })
+
+  const colorScheme = computed(() => resolveColorScheme(stored.value, systemPrefersDark.value))
+  const isDark = computed(() => colorScheme.value === 'dark')
+
+  watchEffect(() => {
+    document.documentElement.classList.toggle(DARK_MODE_CLASS, isDark.value)
+  })
+
+  function toggle() {
+    stored.value = isDark.value ? 'light' : 'dark'
+    localStorage.setItem(COLOR_SCHEME_STORAGE_KEY, stored.value)
+  }
+
+  return { colorScheme, isDark, toggle }
+})
