diff -ruN a/src/utils/theme.ts b/src/utils/theme.ts
--- /dev/null
+++ b/src/utils/theme.ts
@@ -0,0 +1,13 @@
+export type ColorScheme = 'light' | 'dark'
+
+// Also read by the inline script in index.html, which applies the class before first paint.
+export const COLOR_SCHEME_STORAGE_KEY = 'acme-color-scheme'
+export const DARK_MODE_CLASS = 'app-dark'
+
+export function parseColorScheme(value: string | null): ColorScheme | null {
+  return value === 'light' || value === 'dark' ? value : null
+}
+
+export function resolveColorScheme(stored: ColorScheme | null, _systemPrefersDark: boolean): ColorScheme {
+  return stored ?? 'light'
+}
