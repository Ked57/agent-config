+import { describe, expect, it } from 'vitest'
+import { parseOrderQuery } from './orderQuery'
+
+describe('parseOrderQuery', () => {
+  it('parses status, a total bound, and free text together', () => {
+    expect(parseOrderQuery('status:paid total>100 northwind')).toEqual({
+      status: 'paid',
+      minTotal: { value: 100, inclusive: false },
+      terms: ['northwind'],
+    })
+  })
+
+  it('returns no filters for empty or whitespace-only input', () => {
+    expect(parseOrderQuery('')).toEqual({ terms: [] })
+    expect(parseOrderQuery('   \t\n ')).toEqual({ terms: [] })
+  })
+
+  it('splits free text on any run of whitespace', () => {
+    expect(parseOrderQuery('  acme \t corp\n')).toEqual({ terms: ['acme', 'corp'] })
+  })
+
+  it('accepts every order status case-insensitively', () => {
+    expect(parseOrderQuery('status:pending').status).toBe('pending')
+    expect(parseOrderQuery('status:shipped').status).toBe('shipped')
+    expect(parseOrderQuery('STATUS:Refunded').status).toBe('refunded')
+  })
+
+  it('keeps an unknown or empty status as free text', () => {
+    expect(parseOrderQuery('status:lost')).toEqual({ terms: ['status:lost'] })
+    expect(parseOrderQuery('status:')).toEqual({ terms: ['status:'] })
+  })
+
+  it('does not treat inherited object keys as statuses', () => {
+    expect(parseOrderQuery('status:constructor')).toEqual({ terms: ['status:constructor'] })
+  })
+
+  it('parses exclusive and inclusive total bounds', () => {
+    expect(parseOrderQuery('total>=50 total<200')).toEqual({
+      minTotal: { value: 50, inclusive: true },
+      maxTotal: { value: 200, inclusive: false },
+      terms: [],
+    })
+    expect(parseOrderQuery('total<=75.5').maxTotal).toEqual({ value: 75.5, inclusive: true })
+  })
+
+  it('treats total= and total: as an exact total', () => {
+    const exact = { minTotal: { value: 42, inclusive: true }, maxTotal: { value: 42, inclusive: true }, terms: [] }
+    expect(parseOrderQuery('total=42')).toEqual(exact)
+    expect(parseOrderQuery('TOTAL:42')).toEqual(exact)
+  })
+
+  it('keeps malformed totals as free text', () => {
+    expect(parseOrderQuery('total>abc total> total>-5 total>1e3 total>1. total>>5')).toEqual({
+      terms: ['total>abc', 'total>', 'total>-5', 'total>1e3', 'total>1.', 'total>>5'],
+    })
+  })
+
+  it('lets a later qualifier override an earlier one', () => {
+    expect(parseOrderQuery('status:paid total>10 status:pending total>20')).toEqual({
+      status: 'pending',
+      minTotal: { value: 20, inclusive: false },
+      terms: [],
+    })
+  })
+
+  it('does not treat qualifiers inside larger words as filters', () => {
+    expect(parseOrderQuery('substatus:paid grandtotal>5')).toEqual({ terms: ['substatus:paid', 'grandtotal>5'] })
+  })
+
+  it('preserves the casing of free-text terms', () => {
+    expect(parseOrderQuery('Northwind Traders').terms).toEqual(['Northwind', 'Traders'])
+  })
+})
