@@ -0,0 +1,70 @@
+import type { OrderStatus } from '@/types'
+
+export interface TotalBound {
+  value: number
+  inclusive: boolean
+}
+
+export interface OrderQuery {
+  status?: OrderStatus
+  minTotal?: TotalBound
+  maxTotal?: TotalBound
+  terms: string[]
+}
+
+// A Record keyed by OrderStatus forces this list to stay in sync when a status is added.
+const ORDER_STATUSES: Record<OrderStatus, true> = { pending: true, paid: true, shipped: true, refunded: true }
+
+const STATUS_TOKEN = /^status:(.+)$/i
+const TOTAL_TOKEN = /^total(>=|<=|>|<|=|:)(\d+(?:\.\d+)?)$/i
+
+function isOrderStatus(value: string): value is OrderStatus {
+  return Object.hasOwn(ORDER_STATUSES, value)
+}
+
+function applyTotal(query: OrderQuery, operator: string, value: number): void {
+  switch (operator) {
+    case '>':
+    case '>=':
+      query.minTotal = { value, inclusive: operator === '>=' }
+      break
+    case '<':
+    case '<=':
+      query.maxTotal = { value, inclusive: operator === '<=' }
+      break
+    default:
+      // '=' and ':' both mean an exact total.
+      query.minTotal = { value, inclusive: true }
+      query.maxTotal = { value, inclusive: true }
+  }
+}
+
+/**
+ * Parses an order search string such as `status:paid total>100 northwind`.
+ *
+ * Keys are case-insensitive. A repeated qualifier overrides the earlier one.
+ * Tokens that look like qualifiers but carry an unknown status or a non-numeric
+ * total are kept as free-text terms rather than silently dropped.
+ */
+export function parseOrderQuery(query: string): OrderQuery {
+  const result: OrderQuery = { terms: [] }
+
+  for (const token of query.split(/\s+/).filter(Boolean)) {
+    const statusMatch = STATUS_TOKEN.exec(token)
+    const status = statusMatch?.[1]?.toLowerCase()
+    if (status !== undefined && isOrderStatus(status)) {
+      result.status = status
+      continue
+    }
+
+    const totalMatch = TOTAL_TOKEN.exec(token)
+    if (totalMatch?.[1] !== undefined && totalMatch[2] !== undefined) {
+      applyTotal(result, totalMatch[1], Number(totalMatch[2]))
+      continue
+    }
+
+    result.terms.push(token)
+  }
+
+  return result
+}
