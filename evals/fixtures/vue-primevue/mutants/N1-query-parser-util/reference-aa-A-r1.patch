+import { describe, expect, it } from 'vitest'
+import { parseOrderQuery } from './orderQuery'
+
+describe('parseOrderQuery', () => {
+  it('parses status, total and free text together', () => {
+    expect(parseOrderQuery('status:paid total>100 northwind')).toEqual({
+      status: 'paid',
+      minTotal: { value: 100, inclusive: false },
+      terms: ['northwind'],
+    })
+  })
+
+  it('returns only empty terms for blank input', () => {
+    expect(parseOrderQuery('')).toEqual({ terms: [] })
+    expect(parseOrderQuery('   \t\n ')).toEqual({ terms: [] })
+  })
+
+  it('accepts every order status, case-insensitively', () => {
+    expect(parseOrderQuery('status:pending').status).toBe('pending')
+    expect(parseOrderQuery('status:shipped').status).toBe('shipped')
+    expect(parseOrderQuery('Status:REFUNDED').status).toBe('refunded')
+  })
+
+  it('keeps unknown or empty statuses as free text', () => {
+    expect(parseOrderQuery('status:lost status:')).toEqual({ terms: ['status:lost', 'status:'] })
+  })
+
+  it('parses each total operator into the right bound', () => {
+    expect(parseOrderQuery('total>=50')).toEqual({ minTotal: { value: 50, inclusive: true }, terms: [] })
+    expect(parseOrderQuery('total<20')).toEqual({ maxTotal: { value: 20, inclusive: false }, terms: [] })
+    expect(parseOrderQuery('total<=20')).toEqual({ maxTotal: { value: 20, inclusive: true }, terms: [] })
+    expect(parseOrderQuery('TOTAL=75')).toEqual({
+      minTotal: { value: 75, inclusive: true },
+      maxTotal: { value: 75, inclusive: true },
+      terms: [],
+    })
+  })
+
+  it('combines lower and upper bounds into a range', () => {
+    expect(parseOrderQuery('total>10 total<=99.5')).toEqual({
+      minTotal: { value: 10, inclusive: false },
+      maxTotal: { value: 99.5, inclusive: true },
+      terms: [],
+    })
+  })
+
+  it('keeps malformed totals as free text', () => {
+    expect(parseOrderQuery('total>abc total> total>-5 total>1e3 total>0x10 total>>5 total:100').terms).toEqual([
+      'total>abc',
+      'total>',
+      'total>-5',
+      'total>1e3',
+      'total>0x10',
+      'total>>5',
+      'total:100',
+    ])
+  })
+
+  it('lets the last repeated filter win', () => {
+    expect(parseOrderQuery('status:paid status:shipped total>5 total>10')).toEqual({
+      status: 'shipped',
+      minTotal: { value: 10, inclusive: false },
+      terms: [],
+    })
+  })
+
+  it('collects multiple free-text terms in order, preserving case', () => {
+    expect(parseOrderQuery('  Northwind   Traders  ').terms).toEqual(['Northwind', 'Traders'])
+  })
+
+  it('treats quoted phrases as single free-text terms, even if they look like filters', () => {
+    expect(parseOrderQuery('"north wind" "status:paid" status:paid')).toEqual({
+      status: 'paid',
+      terms: ['north wind', 'status:paid'],
+    })
+  })
+
+  it('runs an unterminated quote to the end and drops empty quotes', () => {
+    expect(parseOrderQuery('"" acme "north wind').terms).toEqual(['acme', 'north wind'])
+  })
+})
