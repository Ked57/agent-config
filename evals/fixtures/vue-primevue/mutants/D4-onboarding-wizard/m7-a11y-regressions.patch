+<script setup lang="ts">
+import RadioButton from 'primevue/radiobutton'
+import type { UseCase } from '@/services/onboarding'
+
+defineProps<{ options: UseCase[]; invalid: boolean }>()
+const selected = defineModel<UseCase['id'] | null>({ required: true })
+
+const icons: Record<UseCase['id'], string> = {
+  clients: 'pi pi-briefcase',
+  operations: 'pi pi-cog',
+  product: 'pi pi-code',
+  other: 'pi pi-ellipsis-h',
+}
+</script>
+
+<template>
+  <div class="grid gap-3 sm:grid-cols-2">
+    <div
+      v-for="option in options"
+      :key="option.id"
+      class="relative flex cursor-pointer gap-4 rounded-xl border p-4 pr-12 transition-colors"
+      :class="selected === option.id
+        ? 'border-primary-600 bg-primary-50 ring-1 ring-primary-600'
+        : invalid ? 'border-red-300 bg-surface-0 hover:border-red-400' : 'border-surface-200 bg-surface-0 hover:border-surface-300'"
+    >
+      <span
+        class="flex size-10 shrink-0 items-center justify-center rounded-lg"
+        :class="selected === option.id ? 'bg-primary-600 text-white' : 'bg-surface-100 text-surface-600'"
+        aria-hidden="true"
+      >
+        <i :class="icons[option.id]"></i>
+      </span>
+      <span class="flex min-w-0 flex-col gap-1">
+        <span class="text-sm font-semibold text-surface-900">{{ option.label }}</span>
+        <span class="text-sm leading-5 text-surface-300">{{ option.description }}</span>
+      </span>
+      <RadioButton v-model="selected" :value="option.id" name="use-case" class="!absolute right-4 top-4" />
+    </div>
+  </div>
+</template>
diff --git a/src/components/onboarding/WizardStepper.vue b/src/components/onboarding/WizardStepper.vue
new file mode 100644
index 0000000..eea37b3
--- /dev/null
+++ b/src/components/onboarding/WizardStepper.vue
@@ -0,0 +1,42 @@
+<script setup lang="ts">
+import type { WizardStep } from '@/services/onboarding'
+
+defineProps<{ steps: WizardStep[]; current: number }>()
+</script>
+
+<template>
+  <nav aria-label="Setup progress">
+    <ol class="flex items-center">
+      <li v-for="(step, index) in steps" :key="step.id" class="flex items-center" :class="{ 'flex-1': index < steps.length - 1 }">
+        <div class="flex items-center gap-3" :aria-current="index === current ? 'step' : undefined">
+          <span
+            class="flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-semibold tabular-nums"
+            :class="index < current
+              ? 'bg-primary-600 text-white'
+              : index === current
+                ? 'border-2 border-primary-600 bg-surface-0 text-primary-700 ring-4 ring-primary-100'
+                : 'border border-surface-300 bg-surface-0 text-surface-500'"
+          >
+            <i v-if="index < current" class="pi pi-check text-xs" aria-hidden="true"></i>
+            <template v-else>{{ index + 1 }}</template>
+          </span>
+          <span
+            class="text-sm"
+            :class="[
+              index < current ? 'font-medium text-surface-900' : index === current ? 'font-semibold text-primary-700' : 'text-surface-500',
+              index === current ? '' : 'sr-only sm:not-sr-only',
+            ]"
+          >
+            {{ step.label }}<span v-if="index < current" class="sr-only"> (done)</span>
+          </span>
+        </div>
+        <span
+          v-if="index < steps.length - 1"
+          class="mx-3 h-0.5 flex-1 rounded-full sm:mx-4"
+          :class="index < current ? 'bg-primary-600' : 'bg-surface-200'"
+          aria-hidden="true"
+        ></span>
+      </li>
+    </ol>
+  </nav>
+</template>
