diff --git a/src/views/OnboardingView.vue b/src/views/OnboardingView.vue
new file mode 100644
index 0000000..26e47cf
--- /dev/null
+++ b/src/views/OnboardingView.vue
@@ -0,0 +1,143 @@
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import Button from 'primevue/button'
+import InputText from 'primevue/inputtext'
+import Select from 'primevue/select'
+import SelectButton from 'primevue/selectbutton'
+import UseCaseCards from '@/components/onboarding/UseCaseCards.vue'
+import WizardStepper from '@/components/onboarding/WizardStepper.vue'
+import { fetchOnboarding, sendInvites, submitWorkspace, type InviteRole, type Onboarding, type UseCase } from '@/services/onboarding'
+
+const data = ref<Onboarding | null>(null)
+const step = ref(1)
+const workspaceName = ref('')
+const useCase = ref<UseCase['id'] | null>(null)
+const teamSize = ref('2–10')
+const inviteEmail = ref('')
+const inviteRole = ref<InviteRole>('Member')
+const useCaseError = ref('')
+const emailError = ref('')
+
+void fetchOnboarding().then((result) => {
+  data.value = result
+  step.value = result.currentStep
+  workspaceName.value = result.workspaceName
+})
+
+const stepLabel = computed(() => (data.value ? `Step ${step.value + 1} of ${data.value.steps.length}` : ''))
+const chosen = computed(() => data.value?.useCases.find((option) => option.id === useCase.value) ?? null)
+
+async function continueFromWorkspace() {
+  if (!useCase.value) {
+    useCaseError.value = 'Choose what you’ll use Acme Console for.'
+    return
+  }
+  useCaseError.value = ''
+  await submitWorkspace({ name: workspaceName.value, useCase: useCase.value, teamSize: teamSize.value })
+  step.value = 2
+}
+
+async function invite() {
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(inviteEmail.value.trim())) {
+    emailError.value = 'Enter a valid email address, like name@company.com.'
+    return
+  }
+  emailError.value = ''
+  await sendInvites([{ email: inviteEmail.value.trim(), role: inviteRole.value }])
+  step.value = 3
+}
+
+function chooseUseCase(value: UseCase['id'] | null) {
+  useCase.value = value
+  useCaseError.value = ''
+}
+</script>
+
+<template>
+  <div v-if="data" class="mx-auto flex max-w-3xl flex-col gap-8">
+    <header>
+      <p class="text-sm font-medium text-primary-700">{{ stepLabel }}</p>
+      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-surface-900">Set up your workspace</h1>
+      <p class="mt-1 text-sm text-surface-300">It takes about two minutes. You can change everything later in Settings.</p>
+    </header>
+
+    <WizardStepper :steps="data.steps" :current="step" />
+
+    <div class="rounded-2xl border border-surface-200 bg-surface-0 shadow-sm">
+      <form v-if="step === 1" class="flex flex-col gap-8 p-5 sm:p-8" novalidate @submit.prevent="continueFromWorkspace">
+        <div>
+          <h2 class="text-lg font-semibold text-surface-900">Tell us about your workspace</h2>
+          <p class="mt-1 text-sm text-surface-300">We use this to set up templates and defaults for your team.</p>
+        </div>
+        <div class="flex flex-col gap-1.5">
+          <label for="workspace-name" class="text-sm font-medium text-surface-700">Workspace name</label>
+          <InputText id="workspace-name" v-model="workspaceName" class="sm:max-w-sm" />
+          <small class="text-sm text-surface-500">Shown in the sidebar and on invoices.</small>
+        </div>
+        <fieldset class="flex flex-col gap-3">
+          <legend class="mb-3 text-sm font-medium text-surface-700">What will you use Acme Console for?</legend>
+          <UseCaseCards :model-value="useCase" :options="data.useCases" :invalid="!!useCaseError" @update:model-value="chooseUseCase" />
+          <small v-if="useCaseError" class="flex items-center gap-1.5 text-sm text-red-600">
+            <i class="pi pi-exclamation-circle" aria-hidden="true"></i>{{ useCaseError }}
+          </small>
+          <small v-else-if="chosen" class="flex items-center gap-1.5 text-sm text-primary-700">
+            <i class="pi pi-sparkles" aria-hidden="true"></i>We’ll add starter templates for {{ chosen.label.toLowerCase() }}.
+          </small>
+          <small v-else class="text-sm text-surface-500">Pick the closest one. It only changes the templates you start with.</small>
+        </fieldset>
+        <div class="flex flex-col gap-2">
+          <span id="team-size-label" class="text-sm font-medium text-surface-700">Team size</span>
+          <SelectButton v-model="teamSize" :options="data.teamSizes" :allow-empty="false" aria-labelledby="team-size-label" class="self-start [&_.p-togglebutton]:!text-surface-700" />
+        </div>
+      </form>
+
+      <form v-else-if="step === 2" class="flex flex-col gap-8 p-5 sm:p-8" novalidate @submit.prevent="invite">
+        <div>
+          <h2 class="text-lg font-semibold text-surface-900">Invite your team</h2>
+          <p class="mt-1 text-sm text-surface-300">Teammates get an email with a link to join the {{ workspaceName }} workspace.</p>
+        </div>
+        <div class="grid gap-4 sm:grid-cols-[1fr_10rem]">
+          <div class="flex flex-col gap-1.5">
+            <label for="invite-email" class="text-sm font-medium text-surface-700">Email address</label>
+            <InputText id="invite-email" v-model="inviteEmail" type="email" placeholder="name@company.com" :invalid="!!emailError" />
+            <small v-if="emailError" class="flex items-center gap-1.5 text-sm text-red-600">
+              <i class="pi pi-exclamation-circle" aria-hidden="true"></i>{{ emailError }}
+            </small>
+          </div>
+          <div class="flex flex-col gap-1.5">
+            <span id="invite-role-label" class="text-sm font-medium text-surface-700">Role</span>
+            <Select v-model="inviteRole" :options="data.inviteRoles" aria-labelledby="invite-role-label" />
+          </div>
+        </div>
+        <p class="flex items-center gap-2 rounded-lg bg-surface-50 px-4 py-3 text-sm text-surface-600">
+          <i class="pi pi-info-circle text-surface-500" aria-hidden="true"></i>
+          You can invite more people and change roles from Settings later.
+        </p>
+      </form>
+
+      <div v-else class="flex flex-col items-center gap-3 p-8 text-center sm:p-12">
+        <span class="flex size-12 items-center justify-center rounded-full bg-primary-100 text-primary-700" aria-hidden="true">
+          <i class="pi pi-check text-lg"></i>
+        </span>
+        <h2 class="text-lg font-semibold text-surface-900">Start your trial</h2>
+        <p class="max-w-sm text-sm text-surface-500">Your {{ data.trialDays }}-day Growth trial starts today. No card needed until it ends.</p>
+      </div>
+
+      <div class="sticky bottom-0 flex items-center gap-3 rounded-b-2xl border-t border-surface-200 bg-surface-0 px-5 py-4 sm:px-8">
+        <template v-if="step === 1">
+          <p class="hidden flex-1 text-sm text-surface-500 sm:block">Next: invite your team</p>
+          <Button label="Continue" icon="pi pi-arrow-right" icon-pos="right" class="ml-auto max-sm:flex-1 !border-primary-700 !bg-primary-700" @click="continueFromWorkspace" />
+        </template>
+        <template v-else-if="step === 2">
+          <Button label="Back" icon="pi pi-arrow-left" severity="secondary" text @click="step = 1" />
+          <Button label="Skip for now" severity="secondary" text class="ml-auto" @click="step = 3" />
+          <Button label="Send invites" icon="pi pi-send" class="!border-primary-700 !bg-primary-700" @click="invite" />
+        </template>
+        <template v-else>
+          <Button label="Back" icon="pi pi-arrow-left" severity="secondary" text @click="step = 2" />
+          <Button label="Finish setup" class="ml-auto !border-primary-700 !bg-primary-700" />
+        </template>
+      </div>
+    </div>
+  </div>
+</template>
