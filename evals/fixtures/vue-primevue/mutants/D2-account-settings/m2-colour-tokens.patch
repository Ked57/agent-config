+<script setup lang="ts">
+import Tag from 'primevue/tag'
+import ToggleSwitch from 'primevue/toggleswitch'
+import { channels, type NotificationEvent } from '@/services/account'
+
+const events = defineModel<NotificationEvent[]>({ required: true })
+</script>
+
+<template>
+  <div class="overflow-hidden rounded-xl border border-surface-200 bg-surface-0 shadow-sm">
+    <div class="hidden grid-cols-[1fr_repeat(3,5rem)] items-center border-b border-surface-200 bg-sky-50 px-6 py-3 sm:grid" aria-hidden="true">
+      <span class="text-xs font-medium uppercase tracking-wide text-surface-500">Event</span>
+      <span v-for="channel in channels" :key="channel.id" class="text-center text-xs font-medium uppercase tracking-wide text-surface-500">{{ channel.label }}</span>
+    </div>
+    <ul>
+      <li v-for="(event, index) in events" :key="event.id" class="px-6">
+        <div class="grid gap-3 py-4 sm:grid-cols-[1fr_repeat(3,5rem)] sm:items-center sm:gap-0" :class="{ 'border-t border-surface-100': index > 0 }">
+          <div class="min-w-0">
+            <p class="flex items-center gap-2 text-sm font-medium text-surface-900">
+              {{ event.label }}
+              <Tag v-if="event.required" value="Required" severity="secondary" class="!px-1.5 !py-0 !text-xs" />
+            </p>
+            <p class="truncate text-sm text-surface-500">{{ event.description }}</p>
+          </div>
+          <div class="flex gap-6 sm:contents">
+            <label v-for="channel in channels" :key="channel.id" class="flex items-center gap-2 sm:justify-center">
+              <ToggleSwitch
+                v-model="event.channels[channel.id]"
+                :disabled="event.required && channel.id === 'email'"
+                :aria-label="`${event.label}: ${channel.label}`"
+              />
+              <span class="text-sm text-surface-600 sm:sr-only">{{ channel.label }}</span>
+            </label>
+          </div>
+        </div>
+      </li>
+    </ul>
+  </div>
+</template>
