diff -ruN a/src/style.css b/src/style.css
--- a/src/style.css
+++ b/src/style.css
@@ -7,3 +7,25 @@
   @apply bg-surface-50 text-surface-900 antialiased;
   font-family: 'Inter', system-ui, sans-serif;
 }
+
+/* Route change: navigation happens many times a day, so keep it short and barely-there. */
+.page-enter-active {
+  transition:
+    opacity 180ms cubic-bezier(0.23, 1, 0.32, 1),
+    transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
+}
+
+.page-enter-from {
+  opacity: 0;
+  transform: translateY(4px);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .page-enter-active {
+    transition: opacity 180ms ease;
+  }
+
+  .page-enter-from {
+    transform: none;
+  }
+}
