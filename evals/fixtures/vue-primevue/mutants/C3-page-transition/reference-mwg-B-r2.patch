diff -ruN a/src/style.css b/src/style.css
--- a/src/style.css
+++ b/src/style.css
@@ -7,3 +7,28 @@
   @apply bg-surface-50 text-surface-900 antialiased;
   font-family: 'Inter', system-ui, sans-serif;
 }
+
+/*
+ * Route change: enter-only fade with a small lift. The old page leaves instantly
+ * (no leave classes) so navigation never waits on an exit animation.
+ */
+.page-enter-active {
+  transition:
+    opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
+    transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
+}
+
+.page-enter-from {
+  opacity: 0;
+  transform: translateY(4px);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .page-enter-active {
+    transition: opacity 200ms cubic-bezier(0.23, 1, 0.32, 1);
+  }
+
+  .page-enter-from {
+    transform: none;
+  }
+}
