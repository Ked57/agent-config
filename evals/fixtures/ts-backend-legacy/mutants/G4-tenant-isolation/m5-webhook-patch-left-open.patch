--- /dev/null
+++ b/src/sql/first.ts
@@ -0,0 +1,7 @@
+/**
+ * First row of a raw query, or undefined. Drizzle's `db.get` throws on libSQL
+ * when no row matches, which turned "not found" into a 500.
+ */
+export async function first<T>(rows: Promise<T[]>): Promise<T | undefined> {
+  return (await rows)[0];
+}
