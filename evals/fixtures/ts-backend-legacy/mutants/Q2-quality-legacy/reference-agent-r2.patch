+{
+  "version": 1,
+  "runtime": "bun",
+  "commands": {
+    "fast": "bun run verify:fast",
+    "full": "bun run verify:full",
+    "unit": "bun run test:unit",
+    "knip": "bun run knip",
+    "mutation": "bun run test:mutation:domain"
+  },
+  "routing": [
+    {
+      "match": ["**/*"],
+      "required": ["full"]
+    },
+    {
+      "match": ["src/**/*.ts", "scripts/**/*.ts", "drizzle/**"],
+      "required": ["unit", "fast"]
+    },
+    {
+      "match": [
+        "src/lib/legacy/dates.ts",
+        "src/lib/legacy/money.ts",
+        "src/lib/time.ts",
+        "src/lib/flags.ts",
+        "src/lib/ids.ts",
+        "src/lib/passwords.ts"
+      ],
+      "required": ["unit", "fast"],
+      "recommended": ["mutation"]
+    },
+    {
+      "match": [
+        "package.json",
+        "bun.lock",
+        "tsconfig.json",
+        "eslint.config.js",
+        "eslint-rules/**",
+        "eslint-suppressions.json",
+        "vitest.config.ts",
+        "coverage-baseline.json",
+        "knip.json",
+        "stryker.config.json",
+        "drizzle.config.ts"
+      ],
+      "required": ["full"]
+    }
+  ]
+}
