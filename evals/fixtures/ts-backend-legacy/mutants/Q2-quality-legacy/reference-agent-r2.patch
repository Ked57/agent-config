diff -ruN a/scripts/check-suppression-growth.ts b/scripts/check-suppression-growth.ts
--- /dev/null
+++ b/scripts/check-suppression-growth.ts
@@ -0,0 +1,108 @@
+import { execFileSync } from "node:child_process";
+import { readFileSync } from "node:fs";
+
+const BASELINE = "eslint-suppressions.json";
+const RENAME = /R\d*\0([^\0]+)\0([^\0]+)\0/g;
+
+type RuleCounts = Record<string, { count: number }>;
+type Suppressions = Record<string, RuleCounts>;
+
+function git(args: string[]): string {
+  return execFileSync("git", args, { encoding: "utf8" });
+}
+
+function gitSucceeds(args: string[]): boolean {
+  try {
+    execFileSync("git", args, { stdio: "ignore" });
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function countOf(entry: unknown): number {
+  const count = isRecord(entry) ? entry.count : undefined;
+  if (typeof count !== "number") throw new Error(`${BASELINE} is malformed`);
+  return count;
+}
+
+function parseRuleCounts(rules: unknown): RuleCounts {
+  if (!isRecord(rules)) throw new Error(`${BASELINE} is malformed`);
+  const counts: RuleCounts = {};
+  for (const [rule, entry] of Object.entries(rules)) {
+    counts[rule] = { count: countOf(entry) };
+  }
+  return counts;
+}
+
+export function parseSuppressions(text: string): Suppressions {
+  const parsed: unknown = JSON.parse(text);
+  if (!isRecord(parsed)) throw new Error(`${BASELINE} is not a file map`);
+  const suppressions: Suppressions = {};
+  for (const [file, rules] of Object.entries(parsed)) {
+    suppressions[file] = parseRuleCounts(rules);
+  }
+  return suppressions;
+}
+
+export function renamedFrom(nameStatusZ: string): Map<string, string> {
+  const renames = new Map<string, string>();
+  for (const [, from, to] of `${nameStatusZ}\0`.matchAll(RENAME)) {
+    if (from && to) renames.set(to, from);
+  }
+  return renames;
+}
+
+export function grownSuppressions(
+  base: Suppressions,
+  current: Suppressions,
+  renames: Map<string, string>,
+): string[] {
+  const grown: string[] = [];
+  for (const [file, rules] of Object.entries(current)) {
+    const baseRules = base[renames.get(file) ?? file] ?? {};
+    for (const [rule, { count }] of Object.entries(rules)) {
+      const baseCount = baseRules[rule]?.count ?? 0;
+      if (count > baseCount) {
+        grown.push(`${file}: ${rule} ${baseCount} -> ${count}`);
+      }
+    }
+  }
+  return grown;
+}
+
+function baselineAt(mergeBase: string): Suppressions | null {
+  if (!gitSucceeds(["cat-file", "-e", `${mergeBase}^{commit}`])) {
+    throw new Error(`cannot read merge-base commit ${mergeBase}`);
+  }
+  if (!gitSucceeds(["cat-file", "-e", `${mergeBase}:${BASELINE}`])) {
+    return null;
+  }
+  return parseSuppressions(git(["show", `${mergeBase}:${BASELINE}`]));
+}
+
+function main(target: string): number {
+  const mergeBase = git(["merge-base", "HEAD", target]).trim();
+  const base = baselineAt(mergeBase);
+  if (!base) {
+    console.log(`${BASELINE} is new in this change: adopting it as baseline`);
+    return 0;
+  }
+  const renames = renamedFrom(
+    git(["diff", "-z", "--name-status", "-M", mergeBase, "HEAD"]),
+  );
+  const current = parseSuppressions(readFileSync(BASELINE, "utf8"));
+  const grown = grownSuppressions(base, current, renames);
+  for (const line of grown) console.error(`suppression count grew: ${line}`);
+  return grown.length === 0 ? 0 : 1;
+}
+
+if (import.meta.main) {
+  const [target] = process.argv.slice(2);
+  if (!target) throw new Error("usage: check-suppression-growth.ts <target>");
+  process.exit(main(target));
+}
