diff -ruN a/scripts/check-disable-directives.ts b/scripts/check-disable-directives.ts
--- /dev/null
+++ b/scripts/check-disable-directives.ts
@@ -0,0 +1,53 @@
+import { globSync, readFileSync } from "node:fs";
+
+import { ESLint } from "eslint";
+
+const DIRECTIVE =
+  /(?:\/\/|\/\*|<!--)\s*eslint-disable(?:-next-line|-line)?(?=[\s*]|-->|$)(?<body>.*?)(?:\*\/|-->|$)/gm;
+const GUARD_PREFIX = "@eslint-community/eslint-comments/";
+
+function namedRules(body: string): string[] {
+  const [rules = ""] = body.split(/\s--\s/);
+  return rules
+    .split(",")
+    .map((rule) => rule.trim())
+    .filter((rule) => rule.length > 0);
+}
+
+export function findForbiddenDirectives(source: string): string[] {
+  const problems: string[] = [];
+  for (const match of source.matchAll(DIRECTIVE)) {
+    const rules = namedRules(match.groups?.body ?? "");
+    const line = source.slice(0, match.index).split("\n").length;
+    if (rules.length === 0) {
+      problems.push(`${line}: disable directive names no rule`);
+    }
+    for (const rule of rules.filter((name) => name.startsWith(GUARD_PREFIX))) {
+      problems.push(`${line}: disable directive names guard rule ${rule}`);
+    }
+  }
+  return problems;
+}
+
+async function lintedFiles(): Promise<string[]> {
+  const eslint = new ESLint();
+  const candidates = globSync("**/*.{ts,mts,cts,js,mjs,cjs}", {
+    exclude: (path) => path === "node_modules",
+  });
+  const linted: string[] = [];
+  for (const file of candidates) {
+    if (!(await eslint.isPathIgnored(file))) linted.push(file);
+  }
+  return linted;
+}
+
+if (import.meta.main) {
+  let failed = false;
+  for (const file of await lintedFiles()) {
+    for (const problem of findForbiddenDirectives(readFileSync(file, "utf8"))) {
+      console.error(`${file}:${problem}`);
+      failed = true;
+    }
+  }
+  if (failed) process.exit(1);
+}
