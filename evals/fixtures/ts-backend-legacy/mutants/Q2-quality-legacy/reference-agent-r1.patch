--- /dev/null
+++ b/scripts/ci/check-disable-directives.ts
@@ -0,0 +1,35 @@
+import { Glob } from "bun";
+
+const LINTED_FILES = new Glob("**/*.{ts,js,mjs}");
+const IGNORED_DIRS =
+  /^(node_modules|dist|drizzle|data|coverage|reports|\.stryker-tmp)\//;
+const DIRECTIVE =
+  /(?:\/\/|\/\*|<!--)\s*eslint-disable(?:-next-line|-line)?(?=[\s*]|-->|$)(.*?)(?:\*\/|-->|$)/gm;
+
+function forbiddenReason(ruleList: string): string | null {
+  const rules = ruleList.split(" -- ")[0]?.trim() ?? "";
+  if (rules.length === 0) return "names no rule";
+  if (rules.includes("eslint-comments"))
+    return "disables an eslint-comments guard";
+  return null;
+}
+
+const failures: string[] = [];
+for await (const path of LINTED_FILES.scan({ dot: true })) {
+  if (IGNORED_DIRS.test(path)) continue;
+  const text = await Bun.file(path).text();
+  for (const match of text.matchAll(DIRECTIVE)) {
+    const reason = forbiddenReason(match[1] ?? "");
+    if (!reason) continue;
+    const line = text.slice(0, match.index).split("\n").length;
+    failures.push(`${path}:${line} ${reason}: ${match[0].trim()}`);
+  }
+}
+
+if (failures.length > 0) {
+  console.error(
+    `Forbidden ESLint disable directives. Fix the code instead of disabling the gate:\n${failures.join("\n")}`,
+  );
+  process.exit(1);
+}
+console.log("No forbidden ESLint disable directives.");
diff -ruN a/scripts/ci/check-suppression-growth.ts b/scripts/ci/check-suppression-growth.ts
--- /dev/null
+++ b/scripts/ci/check-suppression-growth.ts
@@ -0,0 +1,63 @@
+import { $ } from "bun";
+
+const BASELINE = "eslint-suppressions.json";
+
+type Suppressions = Record<string, Record<string, { count: number }>>;
+
+const base = process.argv[2];
+if (!base) {
+  console.error(
+    "Usage: bun scripts/ci/check-suppression-growth.ts <merge-base-commit>",
+  );
+  process.exit(1);
+}
+
+const resolved = await $`git rev-parse --verify ${`${base}^{commit}`}`
+  .nothrow()
+  .quiet();
+if (resolved.exitCode !== 0) {
+  console.error(`Cannot read merge-base commit ${base}; refusing to pass.`);
+  process.exit(1);
+}
+
+const baseFile = await $`git show ${`${base}:${BASELINE}`}`.nothrow().quiet();
+if (baseFile.exitCode !== 0) {
+  console.log(
+    `${BASELINE} is new in this change; it becomes the adoption baseline.`,
+  );
+  process.exit(0);
+}
+
+const before = JSON.parse(baseFile.stdout.toString()) as Suppressions;
+const after = JSON.parse(await Bun.file(BASELINE).text()) as Suppressions;
+
+const renames = new Map<string, string>();
+const diff = await $`git diff --name-status -M -z ${`${base}...HEAD`}`.quiet();
+const fields = diff.stdout.toString().split("\0");
+for (let index = 0; index < fields.length; index += 1) {
+  const status = fields[index] ?? "";
+  if (status.startsWith("R")) {
+    renames.set(fields[index + 2] ?? "", fields[index + 1] ?? "");
+    index += 2;
+  } else if (status.length > 0) {
+    index += 1;
+  }
+}
+
+const grown: string[] = [];
+for (const [file, rules] of Object.entries(after)) {
+  const baseRules = before[renames.get(file) ?? file] ?? {};
+  for (const [rule, { count }] of Object.entries(rules)) {
+    const baseCount = baseRules[rule]?.count ?? 0;
+    if (count > baseCount)
+      grown.push(`${file} ${rule}: ${baseCount} -> ${count}`);
+  }
+}
+
+if (grown.length > 0) {
+  console.error(
+    `ESLint suppressions grew. Fix the new violations; only shrink the baseline with \`eslint --prune-suppressions\`:\n${grown.join("\n")}`,
+  );
+  process.exit(1);
+}
+console.log("No ESLint suppression count grew.");
