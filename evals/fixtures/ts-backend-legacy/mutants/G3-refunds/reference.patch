+/** Cents refunded on an invoice so far, as a positive number. */
+export async function refundedCents(db: Db, invoiceId: string) {
+  const row = await db
+    .select({
+      total: sql<number>`coalesce(sum(${ledgerEntries.amountCents}), 0)`,
+    })
+    .from(ledgerEntries)
+    .where(
+      and(
+        eq(ledgerEntries.invoiceId, invoiceId),
+        eq(ledgerEntries.kind, "refund"),
+      ),
+    )
+    .get();
+  return -Number(row?.total ?? 0);
+}
+
+/**
+ * Refunds part of what was paid on an invoice. One conditional INSERT decides
+ * and writes, so concurrent refunds cannot together exceed what was paid, and a
+ * repeated Idempotency-Key finds the entry the first request created.
+ * Returns undefined when the refund would exceed what is left.
+ */
+export async function refundInvoice(
+  db: Db,
+  invoice: { id: string; orgId: string },
+  amountCents: number,
+  reason: string,
+  key: string | null,
+) {
+  const id = newId("rfd");
+  await db.run(sql`
+    INSERT INTO ledger_entries (id, org_id, invoice_id, kind, amount_cents, memo, idempotency_key, created_at)
+    SELECT ${id}, ${invoice.orgId}, ${invoice.id}, 'refund', ${-amountCents}, ${reason}, ${key}, ${Date.now()}
+    WHERE (SELECT coalesce(sum(amount_cents), 0) FROM ledger_entries
+           WHERE invoice_id = ${invoice.id} AND kind IN ('payment', 'refund')) >= ${amountCents}
+    ON CONFLICT (org_id, idempotency_key) DO NOTHING`);
+  return db
+    .select()
+    .from(ledgerEntries)
+    .where(
+      key === null
+        ? eq(ledgerEntries.id, id)
+        : and(
+            eq(ledgerEntries.orgId, invoice.orgId),
+            eq(ledgerEntries.idempotencyKey, key),
+          ),
+    )
+    .get();
+}
