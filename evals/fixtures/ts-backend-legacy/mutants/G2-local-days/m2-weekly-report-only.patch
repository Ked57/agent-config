+/**
+ * Calendar day of a timestamp in a time zone. Time belongs to the day it was
+ * logged on for the person who logged it, so pass their time zone.
+ */
+export function dayKey(at: number | Date, timeZone = "UTC"): string {
   const ms = typeof at === "number" ? at : at.getTime();
-  return new Date(ms).toISOString().slice(0, 10);
+  if (timeZone === "UTC") return new Date(ms).toISOString().slice(0, 10);
+  return zonedDay(ms, timeZone);
+}
+
+/**
+ * A UTC window that contains every instant that is on `day` somewhere on
+ * earth (UTC-12 to UTC+14). Filter the rows by dayKey afterwards.
+ */
+export function dayWindow(firstDay: string, lastDay = firstDay) {
+  return {
+    from: dayStart(firstDay) - 14 * HOUR_MS,
+    to: dayStart(lastDay) + DAY_MS + 12 * HOUR_MS,
+  };
 }
 
