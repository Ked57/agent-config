+
+/** One row per time entry of an org in [from, to), ordered by person name (byte order) and start. */
+export async function timesheetEntries(
+  db: Db,
+  orgId: string,
+  from: number,
+  to: number,
+) {
+  return db
+    .select({
+      userId: users.id,
+      userName: users.name,
+      startedAt: timeEntries.startedAt,
+      minutes: timeEntries.minutes,
+      billable: timeEntries.billable,
+    })
+    .from(timeEntries)
+    .innerJoin(users, eq(users.id, timeEntries.userId))
+    .where(
+      and(
+        eq(timeEntries.orgId, orgId),
+        gte(timeEntries.startedAt, new Date(from)),
+        lt(timeEntries.startedAt, new Date(to)),
+      ),
+    )
+    .orderBy(asc(users.name), asc(timeEntries.startedAt));
+}
+
+/**
+ * Totals of one project. `exactAmountCents` is the unrounded sum of
+ * minutes × rate / 60 over billable entries (the person's rate, else the project's).
+ */
+export async function projectTotals(db: Db, orgId: string, projectId: string) {
+  const [row] = await db
+    .select({
+      id: projects.id,
+      name: projects.name,
+      totalMinutes: sql<number | null>`sum(${timeEntries.minutes})`,
+      billableMinutes: sql<
+        number | null
+      >`sum(case when ${timeEntries.billable} = 1 then ${timeEntries.minutes} else 0 end)`,
+      exactAmountCents: sql<
+        number | null
+      >`sum(case when ${timeEntries.billable} = 1
+        then ${timeEntries.minutes} * coalesce(${users.hourlyRateCents}, ${projects.hourlyRateCents}) / 60.0
+        else 0 end)`,
+      entries: sql<number>`count(${timeEntries.id})`,
+    })
+    .from(projects)
+    .leftJoin(timeEntries, eq(timeEntries.projectId, projects.id))
+    .leftJoin(users, eq(users.id, timeEntries.userId))
+    .where(and(eq(projects.id, projectId), eq(projects.orgId, orgId)))
+    .groupBy(projects.id);
+  return row;
+}
+
+/** Issued and paid invoices with what was paid on them, by due date then number. */
+export async function invoiceAging(db: Db, orgId: string) {
+  return db
+    .select({
+      number: invoices.number,
+      clientName: invoices.clientName,
+      status: invoices.status,
+      issueDate: invoices.issueDate,
+      dueDate: invoices.dueDate,
+      totalCents: invoices.totalCents,
+      paidCents: sql<number>`coalesce((select sum(l.amount_cents) from ledger_entries l
+        where l.invoice_id = "invoices"."id" and l.kind = 'payment'), 0)`,
+    })
+    .from(invoices)
+    .where(
+      and(
+        eq(invoices.orgId, orgId),
+        inArray(invoices.status, ["issued", "paid"]),
+      ),
+    )
+    .orderBy(asc(invoices.dueDate), asc(invoices.number));
+}
