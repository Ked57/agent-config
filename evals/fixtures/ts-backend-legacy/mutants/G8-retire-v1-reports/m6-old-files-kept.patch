diff -ruN a/src/routes/reports-v1.ts b/src/routes/reports-v1.ts
--- /dev/null
+++ b/src/routes/reports-v1.ts
@@ -0,0 +1,154 @@
+import { Elysia } from "elysia";
+
+import type { Db } from "../db/client";
+import {
+  addDays,
+  dayKey,
+  dayStart,
+  formatDay,
+  isValidDay,
+  weekStart,
+} from "../lib/legacy/dates";
+import { formatHours, fromCents } from "../lib/legacy/money";
+import { authGuard, type AuthUser } from "../plugins/auth";
+import { recordAudit } from "../services/audit";
+import {
+  invoiceAging,
+  projectTotals,
+  timesheetEntries,
+} from "../services/reports";
+
+/**
+ * Deprecated v1 report formats, served from the report service (spec #340).
+ * The old mobile app and the payroll provider parse these byte for byte:
+ * snake_case, DD/MM/YYYY UTC days, hours as two-decimal strings, people in
+ * byte order of their names, totals formatted once.
+ */
+
+export interface TimesheetV1 {
+  week_start: string;
+  rows: {
+    user_id: string;
+    user_name: string;
+    day: string;
+    hours: string;
+    billable_hours: string;
+  }[];
+  total_hours: string;
+}
+
+export async function timesheetV1(
+  db: Db,
+  orgId: string,
+  day: string,
+): Promise<TimesheetV1> {
+  const start = weekStart(day);
+  const entries = await timesheetEntries(
+    db,
+    orgId,
+    dayStart(start),
+    dayStart(addDays(start, 7)),
+  );
+  const rows = new Map<
+    string,
+    { userId: string; userName: string; day: string; m: number; b: number }
+  >();
+  let total = 0;
+  for (const entry of entries) {
+    const entryDay = dayKey(entry.startedAt);
+    const key = `${entry.userId}|${entryDay}`;
+    const row = rows.get(key) ?? {
+      userId: entry.userId,
+      userName: entry.userName,
+      day: entryDay,
+      m: 0,
+      b: 0,
+    };
+    row.m += entry.minutes;
+    if (entry.billable) row.b += entry.minutes;
+    rows.set(key, row);
+    total += entry.minutes;
+  }
+  return {
+    week_start: formatDay(start),
+    rows: [...rows.values()].map((row) => ({
+      user_id: row.userId,
+      user_name: row.userName,
+      day: formatDay(row.day),
+      hours: formatHours(row.m),
+      billable_hours: formatHours(row.b),
+    })),
+    total_hours: formatHours(total),
+  };
+}
+
+const auditView = (db: Db, user: AuthUser, report: string, entityId: string) =>
+  recordAudit(db, {
+    orgId: user.orgId,
+    actorId: user.id,
+    action: "report.v1_viewed",
+    entityType: "report",
+    entityId,
+    data: { report },
+  });
+
+export const reportsV1Routes = (db: Db) =>
+  new Elysia({ prefix: "/api/v1/reports" })
+    .use(authGuard(db))
+    .onAfterHandle(({ set }) => {
+      set.headers["deprecation"] = "true";
+    })
+    .get(
+      "/timesheet",
+      async ({ query, user, status }) => {
+        const week = query.week ?? dayKey(Date.now());
+        if (!isValidDay(week)) return status(400, { error: "bad week" });
+        const report = await timesheetV1(db, user.orgId, week);
+        await auditView(db, user, "timesheet", weekStart(week));
+        return report;
+      },
+      { requireAuth: true },
+    )
+    .get(
+      "/projects/:id/summary",
+      async ({ params, user, status }) => {
+        const row = await projectTotals(db, user.orgId, params.id);
+        if (!row) return status(404, { error: "project not found" });
+        await auditView(db, user, "project_summary", row.id);
+        return {
+          project_id: row.id,
+          project_name: row.name,
+          total_hours: formatHours(row.totalMinutes ?? 0),
+          billable_hours: formatHours(row.billableMinutes ?? 0),
+          amount: Math.round(row.exactAmountCents ?? 0) / 100,
+          entries: row.entries,
+        };
+      },
+      { requireAuth: true },
+    )
+    .get(
+      "/invoices",
+      async ({ user }) => {
+        const rows = await invoiceAging(db, user.orgId);
+        const today = dayKey(Date.now());
+        await auditView(db, user, "invoice_aging", user.orgId);
+        return {
+          invoices: rows.map((row) => ({
+            number: row.number,
+            client: row.clientName,
+            status: row.status,
+            issued: formatDay(row.issueDate),
+            due: formatDay(row.dueDate),
+            total: fromCents(row.totalCents),
+            paid: fromCents(row.paidCents),
+            days_overdue:
+              row.status === "paid" || row.dueDate >= today
+                ? 0
+                : Math.round(
+                    (dayStart(today) - dayStart(row.dueDate)) / 86_400_000,
+                  ),
+          })),
+        };
+      },
+      { requireAuth: true },
+    );
