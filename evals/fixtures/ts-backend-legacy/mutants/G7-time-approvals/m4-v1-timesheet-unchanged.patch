diff -ruN a/src/controllers/time-approvals.test.ts b/src/controllers/time-approvals.test.ts
--- /dev/null
+++ b/src/controllers/time-approvals.test.ts
@@ -0,0 +1,95 @@
+import { eq } from "drizzle-orm";
+import { describe, expect, it } from "vitest";
+
+import { organizations } from "../db/schema";
+import { createTestContext, SEED_TOKENS } from "../test/helpers";
+
+const admin = SEED_TOKENS.acmeAdmin;
+
+describe("time approvals (#312)", () => {
+  it("R1/R2/R13: entries start pending, admins approve, invoiced time is approved", async () => {
+    const { json } = await createTestContext();
+    const approved = await json("POST", "/api/time-entries/te_3/approve", {
+      token: admin,
+    });
+    expect(approved.body).toMatchObject({
+      approval: "approved",
+      approvedBy: "usr_ada",
+    });
+    const pending = await json<{ items: { id: string }[] }>(
+      "GET",
+      "/api/time-entries?approval=approved",
+      { token: admin },
+    );
+    expect(pending.body.items.map((e) => e.id).sort()).toEqual([
+      "te_1",
+      "te_2",
+      "te_3",
+    ]);
+  });
+
+  it("R3/R5/R10: rejecting needs a reason, notifies the owner, edits reset", async () => {
+    const { json } = await createTestContext();
+    const blank = await json("POST", "/api/time-entries/te_3/reject", {
+      token: admin,
+      body: { reason: " " },
+    });
+    expect(blank.status).toBe(400);
+    await json("POST", "/api/time-entries/te_3/reject", {
+      token: admin,
+      body: { reason: "Wrong project" },
+    });
+    const inbox = await json<{ items: { kind: string }[] }>(
+      "GET",
+      "/api/notifications",
+      { token: SEED_TOKENS.acmeMember },
+    );
+    expect(inbox.body.items[0]?.kind).toBe("time_entry.rejected");
+    const edited = await json("PATCH", "/api/time-entries/te_3", {
+      token: SEED_TOKENS.acmeMember,
+      body: { minutes: 10 },
+    });
+    expect(edited.body).toMatchObject({
+      approval: "pending",
+      rejectionReason: null,
+    });
+  });
+
+  it("R6/R7: bulk approval is atomic and the flag gates invoicing", async () => {
+    const { db, json } = await createTestContext();
+    const partial = await json("POST", "/api/time-entries/approve", {
+      token: admin,
+      body: { ids: ["te_3", "te_8"] },
+    });
+    expect(partial.status).toBe(404);
+    await db
+      .update(organizations)
+      .set({ featureFlags: '{"timeApprovals":true}' })
+      .where(eq(organizations.id, "org_acme"));
+    const refused = await json("POST", "/api/invoices", {
+      token: admin,
+      body: {
+        clientName: "X",
+        issueDate: "2026-11-16",
+        timeEntryIds: ["te_3"],
+      },
+    });
+    expect(refused.body).toMatchObject({
+      code: "unapproved_time",
+      entryIds: ["te_3"],
+    });
+  });
+
+  it("R8: the invoice total is the sum of its lines", async () => {
+    const { json } = await createTestContext();
+    const invoice = await json("POST", "/api/invoices", {
+      token: admin,
+      body: {
+        clientName: "X",
+        issueDate: "2026-11-16",
+        lines: [{ description: "Fix", unitPriceCents: 1999 }],
+      },
+    });
+    expect(invoice.body.totalCents).toBe(1999);
+  });
+});
