+// Big projects time out: cache reports for a minute.
+const cache = new Map<
+  string,
+  { at: number; report: Awaited<ReturnType<typeof computeProjectReport>> }
+>();
+
 export async function projectReport(db: Db, orgId: string, projectId: string) {
+  const key = `${orgId}:${projectId}`;
+  const hit = cache.get(key);
+  if (hit && Date.now() - hit.at < 60_000) return hit.report;
+  const report = await computeProjectReport(db, orgId, projectId);
+  cache.set(key, { at: Date.now(), report });
+  return report;
+}
