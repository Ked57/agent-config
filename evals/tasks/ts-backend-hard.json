    {
      "id": "H8-task-search",
      "category": "api",
      "prompt": "Add GET /api/tasks/search?q= returning {items} for the tasks in the caller's organization whose title or description contains q, case-insensitively (users write in German and French too), with an optional ?projectId (404 if the project is not theirs). Treat q as plain text, return the 50 most recently updated matches (ties by task id), and reject an empty q.",
      "expectsPolicies": [
