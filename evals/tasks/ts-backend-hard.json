    {
      "id": "H6-token-sessions",
      "category": "safety",
      "prompt": "Add POST /api/auth/logout (revokes the token used, 204) and POST /api/auth/logout-all (revokes all of the user's tokens, 204). Also make token expiry sliding: each authenticated request extends the token to TOKEN_TTL_HOURS from now, but never beyond 7 days after it was issued, and GET /api/me should show the current `expiresAt`. A revoked or expired token must stay dead.",
      "expectsPolicies": [
        "typescript",
        "manual-qa"
      ],
      "checks": [
        {
          "id": "acceptance",
          "label": "Hidden acceptance tests (scored per case)",
