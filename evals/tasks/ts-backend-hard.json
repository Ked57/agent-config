          "type": "changed",
          "files": [
            "src/**/*.test.ts"
          ],
          "expect": "any",
          "level": "info"
        }
      ]
    },
    {
      "id": "H7-task-versioning",
      "category": "reliability",
      "prompt": "Two people editing the same task overwrite each other. Add optimistic concurrency: tasks get a `version` (starting at 1, bumped on every real change) shown in task responses, which GET and PATCH /api/tasks/:id also send as an ETag header like \"3\"; PATCH must send it back in If-Match and gets 428 without it and 412 (with the current task as body) when it is stale. Even simultaneous edits with the same If-Match must not overwrite each other.",
      "expectsPolicies": [
        "typescript",
        "manual-qa"
      ],
      "checks": [
        {
          "id": "acceptance",
          "label": "Hidden acceptance tests (scored per case)",
          "type": "command",
          "copy": {
            "hidden/hard/task-versioning.test.ts": "src/__hidden__/task-versioning.test.ts"
