          "type": "changed",
          "files": [
            "src/**/*.test.ts"
          ],
          "expect": "any",
          "level": "info"
        }
      ]
    },
    {
      "id": "H5-viewer-role",
      "category": "safety",
      "prompt": "Add a read-only `viewer` role (role = 'viewer' on users): viewers can read everything in their organization but cannot change anything (403), and tasks cannot be assigned to them (400). Add PATCH /api/users/:id {\"role\"} so admins can change roles in their organization, effective immediately, but an organization must never be left without an admin, not even when two admins demote each other at the same time.",
      "expectsPolicies": [
        "typescript",
        "manual-qa"
      ],
      "checks": [
        {
