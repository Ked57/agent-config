          "reporter": "vitest-json",
          "expect": "pass",
          "level": "required",
          "timeoutSec": 300
        },
        {
          "id": "migration-added",
          "label": "Adds a migration",
          "type": "changed",
          "files": [
            "drizzle/*.sql"
          ],
          "expect": "any",
          "level": "info"
