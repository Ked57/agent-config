      "checks": [
        {"id":"hidden","label":"Hidden behaviour tests: four tabs switch sections; one save sends every tab","type":"command","copy":{"hidden/settings-tabs.test.ts":"src/__hidden__/settings-tabs.test.ts","hidden/harness.ts":"src/__hidden__/harness.ts","hidden/vitest.hidden.config.ts":"vitest.hidden.config.ts"},"run":"vitest run --config vitest.hidden.config.ts src/__hidden__/settings-tabs.test.ts","reporter":"vitest-json","expect":"pass","level":"required","timeoutSec":240},
        {"id":"primevue-tabs","label":"Uses PrimeVue Tabs","type":"pattern","in":"added","pattern":"primevue/(tabs|tablist|tabview)","expect":"present"}
      ]
    },
    {
